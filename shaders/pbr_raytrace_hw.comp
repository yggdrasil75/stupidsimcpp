#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

#define PI 3.14159265359
const float EPS = 1e-8;
const float LARGE = 1e30;
const float GAP_EPSILON = 1e-2;
const float DIST_EPSILON = 1e-4;

struct GPURenderNode {
    vec3 boundsMin;
    float padding1;
    vec3 boundsMax;
    float padding2;
    vec3 center;
    float nodeSize;
    uint isLeaf;
    uint isLoaded;
    uint childMask;
    uint firstPoint;
    uint pointCount;
    int  lodPoint;
    uint firstChild;
    uint padding3;
};

struct GPUPBRRenderData {
    vec3 position;
    float size;
    uint color;
    float emittance;
    uint materialProps;
    uint absorption;
    int objectId;
    uint padding1;
    uint padding2;
    uint padding3;
};

layout(std430, binding = 0) readonly buffer NodeBuffer { GPURenderNode nodes[]; };
layout(std430, binding = 1) readonly buffer PointBuffer { GPUPBRRenderData points[]; };
layout(std430, binding = 2) buffer OutputBuffer { float pixels[]; };

layout(binding = 3) uniform CameraData {
    vec3 origin;
    float lodMinDist;
    vec3 dir;
    float invLodf;
    vec3 up;
    float minVisibility;
    vec3 right;
    float maxDist;
    vec3 skylight;
    float tanfovx;
    vec3 bgColor;
    float tanfovy;
    int width;
    int height;
    int maxBounces;
    int useLod;
    float invFogRange;
    uint frameCount;
    int skyWidth;
    int skyHeight;
    int currentSampleOffset;
    int dispatchSamples;
    int globalIllumination;
    uint nodeCount;
    uint pointCount;
    int tileOffsetX;
    int tileOffsetY;
    int emissiveCount;
    int padding2;
} cam;

layout(std430, binding = 4) readonly buffer SkyboxBuffer { vec4 skyPixels[]; };
layout(std430, binding = 5) readonly buffer LightBuffer { uint emissiveIndices[]; };
layout(binding = 6) uniform accelerationStructureEXT tlas;

vec3 unpackRGB8(uint c) {
    return vec3(float(c & 0xFF) / 255.0, float((c >> 8) & 0xFF) / 255.0, float((c >> 16) & 0xFF) / 255.0);
}

void unpackMaterial(uint m, out float roughness, out float metallic, out float transmission, out float ior) {
    roughness = float(m & 0xFF) / 255.0;
    metallic = float((m >> 8) & 0xFF) / 255.0;
    transmission = float((m >> 16) & 0xFF) / 255.0;
    ior = (float((m >> 24) & 0xFF) / 255.0) * 1.5 + 1.0;
}

bool isInvalid(float v) { return isnan(v) || isinf(v); }
bool isInvalid(vec3 v) { return any(isnan(v)) || any(isinf(v)); }

vec3 safe_invDir(vec3 d) {
    return vec3(
        abs(d.x) < EPS ? (d.x < 0.0 ? -LARGE : LARGE) : 1.0 / d.x,
        abs(d.y) < EPS ? (d.y < 0.0 ? -LARGE : LARGE) : 1.0 / d.y,
        abs(d.z) < EPS ? (d.z < 0.0 ? -LARGE : LARGE) : 1.0 / d.z
    );
}

struct Ray {
    vec3 origin;
    vec3 dir;
    vec3 invDir;
    ivec3 signMask;
    //int signMask;
};

Ray makeRay(vec3 o, vec3 d) {
    Ray r;
    r.origin = o;
    r.dir = d;
    r.invDir = safe_invDir(d);
    r.signMask = ivec3(r.invDir.x < 0.0 ? 1 : 0, r.invDir.y < 0.0 ? 1 : 0, r.invDir.z < 0.0 ? 1 : 0);
    //int sx = r.invDir.x < 0 ? 1 : 0;
    //int sy = r.invDir.y < 0 ? 1 : 0;
    //int sz = r.invDir.z < 0 ? 1 : 0;
    //r.signMask = sx | (sy << 1) | (sz << 2);
    return r;
}

uint rng_state;

int getMediumVoxelAt(vec3 pt, int targetObjectId, int ignoreIdx) {
    if (targetObjectId == -1) return -1;
    
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, pt, 0.0, vec3(0,1,0), cam.maxDist);
    int foundIdx = -1;
    float minDist = 1e30;
    
    while(rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            
            if (ptIdx != ignoreIdx && points[ptIdx].objectId == targetObjectId) {
                GPUPBRRenderData p = points[ptIdx];
                vec3 bMin = p.position - p.size * 0.5 - vec3(GAP_EPSILON);
                vec3 bMax = p.position + p.size * 0.5 + vec3(GAP_EPSILON);
                
                if (pt.x >= bMin.x && pt.y >= bMin.y && pt.z >= bMin.z &&
                    pt.x <= bMax.x && pt.y <= bMax.y && pt.z <= bMax.z) {
                    
                    float d = distance(pt, p.position);
                    if (d < minDist) {
                        minDist = d;
                        foundIdx = ptIdx;
                    }
                }
            }
        }
    }
    return foundIdx;
}

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void init_rng(ivec2 pixel_coord, int sample_idx) {
    rng_state = pcg_hash(pixel_coord.x + pixel_coord.y * cam.width + pcg_hash(cam.frameCount) + pcg_hash(sample_idx));
}

float nextFloat(inout uint state) {
    if (state == 0) state = 123456789;
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return (state & 0xFFFFFF) / 16777216.0f;
}

float random_float() {
    rng_state = pcg_hash(rng_state);
    return float(rng_state) / float(0xFFFFFFFFu);
}

bool rayBoxIntersect(Ray ray, vec3 bMin, vec3 bMax, out float tMin, out float tMax) {
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    
    vec3 tmin3 = min(t0, t1);
    vec3 tmax3 = max(t0, t1);
    
    tMin = max(max(tmin3.x, tmin3.y), tmin3.z);
    tMax = min(min(tmax3.x, tmax3.y), tmax3.z);

    return tMax >= max(0.0, tMin);
}

bool rayCubeIntersect(Ray ray, GPUPBRRenderData pt, out float t, out vec3 normal, out vec3 hitPoint, inout float tExit) {
    vec3 bMin = pt.position - pt.size * 0.5;
    vec3 bMax = pt.position + pt.size * 0.5;

    float tMin, tMax;
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    
    vec3 tmin3 = min(t0, t1);
    vec3 tmax3 = max(t0, t1);
    
    tMin = max(max(tmin3.x, tmin3.y), tmin3.z);
    tMax = min(min(tmax3.x, tmax3.y), tmax3.z);

    tExit = tMax;
    if (tMax < max(0.0, tMin)) return false;
    
    t = tMin < 0.0 ? tMax : tMin;
    hitPoint = ray.origin + ray.dir * t;
    vec3 dMin = abs(hitPoint - bMin);
    vec3 dMax = abs(hitPoint - bMax);
    vec3 minmin = min(dMin, dMax);
    float mind = min(min(minmin.x, minmin.y), minmin.z);
    
    normal = vec3(0.0);
    if (mind == dMin.x) normal.x = -1.0;
    else if (mind == dMax.x) normal.x = 1.0;
    else if (mind == dMin.y) normal.y = -1.0;
    else if (mind == dMax.y) normal.y = 1.0;
    else if (mind == dMin.z) normal.z = -1.0;
    else normal.z = 1.0;
    return true;
}

vec3 sampleSkybox(vec3 d) {
    float u = 0.5 + (atan(d.z, d.x) / (2.0 * PI));
    float v = 0.5 - (asin(clamp(d.y, -1.0, 1.0)) / PI);
    u = clamp(u, 0.0, 0.9999);
    v = clamp(v, 0.0, 0.9999);
    
    int x = int(u * float(cam.skyWidth));
    int y = int(v * float(cam.skyHeight));
    int idx = y * cam.skyWidth + x;
    
    if (idx < 0 || idx >= cam.skyWidth * cam.skyHeight) return cam.bgColor;
    return skyPixels[idx].rgb;
}

int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal, out vec3 outHitPoint, inout float maxDist);
vec3 shadowTraverse(Ray ray, float maxDist, int lightPtIdx);

float smith(float cost, float alpha2) {
    float cost2 = cost * cost;
    float tanT2 = (1.0 - cost2) / max(1e-5, cost2);
    if (tanT2 <= 0.0) return 1.0;
    return 2.0 / (1.0 + sqrt(1.0 + alpha2 * tanT2));
}

void createOrthoNormalBasis(vec3 n, out vec3 t, out vec3 b) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    t = normalize(cross(up, n));
    b = cross(n, t);
}

vec3 hemisphereSample(vec3 n, inout uint state) {
    float r1 = nextFloat(state);
    float r2 = nextFloat(state);
    float phi = 2.0 * PI * r1;
    float r = sqrt(r2);
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - x*x - y*y));
    vec3 t,b;
    createOrthoNormalBasis(n, t, b);
    return t * x + b * y + n * z;
}

vec3 traceRay(Ray initialRay, inout uint state, out float primaryDepth, out int primaryObjId) {
    if (isInvalid(initialRay.origin) || isInvalid(initialRay.dir)) return vec3(0.0, 1.0, 0.0);
    
    float remainingMaxDist = cam.maxDist;

    vec3 finalColor = vec3(0.0);
    vec3 throughput = vec3(1.0);
    int bounce = 0;
    int contiguousSteps = 0;
    int transparentBounces = 0;
    int volumetricBounces = 0;
    
    const int MAX_TRANSPARENT_BOUNCES = 128;
    const int MAX_VOLUMETRIC_BOUNCES = 64;

    vec3 origin = initialRay.origin;
    vec3 direction = initialRay.dir;

    primaryDepth = LARGE;
    primaryObjId = -1;
    bool lastBounceSpecular = true;
    float pathRoughness = 0.0;
    
    int currentMediumObjId = -1;
    int currentMediumVoxelIdx = -1;

    while (bounce <= cam.maxBounces && transparentBounces < MAX_TRANSPARENT_BOUNCES && volumetricBounces < MAX_VOLUMETRIC_BOUNCES) {
        if (isInvalid(throughput) || isInvalid(finalColor) || remainingMaxDist <= 0.0) break;

        Ray cray = makeRay(origin, direction);
        int hitIndex = -1;
        float t = 0.0;
        vec3 normal = vec3(0.0);
        vec3 hitPoint = vec3(0.0);
        
        float segmentMaxDist = remainingMaxDist;
        int hitResult = voxelTraverse(cray, hitIndex, t, normal, hitPoint, segmentMaxDist);
        if (hitResult == 0) t = segmentMaxDist;

        if (bounce == 0 && transparentBounces == 0 && volumetricBounces == 0) {
            if (hitResult == 1) {
                primaryDepth = t;
                if (hitIndex >= 0 && hitIndex < points.length()) primaryObjId = points[hitIndex].objectId;
            } else {
                primaryDepth = LARGE;
                primaryObjId = -1;
            }
        }
        
        bool scattered = false;
        float t_actual = t;
        vec3 sigma_t = vec3(0.0);
        vec3 sigma_s = vec3(0.0);
        bool inMedium = false;

        if (currentMediumVoxelIdx != -1) {
            GPUPBRRenderData medData = points[currentMediumVoxelIdx];
            float r, m, tr, ior;
            unpackMaterial(medData.materialProps, r, m, tr, ior);
            vec3 medAbsorption = unpackRGB8(medData.absorption);
            vec3 medAlbedo = unpackRGB8(medData.color);
            vec3 sigma_a = medAbsorption * 5.0; 
            sigma_t = medAbsorption * 10.0; 
            vec3 sigma_s = medAlbedo * (1.0 - tr) * 15.0; 
            float max_sigma_s = max(sigma_s.x, max(sigma_s.y, sigma_s.z));
            
            if (max_sigma_s > 1e-5) {
                float t_scatter = -log(max(1e-7, 1.0 - nextFloat(state))) / max_sigma_s;
                if (t_scatter < t) {
                    scattered = true;
                    t_actual = t_scatter;
                    
                    vec3 scatterPos = origin + direction * t_scatter;
                    
                    float z = 1.0 - 2.0 * nextFloat(state);
                    float radius = sqrt(max(0.0, 1.0 - z*z));
                    float phi = 2.0 * PI * nextFloat(state);
                    direction = vec3(radius * cos(phi), radius * sin(phi), z);
                    origin = scatterPos;
                    
                    throughput *= (sigma_s / max_sigma_s);
                    volumetricBounces++;
                }
            }
            throughput *= exp(-sigma_a * t_actual);
            
            if (max(max(throughput.x, throughput.y), throughput.z) < 0.01) break;
        }
        
        if (scattered) {
            continue;
        }

        if (hitResult == 0) {
            vec3 skyCol = sampleSkybox(direction);
            if (bounce > 0) {
                float skyLum = dot(skyCol, vec3(0.2126, 0.7152, 0.0722));
                if (skyLum > 5.0) skyCol *= 5.0 / skyLum;
            }
            if (bounce == 0 || cam.globalIllumination == 1) finalColor += throughput * skyCol;
            else finalColor += throughput * cam.skylight;
            break;
        }
        if (hitIndex < 0 || hitIndex >= points.length()) break;
        
        remainingMaxDist -= t;

        GPUPBRRenderData hitData = points[hitIndex];
        float tExit = -2.0;
        rayCubeIntersect(cray, hitData, t, normal, hitPoint, tExit);

        int entering = 0;
        if (dot(direction, normal) < 0.0) entering = 1;
        vec3 offsetNorm = entering == 1 ? normal : -normal;

        bool skipSurface = false;
        
        if (currentMediumObjId != -1 && hitData.objectId == currentMediumObjId) {
            if (entering == 1) {
                // Ray overlaps into a new voxel of the SAME object. Skip optics, inherit new color gradient!
                skipSurface = true;
                currentMediumVoxelIdx = hitIndex;
            } else {
                // Ray is exiting the voxel. Does it instantly touch another voxel of the SAME object?
                vec3 testPt = hitPoint + direction * (GAP_EPSILON * 2.0);
                int nextVoxelIdx = getMediumVoxelAt(testPt, currentMediumObjId, hitIndex);
                
                if (nextVoxelIdx != -1) {
                    skipSurface = true;
                    currentMediumVoxelIdx = nextVoxelIdx;
                }
            }
        }
        
        if (skipSurface) {
            // Traverse straight through the boundary without breaking the path or evaluating Fresnel!
            origin = hitPoint + direction * (GAP_EPSILON * 2.0);
            transparentBounces++;
            continue; 
        }
        vec3 albedo = unpackRGB8(hitData.color);
        float roughness, metallic, transmission, ior;
        unpackMaterial(hitData.materialProps, roughness, metallic, transmission, ior);
        roughness = max(roughness, pathRoughness);
        pathRoughness = max(pathRoughness, roughness);
        pathRoughness = min(pathRoughness + 0.15, 1.0);
        
        vec3 emitted = albedo * hitData.emittance;
        if (bounce == 0 || lastBounceSpecular) {
            finalColor += throughput * emitted;
        }

        vec3 F0 = mix(vec3(0.04), albedo, metallic);

        float continueProb;
        if (bounce > 2) {
            continueProb = max(throughput.x, max(throughput.y, throughput.z));
            continueProb = clamp(continueProb, 0.1, 0.95);
            if (nextFloat(state) > continueProb) break;
            throughput /= continueProb;
        } 

        vec3 V = -direction;
        float eta = (entering == 1) ? (1.0 / ior) : ior;
        float alpha = max(1e-5, roughness * roughness);
        float alpha2 = alpha * alpha;
        
        if (cam.emissiveCount > 0 && entering == 1 && hitData.emittance == 0.0) {
            if ((1.0 - metallic) * (1.0 - transmission) > 0.001) {
                int lightIdx = int(nextFloat(state) * float(cam.emissiveCount));
                lightIdx = clamp(lightIdx, 0, cam.emissiveCount - 1);
                uint emissivePtIdx = emissiveIndices[lightIdx];
                
                if (emissivePtIdx != hitIndex) {
                    GPUPBRRenderData lightPt = points[emissivePtIdx];
                    vec3 jitter = vec3(nextFloat(state), nextFloat(state), nextFloat(state)) - 0.5;
                    vec3 lightPos = lightPt.position + jitter * (lightPt.size * 0.8);
                    
                    vec3 shadowOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                    vec3 toLight = lightPos - shadowOrigin;
                    float distSq = dot(toLight, toLight);
                    float distToLight = sqrt(distSq);
                    vec3 L = toLight / distToLight;
                    
                    float NdotL = dot(offsetNorm, L);
                    if (NdotL > 0.0) {
                        Ray shadowRay = makeRay(shadowOrigin, L);
                        float shadowMaxDist = distToLight - DIST_EPSILON * 2.0;
                        vec3 shadowTransmittance = vec3(1.0);
                        
                        if (shadowMaxDist > 0.0) {
                            shadowTransmittance = shadowTraverse(shadowRay, shadowMaxDist, int(emissivePtIdx));
                        }
                        
                        if (shadowTransmittance.x > 0.0 || shadowTransmittance.y > 0.0 || shadowTransmittance.z > 0.0) {
                            vec3 lightAlbedo = unpackRGB8(lightPt.color);
                            vec3 lightEmission = lightAlbedo * lightPt.emittance;
                            float area = lightPt.size * lightPt.size;
                            float solidAngle = min(area / max(distSq, area * 0.25), 2.0 * PI);
                            
                            vec3 H_nee = normalize(V + L);
                            float VdotH_nee = max(0.0, dot(V, H_nee));
                            vec3 F_nee = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH_nee), 5.0);
                            
                            vec3 diffuseBRDF = albedo * (vec3(1.0) - F_nee) / PI;
                            vec3 evalBRDF = diffuseBRDF * (1.0 - transmission) * (1.0 - metallic);
                            
                            vec3 directLight = lightEmission * evalBRDF * NdotL * solidAngle * float(cam.emissiveCount) * shadowTransmittance;
                            
                            float lum = dot(directLight, vec3(0.2126, 0.7152, 0.0722));
                            if (lum > 20.0) {
                                directLight *= 20.0 / lum;
                            }
                            
                            finalColor += throughput * directLight;
                        }
                    }
                }
            }
        }

        float r1 = nextFloat(state);
        float r2 = nextFloat(state);
        float phi = 2.0 * PI * r1;
        float cosThetaM = sqrt(max(0.0, (1.0 - r2) / (1.0 + (alpha2 - 1.0) * r2)));
        float sinThetaM = sqrt(max(0.0, 1.0 - cosThetaM * cosThetaM));
        vec3 up = abs(offsetNorm.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
        vec3 tangent = normalize(cross(up, offsetNorm));
        vec3 bitangent = cross(offsetNorm, tangent);
        vec3 H = normalize(tangent * sinThetaM * cos(phi) + bitangent * sinThetaM * sin(phi) + offsetNorm * cosThetaM);

        float VdotH = dot(V, H);
        if (VdotH < 0.0) {
            H = -H;
            VdotH = -VdotH;
        }

        vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH), 5.0);

        float probSpec = (F.x + F.y + F.z) * 0.333333;
        float probT = (1.0 - metallic) * transmission;
        float probDiffuse = (1.0 - metallic) * (1.0 - transmission);
        
        float pspec = probSpec;
        float pdiff = probDiffuse * (1.0 - pspec);
        float pTrans = probT * (1.0 - pspec);
        float sump = pspec + pdiff + pTrans;
        if (sump <= 1e-5) {
            pspec = 1.0;
            pdiff = 0.0;
            pTrans = 0.0;
        } else {
            float insump = 1.0 / sump;
            pspec = pspec * insump;
            pdiff = pdiff * insump;
            pTrans = pTrans * insump;
        }

        float r_type = nextFloat(state);
        vec3 newDir;
        vec3 newOrigin;
        vec3 weight = vec3(0.0);
        float NdotV = max(1e-5, dot(offsetNorm, V));
        
        bool isTransmissionInteraction = false;

        if (r_type < pspec) {
            newDir = normalize(2.0 * VdotH * H - V);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            float NDotL = dot(offsetNorm, newDir);
            float NDotH = max(1e-5, dot(offsetNorm, H));
            if (NDotL > 0.0) {
                float G = smith(NdotV, alpha2) * smith(NDotL, alpha2);
                weight = F * (G * VdotH / (NdotV * NDotH * pspec));
            }
            lastBounceSpecular = true;
        } else if (r_type < pspec + pdiff) {
            float r3 = nextFloat(state);
            float r4 = nextFloat(state);
            float Phid = 2.0 * PI * r3;
            float rD = sqrt(r4);
            vec3 L_local = vec3(rD * cos(Phid), rD * sin(Phid), sqrt(max(0.0, 1.0 - r4)));
            newDir = normalize(tangent * L_local.x + bitangent * L_local.y + offsetNorm * L_local.z);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            weight = albedo * (vec3(1.0) - F) / pdiff;
            lastBounceSpecular = false;
        } else {
            isTransmissionInteraction = true;
            float sinThetaT2 = eta * eta * (1.0 - VdotH * VdotH);
            if (sinThetaT2 >= 1.0) {
                newDir = normalize(2.0 * VdotH * H - V);
                newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                float NDotL = dot(offsetNorm, newDir);
                if (NDotL > 0.0) {
                    float G = smith(NdotV, alpha2) * smith(NDotL, alpha2);
                    float NDotH = max(1e-5, dot(offsetNorm, H));
                    weight = vec3(1.0) * (G * abs(VdotH) / (NdotV * NDotH * pTrans));
                }
            } else {
                float cosThetaT = sqrt(1.0 - sinThetaT2);
                newDir = normalize((eta * VdotH - cosThetaT) * H - eta * V);
                newOrigin = hitPoint - offsetNorm * DIST_EPSILON;
                float NdotL = max(1e-5, dot(offsetNorm, -newDir));
                if (NdotL > 0.0) {
                    float G = smith(NdotV, alpha2) * smith(NdotL, alpha2);
                    float NDotH = max(1e-5, dot(offsetNorm, H));
                    weight = vec3(1.0) * (vec3(1.0) - F) * (G * abs(VdotH) / (NdotV * NDotH * pTrans));
                }
                
                if (entering == 1) {
                    currentMediumObjId = hitData.objectId;
                    currentMediumVoxelIdx = hitIndex;
                } else {
                    currentMediumObjId = -1;
                    currentMediumVoxelIdx = -1;
                }
            }
            lastBounceSpecular = true;
        }
        
        if (bounce > 0 || transparentBounces > 0) {
            float lumW = dot(weight, vec3(0.2126, 0.7152, 0.0722));
            if (lumW > 2.0) weight *= 2.0 / lumW; 
        } else {
            weight = min(weight, vec3(4.0));
        }
        throughput = throughput * weight;
        if (max(max(throughput.x, throughput.y), throughput.z) < 0.01) {
            break;
        }
        origin = newOrigin;
        direction = newDir;
        if (isTransmissionInteraction) {
            transparentBounces++;
            // Increment actual GI bounces slightly to prevent infinite refraction loops
            if (transparentBounces % 4 == 0) bounce++; 
        } else {
            bounce++;
        }
    }
    if (isInvalid(finalColor)) return vec3(0.0, 1.0, 0.0);
    return finalColor;
}

void checkAndUpdateHit(Ray ray, int ptIdx, float ptT, vec3 ptN, vec3 ptHP, inout int hitFound,
     inout float currentMaxDist, inout float outT, inout vec3 outNormal, inout vec3 outHitPoint,
     inout int hitIndex) {
    bool isNewExit = dot(ray.dir, ptN) > 0.0;
    bool isCurrExit = (hitFound == 1) && (dot(ray.dir, outNormal) > 0.0);
    
    bool shouldUpdate = false;
    if (hitFound == 0) {
        if (ptT <= currentMaxDist) shouldUpdate = true;
    } else {
        if (ptT < currentMaxDist - 1e-5) {
            shouldUpdate = true;
        } else if (ptT <= currentMaxDist + 1e-5) {
            if (isNewExit && !isCurrExit) shouldUpdate = true;
        }
    }
    
    if (shouldUpdate) {
        currentMaxDist = ptT;
        outT = ptT;
        outNormal = ptN;
        outHitPoint = ptHP;
        hitIndex = ptIdx;
        hitFound = 1;
    }
}


int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal, out vec3 outHitPoint, inout float currentMaxDist) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, ray.origin, 0.0, ray.dir, currentMaxDist);

    while(rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            float t;
            vec3 n;
            vec3 hp;
            float tEx = 0.0;
            if (rayCubeIntersect(ray, points[ptIdx], t, n, hp, tEx) && t >= 0.0 && t <= currentMaxDist) {
                rayQueryGenerateIntersectionEXT(rq, t);
            }
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionGeneratedEXT) {
        hitIndex = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        outT = rayQueryGetIntersectionTEXT(rq, true);
        currentMaxDist = outT;
        float dummyT;
        float tEx = 0.0;
        rayCubeIntersect(ray, points[hitIndex], dummyT, outNormal, outHitPoint, tEx);
        return 1;
    }
    return 0;
}

vec3 shadowTraverse(Ray ray, float maxDist, int lightPtIdx) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, ray.origin, 0.0, ray.dir, maxDist);

    vec3 transmittance = vec3(1.0);
    
    if (cam.invFogRange > 0.0) {
        transmittance *= exp(-vec3(cam.invFogRange) * maxDist);
    }

    while(rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            if (ptIdx == lightPtIdx) continue;
            
            GPUPBRRenderData pt = points[ptIdx];
            vec3 bMin = pt.position - pt.size * 0.5;
            vec3 bMax = pt.position + pt.size * 0.5;

            vec3 t0 = (bMin - ray.origin) * ray.invDir;
            vec3 t1 = (bMax - ray.origin) * ray.invDir;
            
            vec3 tmin3 = min(t0, t1);
            vec3 tmax3 = max(t0, t1);
            
            float tEntry = max(max(tmin3.x, tmin3.y), tmin3.z);
            float tExit = min(min(tmax3.x, tmax3.y), tmax3.z);

            if (tExit >= max(0.0, tEntry) && tEntry <= maxDist) {
                float r, m, tr, ior;
                unpackMaterial(pt.materialProps, r, m, tr, ior);
                
                if (tr > 0.0 && m < 1.0) { // Clouds, Translucency, Glass, Subsurface etc.
                    vec3 absColor = unpackRGB8(pt.absorption);
                    float actualTEntry = max(0.0, tEntry);
                    float actualTExit = min(maxDist, tExit);
                    float thickness = max(0.0, actualTExit - actualTEntry);
                    
                    transmittance *= exp(-absColor * 10.0 * thickness);
                } else {
                    float tHit = tEntry < 0.0 ? tExit : tEntry;
                    if (tHit >= 0.0 && tHit <= maxDist) rayQueryGenerateIntersectionEXT(rq, tHit);
                }
            }
        }
    }
    
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionGeneratedEXT) {
        return vec3(0.0);
    }
    
    return transmittance;
}

void main() {
    ivec2 localCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 coord = localCoord + ivec2(cam.tileOffsetX, cam.tileOffsetY);
    if (coord.x >= cam.width || coord.y >= cam.height) return;
    uint idx = (coord.y * cam.width + coord.x) * 5;
    if (idx + 4 >= pixels.length()) return;

    vec3 accumulatedColor = vec3(0.0);
    float accumulatedDepth = 0.0;
    
    int firstObjId = -1;
    
    for (int s = 0; s < cam.dispatchSamples; ++s) {
        int global_s = cam.currentSampleOffset + s;
        init_rng(coord, global_s);
        
        float px = (2.0 * (float(coord.x) + nextFloat(rng_state)) / float(cam.width) - 1.0) * cam.tanfovx;
        float py = (1.0 - 2.0 * (float(coord.y) + nextFloat(rng_state)) / float(cam.height)) * cam.tanfovy;
        
        vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
        if (isInvalid(rayDir)) {
            accumulatedColor += vec3(0.0, 1.0, 0.0);
            continue;
        }
        Ray ray = makeRay(cam.origin, rayDir);
        
        float pDepth;
        int pObjId;
        vec3 tracedResult = traceRay(ray, rng_state, pDepth, pObjId);
        
        if (s == 0) firstObjId = pObjId;

        if (isInvalid(tracedResult)) tracedResult = vec3(0.0, 1.0, 0.0);
        
        accumulatedColor += tracedResult;
        accumulatedDepth += pDepth;
    }
    
    if (cam.currentSampleOffset == 0) {
        pixels[idx]     = accumulatedColor.r;
        pixels[idx + 1] = accumulatedColor.g;
        pixels[idx + 2] = accumulatedColor.b;
        pixels[idx + 3] = accumulatedDepth;
        pixels[idx + 4] = float(firstObjId);
    } else {
        pixels[idx]     += accumulatedColor.r;
        pixels[idx + 1] += accumulatedColor.g;
        pixels[idx + 2] += accumulatedColor.b;
        pixels[idx + 3] += accumulatedDepth;
    }
}