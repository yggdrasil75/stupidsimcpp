// meshify.comp
#version 450
layout(local_size_x = 64) in;

struct GPUFastRenderData {
    vec3 position;
    float size;
    uint color;
    uint materialIdx;
    int objectId;
    float gasDensity;
};

layout(std430, binding = 1) readonly buffer PointBuf { GPUFastRenderData points[]; };

layout(std430, binding = 7) buffer AdaptiveBuf { vec4 meshData[]; };

layout(push_constant) uniform Push {
    uint pointCount;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.pointCount) return;

    GPUFastRenderData pt = points[idx];
    
    uint outIdx = idx * 2;
    meshData[outIdx] = vec4(pt.position, pt.size);
    meshData[outIdx + 1] = vec4(uintBitsToFloat(pt.color), uintBitsToFloat(pt.materialIdx), intBitsToFloat(pt.objectId), pt.gasDensity);
}