#version 450
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Zeroes a box of the mip-0 radiance volume before the bricks covering it are re-voxelized.

layout(binding = 0, rgba16f) uniform writeonly image3D volume;

layout(push_constant) uniform Push {
    ivec3 offset;
    int pad0;
    ivec3 size;
    int pad1;
} pc;

void main() {
    ivec3 local = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(local, pc.size))) return;
    imageStore(volume, pc.offset + local, vec4(0.0));
}
