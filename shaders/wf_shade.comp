#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "wf_common.glsl"


void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= ctr.shadeCount) return;

    uint slot = shadeQueue[gid];
    PathHot p = pathsHot[slot];
    if ((p.i1.w & FLAG_ALIVE) == 0) return;

    vec3 origin = p.o_tmax.xyz;
    vec3 dir    = p.dir_rough.xyz;
    float pathRoughness = p.dir_rough.w;
    float remainingMaxDist = p.o_tmax.w;
    vec3 throughput = p.thp.xyz;
    vec3 radiance   = p.rad.xyz;

    uint rng  = p.u0.y;
    uint grng = p.u0.z;
    int bounce = PC_GET_BOUNCE(p.u0.w);
    int transp = PC_GET_TRANS(p.u0.w);
    int volum  = PC_GET_VOLUM(p.u0.w);
    int mediumObjId    = p.i1.x;
    int mediumVoxelIdx = p.i1.y;
    bool lastBounceSpecular = (p.i1.w & FLAG_SPECULAR) != 0;

    float t = pathsHit[slot].t;
    uint hitIndexU = pathsHit[slot].hitIndex;
    float prevPdf = pathsHit[slot].misc;
    uint prevSlot = pathsHit[slot].neeSlot;
    float prevVarL = pathsHit[slot].varLight;
    float prevVarB = pathsHit[slot].varBsdf;
    vec3 prevVertex = origin;
    float outMisc = -1.0;
    uint outSlot = WF_NO_SLOT;
    float outVarL = 0.0;
    float outVarB = 0.0;
    if (hitIndexU == WF_NO_HIT) return;
    int hitIndex = int(hitIndexU);

    remainingMaxDist -= t;

    GPURenderData hitData = points[hitIndex];
    vec3 invD = safe_invDir(dir);
    float tExit;
    vec3 normal;
    vec3 hitPoint;
    float tHit;
    rayCubeIntersect(origin, dir, invD, hitData, tHit, normal, hitPoint, tExit);

    int entering = (dot(dir, normal) < 0.0) ? 1 : 0;
    vec3 offsetNorm = (entering == 1) ? normal : -normal;
    bool isTransmissionInteraction = false;

    if (mediumObjId != -1) {
        vec3 segAbs = unpackRGB9E5(materials[hitData.materialIdx].absorption);
        throughput *= exp(-segAbs * t);
    }

    bool skipSurface = false;
    if (mediumObjId != -1 && hitData.objectId == mediumObjId) {
        if (entering == 1) {
            skipSurface = true;
            mediumVoxelIdx = hitIndex;
        } else {
            int nextVoxelIdx = getMediumVoxelAt(hitPoint, normal, mediumObjId, hitIndex);
            if (nextVoxelIdx != -1) {
                skipSurface = true;
                mediumVoxelIdx = nextVoxelIdx;
            }
        }
    }

    bool continuePath = true;

    if (skipSurface) {
        origin = hitPoint + dir * (DIST_EPSILON * 4.0);
        outMisc = -1.0;
    } else {
        GPUMaterial surfaceMat = materials[hitData.materialIdx];
        vec4 albedo = unpackRGBA8(hitData.color);
        float opacity = albedo.a;
        float transmission = 1.0 - opacity;
        float roughness, metallic;
        uint sellRow;
        unpackMaterial(surfaceMat.materialProps, roughness, metallic, sellRow);

        int hero = GET_HERO(p.i1.w);
        float lambda = heroLambda(hero == 0 ? 2 : hero);
        float ior = sampleIor(sellRow, lambda);
        vec3 emittanceRGB = unpackRGB9E5(surfaceMat.chromaticity);
        bool isEmissive = surfaceMat.chromaticity != 0u;

        roughness = max(roughness, pathRoughness);
        pathRoughness = max(pathRoughness, roughness);

        if (bounce == 0 && transp == 0) {
            uint gi = p.u0.x * uint(GBUF_STRIDE);
            if (gi + uint(GBUF_STRIDE) <= uint(gbuf.length())) {
                float diffuseness = (1.0 - metallic) * opacity;
                vec3 demod = mix(vec3(1.0), max(albedo.rgb, vec3(0.02)), diffuseness);
                if (isEmissive) demod = vec3(1.0);
                gbuf[gi + 0u] = demod.r;
                gbuf[gi + 1u] = demod.g;
                gbuf[gi + 2u] = demod.b;
                gbuf[gi + 3u] = offsetNorm.x;
                gbuf[gi + 4u] = offsetNorm.y;
                gbuf[gi + 5u] = offsetNorm.z;
            }
        }

        vec3 emitted = albedo.rgb * emittanceRGB;
        if (isEmissive && entering == 1) {
            float wB = 1.0;
            if (prevPdf > 0.0 && cam.emissiveCount > 0) {
                vec3 faceN;
                float area = lightFaceArea(hitData, prevVertex, faceN);
                float cosAtLight = dot(faceN, -dir);
                bool sameFace = dot(faceN, normal) > 0.5;
                float lp = sameFace ? lightPdfW(area, t * t, cosAtLight, cam.emissiveCount) : 0.0;
                wB = 1.0 - misWeightVA(lp, prevVarL, prevPdf, prevVarB);
            }
            vec3 addE = throughput * emitted * wB;
            if (bounce > 0) {
                float addLum = dot(addE, vec3(0.2126, 0.7152, 0.0722));
                if (addLum > 64.0) addE *= 64.0 / addLum;
            }
            radiance += addE;
            float bsdfLum = dot(throughput * emitted, vec3(0.2126, 0.7152, 0.0722));
            vaUpdateBsdf(prevSlot, bsdfLum * bsdfLum);
        }

        vec3 F0 = mix(vec3(0.04), albedo.rgb, metallic);

        if (bounce > 3) {
            float thpLum = dot(throughput, vec3(0.2126, 0.7152, 0.0722));
            float continueProb = clamp(thpLum, 0.05, 0.95);
            if (nextFloat(grng) > continueProb) {
                p.rad.xyz = radiance;
                p.u0.y = rng;
                p.u0.z = grng;
                p.i1.w &= ~FLAG_ALIVE;
                pathsHot[slot] = p;
                pathsHit[slot].misc = -1.0;
                pathsHit[slot].neeSlot = WF_NO_SLOT;
                return;
            }
            throughput /= continueProb;
        }

        vec3 V = -dir;
        float eta = (entering == 1) ? (1.0 / ior) : ior;
        float alpha = max(1e-5, roughness * roughness);
        float alpha2 = alpha * alpha;
        float NdotV = max(1e-4, dot(offsetNorm, V));

        vec3 tangent, bitangent;
        branchlessONB(offsetNorm, tangent, bitangent);

        vec3 Fv = F0 + (vec3(1.0) - F0) * pow(1.0 - NdotV, 5.0);
        float pspec = clamp(dot(Fv, vec3(0.333333)), 0.04, 0.96);
        float pdiff = (1.0 - metallic) * opacity * (1.0 - pspec);
        float pTrans = (1.0 - metallic) * transmission * (1.0 - pspec);
        {
            float sump = pspec + pdiff + pTrans;
            if (sump <= 1e-5) {
                pspec = 1.0;
                pdiff = 0.0;
                pTrans = 0.0;
            }
            else {
                float ins = 1.0 / sump;
                pspec *= ins;
                pdiff *= ins;
                pTrans *= ins;
            }
        }

        bool neeDone = (cam.emissiveCount > 0 && entering == 1 && !isEmissive && (pspec + pdiff) > 0.001);

        if (neeDone) {
            vec3 shadowOrigin = hitPoint + offsetNorm * DIST_EPSILON;

            SurfCtx cs;
            cs.pos = shadowOrigin;
            cs.n = offsetNorm;
            cs.V = V;
            cs.albedo = albedo.rgb;
            cs.F0 = F0;
            cs.alpha2 = alpha2;
            cs.opacity = opacity;
            cs.metallic = metallic;
            cs.valid = 1.0;

            Reservoir res;
            reservoirInit(res);

            int candidates = min(RESTIR_CANDIDATES, cam.emissiveCount);
            for (int ci = 0; ci < candidates; ++ci) {
                int li = clamp(int(nextFloat(grng) * float(cam.emissiveCount)), 0, cam.emissiveCount - 1);
                uint cIdx = emissiveIndices[li];
                if (cIdx == uint(hitIndex)) {
                    res.M += 1.0;
                    continue;
                }

                float pHat = reservoirTargetAt(cs, cIdx);
                if (pHat <= 0.0) {
                    res.M += 1.0;
                    continue;
                }

                GPURenderData cp = points[cIdx];
                vec3 cfn;
                float cArea = lightFaceArea(cp, shadowOrigin, cfn);
                float srcPdf = 1.0 / (float(cam.emissiveCount) * cArea);
                reservoirUpdate(res, cIdx, pHat / srcPdf, pHat, rng);
            }
            reservoirFinalize(res);

            res.nrmPacked = packNormalOct(offsetNorm);
            res.posX = shadowOrigin.x;
            res.posY = shadowOrigin.y;
            res.posZ = shadowOrigin.z;
            res.roughness = roughness;
            res.albedoPacked = packRGBA8f(vec4(albedo.rgb, opacity));
            res.metalPacked = uint(clamp(metallic, 0.0, 1.0) * 255.0 + 0.5);

            bool cacheOn = (cam.wcCapacity > 0u);
            uint rkey = 0u;
            uint rslot = 0u;
            if (cacheOn) {
                rslot = reservoirSlot(shadowOrigin, offsetNorm, rkey);
                outSlot = rslot;
            }

            bool reuseOn = cacheOn && (cam.wcEnabled != 0) && extentIsReusable(hitData.extent);
            if (reuseOn) {
                Reservoir srcR[RESTIR_MAX_SOURCES];
                SurfCtx srcS[RESTIR_MAX_SOURCES];
                for (int i = 0; i < RESTIR_MAX_SOURCES; ++i) reservoirInit(srcR[i]);

                srcR[0] = res;
                srcS[0] = cs;
                int nSrc = 1;

                float cellSize = (cam.wcInvCellSize > 0.0) ? (1.0 / cam.wcInvCellSize) : 1.0;
                float planeTol = cellSize * 1.5;

                Reservoir tr;
                if (reservoirFetch(shadowOrigin, offsetNorm, shadowOrigin, offsetNorm, planeTol, tr)) {
                    tr.M = min(tr.M, RESTIR_M_CAP);
                    srcR[nSrc] = tr;
                    srcS[nSrc] = surfFromReservoir(tr);
                    nSrc++;
                }

                for (int st = 0; st < RESTIR_SPATIAL_TAPS && nSrc < RESTIR_MAX_SOURCES; ++st) {
                    vec3 jit = vec3(nextFloat(grng), nextFloat(grng), nextFloat(grng)) * 2.0 - 1.0;
                    vec3 probe = shadowOrigin + (jit - offsetNorm * dot(jit, offsetNorm)) * cellSize * 1.75;
                    Reservoir sr;
                    if (reservoirFetch(probe, offsetNorm, shadowOrigin, offsetNorm, planeTol, sr)) {
                        sr.M = min(sr.M, RESTIR_M_CAP);
                        srcR[nSrc] = sr;
                        srcS[nSrc] = surfFromReservoir(sr);
                        nSrc++;
                    }
                }

                if (nSrc > 1) {
                    Reservoir combined;
                    reservoirCombineGRIS(combined, srcR, srcS, nSrc, rng);
                    combined.nrmPacked = res.nrmPacked;
                    combined.posX = res.posX;
                    combined.posY = res.posY;
                    combined.posZ = res.posZ;
                    combined.roughness = res.roughness;
                    combined.albedoPacked = res.albedoPacked;
                    combined.metalPacked = res.metalPacked;
                    combined.varLight = res.varLight;
                    combined.varBsdf = res.varBsdf;
                    res = combined;
                }

                Reservoir store = res;
                store.key = rkey;
                store.frame = wcTick();
                store.M = min(store.M, RESTIR_M_CAP);
                store.varLight = max(reservoirs[rslot].varLight, VA_FLOOR);
                store.varBsdf = max(reservoirs[rslot].varBsdf, VA_FLOOR);
                reservoirs[rslot] = store;
            }

            outVarL = 1.0;
            outVarB = 1.0;
            if (cacheOn) {
                outVarL = max(reservoirs[rslot].varLight, VA_FLOOR);
                outVarB = max(reservoirs[rslot].varBsdf, VA_FLOOR);
            }

            if (res.W > 0.0 && res.targetPdf > 0.0 && res.lightIdx < uint(points.length())) {
                uint emissivePtIdx = res.lightIdx;
                GPURenderData lightPt = points[emissivePtIdx];
                GPUMaterial lightMat = materials[lightPt.materialIdx];

                vec3 lightPos, lightNrm;
                float area;
                lightSampleFace(lightPt, shadowOrigin, nextFloat(rng), nextFloat(rng),
                                lightPos, lightNrm, area);

                vec3 toLight = lightPos - shadowOrigin;
                float distSq = dot(toLight, toLight);
                float distToLight = sqrt(max(distSq, 1e-12));
                vec3 L = toLight / distToLight;
                float NdotL = dot(offsetNorm, L);
                float cosAtLight = dot(lightNrm, -L);
                float shadowMaxDist = distToLight - DIST_EPSILON * 2.0;

                if (NdotL > 0.0 && cosAtLight > 0.0 && shadowMaxDist > 0.0) {
                    vec4 lightAlbedo = unpackRGBA8(lightPt.color);
                    vec3 lightEmission = lightAlbedo.rgb * unpackRGB9E5(lightMat.chromaticity);
                    vec3 H_nee = normalize(V + L);
                    float NdotH_nee = max(0.0, dot(offsetNorm, H_nee));
                    float VdotH_nee = max(0.0, dot(V, H_nee));
                    vec3 F_nee = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH_nee), 5.0);
                    vec3 diffuseBRDF = albedo.rgb * (vec3(1.0) - F_nee) / PI;
                    float Dn = ggxD(NdotH_nee, alpha2);
                    float Gn = smith(NdotV, alpha2) * smith(NdotL, alpha2);
                    vec3 specBRDF = F_nee * (Dn * Gn / max(1e-5, 4.0 * NdotV * NdotL));
                    vec3 evalBRDF = diffuseBRDF * opacity * (1.0 - metallic) + specBRDF;

                    float Gterm = geometryTerm(NdotL, cosAtLight, distSq);
                    float lightPdfN = lightPdfW(area, distSq, cosAtLight, cam.emissiveCount);
                    float bPdfN = bsdfPdfW(offsetNorm, V, L, alpha2, pspec, pdiff);
                    float wL = misWeightVA(lightPdfN, outVarL, bPdfN, outVarB);
                    if (!cacheOn) wL = misWeight(lightPdfN, bPdfN);
                    vec3 unweighted = lightEmission * evalBRDF * Gterm * res.W;
                    vec3 contrib = unweighted * wL;

                    float lightLum = dot(unweighted * throughput, vec3(0.2126, 0.7152, 0.0722));
                    if (cacheOn) vaUpdateLight(rslot, lightLum * lightLum);

                    ShadowRay sr;
                    sr.o_tmax   = vec4(shadowOrigin, shadowMaxDist);
                    sr.dir      = L;
                    sr.slot     = slot;
                    sr.contrib  = contrib;
                    sr.lightIdx = emissivePtIdx;
                    sr.thp      = throughput;
                    sr.pad      = 0u;
                    uint si = atomicAdd(ctr.shadowCount, 1u);
                    shadowQueue[si] = sr;
                }
            }
        }

        float r1 = nextFloat(rng);
        float r2 = nextFloat(rng);
        vec3 Ve = vec3(dot(V, tangent), dot(V, bitangent), dot(V, offsetNorm));
        vec3 Hl = sampleGGXVNDFLocal(Ve, alpha, r1, r2);
        vec3 H = normalize(tangent * Hl.x + bitangent * Hl.y + offsetNorm * Hl.z);
        float VdotH = dot(V, H);
        if (VdotH < 0.0) {
            H = -H;
            VdotH = -VdotH;
        }
        vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH), 5.0);

        float r_type = nextFloat(grng);
        vec3 newDir, newOrigin, weight = vec3(0.0);
        isTransmissionInteraction = false;

        if (r_type < pspec) {
            newDir = normalize(2.0 * VdotH * H - V);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            float NDotL = dot(offsetNorm, newDir);
            if (NDotL > 0.0) {
                weight = F * (smith(NDotL, alpha2) / pspec);
            }
            lastBounceSpecular = true;
        } else if (r_type < pspec + pdiff) {
            bool terminateIntoProbes = (cam.ddgiEnabled != 0.0) && (bounce >= 1)
                                       && extentIsReusable(hitData.extent);
            if (terminateIntoProbes) {
                vec3 E = ddgiIrradianceAt(hitPoint, offsetNorm, dir);
                if (dot(E, E) <= 0.0) {
                    terminateIntoProbes = false;
                } else {
                    radiance += throughput * albedo.rgb * (vec3(1.0) - F) * E / PI;
                    p.rad.xyz = radiance;
                    p.u0.y = rng;
                    p.u0.z = grng;
                    p.i1.w &= ~FLAG_ALIVE;
                    pathsHot[slot] = p;
                    pathsHit[slot].misc = -1.0;
                    pathsHit[slot].neeSlot = WF_NO_SLOT;
                    return;
                }
            }
            float r3 = nextFloat(rng), r4 = nextFloat(rng);
            float Phid = 2.0 * PI * r3, rD = sqrt(r4);
            vec3 L_local = vec3(rD * cos(Phid), rD * sin(Phid), sqrt(max(0.0, 1.0 - r4)));
            newDir = normalize(tangent * L_local.x + bitangent * L_local.y + offsetNorm * L_local.z);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            weight = albedo.rgb * (vec3(1.0) - F) / pdiff;
            lastBounceSpecular = false;
        } else {
            isTransmissionInteraction = true;

            int curHero = hero;
            vec3 dispersionMask = vec3(1.0);
            if (curHero == 0) {
                curHero = clamp(int(nextFloat(grng) * 3.0) + 1, 1, 3);
                dispersionMask = heroMask(curHero) * 3.0;
                p.i1.w = SET_HERO(p.i1.w, curHero);
            }
            
            {
                float lh = heroLambda(curHero);
                float iorH = sampleIor(sellRow, lh);
                eta = (entering == 1) ? (1.0 / iorH) : iorH;
            }

            float NDotH = dot(offsetNorm, H);
            float sinThetaT2 = eta * eta * (1.0 - VdotH * VdotH);
            if (sinThetaT2 >= 1.0 || NDotH <= 1e-4) {
                newDir = normalize(2.0 * VdotH * H - V);
                newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                float NDotL = dot(offsetNorm, newDir);
                if (NDotL > 0.0) {
                    weight = dispersionMask * (smith(NDotL, alpha2) / pTrans);
                }
            } else {
                vec3 L = refract(-V, H, eta);
                if (dot(L, L) < 1e-8) {
                    newDir = normalize(2.0 * VdotH * H - V);
                    newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                } else {
                    newDir = normalize(L);
                    newOrigin = hitPoint - offsetNorm * DIST_EPSILON;
                    float NdotL = abs(dot(offsetNorm, newDir));
                    if (NdotL > 1e-4) {
                        weight = (vec3(1.0) - F) * dispersionMask
                               * (smith(NdotL, alpha2) / pTrans);
                    }
                    if (entering == 1) {
                        mediumObjId = hitData.objectId;
                        mediumVoxelIdx = hitIndex;
                    } else {
                        mediumObjId = -1;
                        mediumVoxelIdx = -1;
                    }
                }
            }
            lastBounceSpecular = true;
        }

        if (neeDone && !isTransmissionInteraction) {
            outMisc = bsdfPdfW(offsetNorm, V, newDir, alpha2, pspec, pdiff);
        } else {
            outMisc = -1.0;
        }

        if (bounce > 0 || transp > 0) {
            float lumW = dot(weight, vec3(0.2126, 0.7152, 0.0722));
            if (lumW > 2.0) weight *= 2.0 / lumW;
        } else {
            weight = min(weight, vec3(4.0));
        }
        throughput *= weight;
        if (max(max(throughput.x, throughput.y), throughput.z) < 0.01) {
            p.rad.xyz = radiance;
            p.u0.y = rng;
            p.u0.z = grng;
            p.i1.w &= ~FLAG_ALIVE;
            pathsHot[slot] = p;
            pathsHit[slot].misc = -1.0;
            pathsHit[slot].neeSlot = WF_NO_SLOT;
            return;
        }
        origin = newOrigin;
        dir = newDir;
        if (isTransmissionInteraction) {
            transp++;
            if (transp % 4 == 0) bounce++;
        }
        else bounce++;
    }

    if (bounce > cam.maxBounces || transp >= MAX_TRANSPARENT_BOUNCES || volum >= MAX_VOLUMETRIC_BOUNCES)
        continuePath = false;

    p.o_tmax = vec4(origin, remainingMaxDist);
    p.dir_rough = vec4(dir, pathRoughness);
    p.thp.xyz = throughput;
    p.rad.xyz = radiance;
    p.u0.y = rng;
    p.u0.z = grng;
    p.u0.w = PC_PACK(bounce, transp, volum);
    p.i1.x = mediumObjId;
    p.i1.y = mediumVoxelIdx;
    p.i1.w = (p.i1.w & ~FLAG_SPECULAR) | (lastBounceSpecular ? FLAG_SPECULAR : 0);
    p.i1.w &= ~FLAG_HITFOUND;

    if (!continuePath) p.i1.w &= ~FLAG_ALIVE;
    pathsHot[slot] = p;
    pathsHit[slot].misc = outMisc;
    pathsHit[slot].neeSlot = (outMisc > 0.0) ? outSlot : WF_NO_SLOT;
    pathsHit[slot].varLight = outVarL;
    pathsHit[slot].varBsdf = outVarB;

    if (continuePath) {
        if (!isTransmissionInteraction) {
            pathRoughness = min(pathRoughness + 0.15, 1.0);
        }
        uint q = atomicAdd(ctr.nextExtendCount, 1u);
        if (pc.parity == 0) extendB[q] = slot;
        else extendA[q] = slot;
    }
}
