#version 450
layout(local_size_x = 64) in;

struct GPURenderData {
    vec3 position;
    float size;
    uint color;
    uint materialIdx;
    int  objectId;
    uint extent;
};

vec3 unpackExtent(uint e) {
    return vec3(float((e & 0x3FFu) + 1u), float(((e >> 10) & 0x3FFu) + 1u), float(((e >> 20) & 0x3FFu) + 1u));
}
vec3 ptBoundsMin(GPURenderData p) { return p.position - p.size * 0.5; }
vec3 ptBoundsMax(GPURenderData p) { return p.position + p.size * 0.5 + p.size * (unpackExtent(p.extent) - vec3(1.0)); }


layout(std430, binding = 0) readonly buffer PointBuffer { GPURenderData points[]; };

// Matches VkAabbPositionsKHR: six tightly packed floats, 24 byte stride.
struct Aabb {
    float minX, minY, minZ;
    float maxX, maxY, maxZ;
};
layout(std430, binding = 1) writeonly buffer AabbBuffer { Aabb aabbs[]; };

layout(push_constant) uniform PC {
    uint pointCount;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.pointCount) return;

    GPURenderData pt = points[i];
    vec3 lo = ptBoundsMin(pt);
    vec3 hi = ptBoundsMax(pt);

    aabbs[i].minX = lo.x;
    aabbs[i].minY = lo.y;
    aabbs[i].minZ = lo.z;
    aabbs[i].maxX = hi.x;
    aabbs[i].maxY = hi.y;
    aabbs[i].maxZ = hi.z;
}
