#version 450
layout(local_size_x = 8, local_size_y = 8) in;

#define PI 3.14159265359
const float EPS = 1e-8;
const float LARGE = 1e30;
const float GAP_EPSILON = 1e-3;
const float DIST_EPSILON = 1e-4;

struct GPURenderNode {
    vec3 boundsMin;
    float padding1;
    vec3 boundsMax;
    float padding2;
    vec3 center;
    float nodeSize;
    uint isLeaf;
    uint isLoaded;
    uint isBigNode;
    uint firstPoint;
    uint pointCount;
    int  lodPoint;
    uint firstChild;
    uint padding3;
    uint childMask[16];
};

struct GPUPBRRenderData {
    vec3 position;
    float size;
    vec3 color;
    float emittance;
    vec3 boundsMin;
    float roughness;
    vec3 boundsMax;
    float metallic;
    vec3 absorption;
    float transmission;
    float ior;
    float padding1;
    float padding2;
    float padding3;
};

layout(std430, binding = 0) readonly buffer NodeBuffer { GPURenderNode nodes[]; };
layout(std430, binding = 1) readonly buffer PointBuffer { GPUPBRRenderData points[]; };
layout(std430, binding = 2) buffer OutputBuffer { float pixels[]; };

layout(binding = 3) uniform CameraData {
    vec3 origin;
    float lodMinDist;
    vec3 dir;
    float invLodf;
    vec3 up;
    float minVisibility;
    vec3 right;
    float maxDist;
    vec3 skylight;
    float tanfovx;
    vec3 bgColor;
    float tanfovy;
    int width;
    int height;
    int maxBounces;
    int useLod;
    float invFogRange;
    uint frameCount;
    int skyWidth;
    int skyHeight;
    int currentSampleOffset;
    int dispatchSamples;
    int globalIllumination;
    uint nodeCount;
    uint pointCount;
    int padding;
} cam;

layout(std430, binding = 4) readonly buffer SkyboxBuffer { vec4 skyPixels[]; };

vec3 safe_invDir(vec3 d) {
    return vec3(
        abs(d.x) < EPS ? (d.x < 0.0 ? -LARGE : LARGE) : 1.0 / d.x,
        abs(d.y) < EPS ? (d.y < 0.0 ? -LARGE : LARGE) : 1.0 / d.y,
        abs(d.z) < EPS ? (d.z < 0.0 ? -LARGE : LARGE) : 1.0 / d.z
    );
}

struct Ray {
    vec3 origin;
    vec3 dir;
    vec3 invDir;
    ivec3 signMask;
    //int signMask;
};

Ray makeRay(vec3 o, vec3 d) {
    Ray r;
    r.origin = o;
    r.dir = d;
    r.invDir = safe_invDir(d);
    r.signMask = ivec3(r.invDir.x < 0.0 ? 1 : 0, r.invDir.y < 0.0 ? 1 : 0, r.invDir.z < 0.0 ? 1 : 0);
    //int sx = r.invDir.x < 0 ? 1 : 0;
    //int sy = r.invDir.y < 0 ? 1 : 0;
    //int sz = r.invDir.z < 0 ? 1 : 0;
    //r.signMask = sx | (sy << 1) | (sz << 2);
    return r;
}

uint rng_state;

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void init_rng(ivec2 pixel_coord, int sample_idx) {
    rng_state = pcg_hash(pixel_coord.x + pixel_coord.y * cam.width + pcg_hash(cam.frameCount) + pcg_hash(sample_idx));
}

float nextFloat(inout uint state) {
    if (state == 0) state = 123456789;
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return (state & 0xFFFFFF) / 16777216.0f;
}

float random_float() {
    rng_state = pcg_hash(rng_state);
    return float(rng_state) / float(0xFFFFFFFFu);
}

bool rayBoxIntersect(Ray ray, vec3 bMin, vec3 bMax, out float tMin, out float tMax) {
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    
    vec3 tmin3 = min(t0, t1);
    vec3 tmax3 = max(t0, t1);
    
    tMin = max(max(tmin3.x, tmin3.y), tmin3.z);
    tMax = min(min(tmax3.x, tmax3.y), tmax3.z);

    return tMax >= max(0.0, tMin);
}

bool rayCubeIntersect(Ray ray, GPUPBRRenderData pt, out float t, out vec3 normal, out vec3 hitPoint, inout float tExit) {
    float tMin, tMax;
    vec3 t0 = (pt.boundsMin - ray.origin) * ray.invDir;
    vec3 t1 = (pt.boundsMax - ray.origin) * ray.invDir;
    
    vec3 tmin3 = min(t0, t1);
    vec3 tmax3 = max(t0, t1);
    
    tMin = max(max(tmin3.x, tmin3.y), tmin3.z);
    tMax = min(min(tmax3.x, tmax3.y), tmax3.z);

    if (tExit < -1.0) tExit = tMax;
    if (tMax < max(0.0, tMin)) return false;
    
    t = tMin < 0.0 ? tMax : tMin;
    hitPoint = ray.origin + ray.dir * t;
    vec3 dMin = abs(hitPoint - pt.boundsMin);
    vec3 dMax = abs(hitPoint - pt.boundsMax);
    vec3 minmin = min(dMin, dMax);
    float mind = min(min(minmin.x, minmin.y), minmin.z);
    
    normal = vec3(0.0);
    if (mind == dMin.x) normal.x = -1.0;
    else if (mind == dMax.x) normal.x = 1.0;
    else if (mind == dMin.y) normal.y = -1.0;
    else if (mind == dMax.y) normal.y = 1.0;
    else if (mind == dMin.z) normal.z = -1.0;
    else normal.z = 1.0;
    return true;
}

vec3 sampleSkybox(vec3 d) {
    float u = 0.5 + (atan(d.z, d.x) / (2.0 * PI));
    float v = 0.5 - (asin(clamp(d.y, -1.0, 1.0)) / PI);
    u = clamp(u, 0.0, 0.9999);
    v = clamp(v, 0.0, 0.9999);
    
    int x = int(u * float(cam.skyWidth));
    int y = int(v * float(cam.skyHeight));
    int idx = y * cam.skyWidth + x;
    
    if (idx < 0 || idx >= cam.skyWidth * cam.skyHeight) return cam.bgColor;
    return skyPixels[idx].rgb;
}

shared uint sharedStackNodes[64][32];
shared float sharedStackTMin[64][32];
shared float sharedStackTMax[64][32];

int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal, out vec3 outHitPoint);

float smith(float cost, float alpha2) {
    float cost2 = cost * cost;
    float tanT2 = (1.0 - cost2) / max(1e-5, cost2);
    if (tanT2 <= 0.0) return 1.0;
    return 2.0 / (1.0 + sqrt(1.0 + alpha2 * tanT2));
}

void createOrthoNormalBasis(vec3 n, out vec3 t, out vec3 b) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    t = normalize(cross(up, n));
    b = cross(n, t);
}

vec3 hemisphereSample(vec3 n, inout uint state) {
    float r1 = nextFloat(state);
    float r2 = nextFloat(state);
    float phi = 2.0 * PI * r1;
    float r = sqrt(r2);
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - x*x - y*y));
    vec3 t,b;
    createOrthoNormalBasis(n, t, b);
    return t * x + b * y + n * z;
}

vec3 traceRay(Ray initialRay, inout uint state, out float primaryDepth) {
    vec3 finalColor = vec3(0.0);
    vec3 throughput = vec3(1.0);
    int bounce = 0;
    int contiguousSteps = 0;
    vec3 origin = initialRay.origin;
    vec3 direction = initialRay.dir;

    primaryDepth = LARGE;

    while (bounce <= cam.maxBounces) {
        Ray cray = makeRay(origin, direction);
        int hitIndex = -1;
        float t = 0.0;
        vec3 normal = vec3(0.0);
        vec3 hitPoint = vec3(0.0);
        int hitResult = voxelTraverse(cray, hitIndex, t, normal, hitPoint);
        if (bounce == 0) primaryDepth = (hitResult == 1) ? t : LARGE;
        
        if (hitResult == 0) {
            if (bounce == 0) {
                finalColor += throughput * sampleSkybox(direction);
            } else if (cam.globalIllumination == 1) { 
                finalColor += throughput * sampleSkybox(direction); 
            } else {
                finalColor += throughput * cam.skylight;
            }
            break;
        }
        GPUPBRRenderData hitData = points[hitIndex];
        float tExit = -2.0;
        rayCubeIntersect(cray, hitData, t, normal, hitPoint, tExit);

        vec3 offsetNorm = normal;
        int entering = 0;
        if (dot(direction, normal) < 0.0) entering = 1;
        if (entering == 0) offsetNorm = -normal;
        vec3 albedo = hitData.color;
        float roughness = hitData.roughness;
        float metallic = hitData.metallic;
        float transmission = hitData.transmission;
        float ior = hitData.ior;

        if (entering == 0) throughput = throughput * exp(-hitData.absorption * t);
        if (entering == 0) { 
            Ray lookaheadRay = makeRay(hitPoint + normal * DIST_EPSILON, direction);
            int nextHitIdx; float nextT; vec3 nextNorm; vec3 nextHP;
            
            if (voxelTraverse(lookaheadRay, nextHitIdx, nextT, nextNorm, nextHP) == 1 
                && nextHitIdx != hitIndex 
                && nextT <= GAP_EPSILON) {
                
                GPUPBRRenderData nextData = points[nextHitIdx];
                bool sameMaterial = (abs(nextData.ior - ior) < 0.01) && 
                                    (distance(nextData.color, albedo) < 0.05) &&
                                    (abs(nextData.transmission - transmission) < 0.05);

                if (sameMaterial && contiguousSteps < 256) {
                    origin = nextHP + direction * DIST_EPSILON;
                    contiguousSteps++;
                    continue; 
                }
            }
        }
        vec3 emitted = albedo * hitData.emittance;
        finalColor += throughput * emitted;
        vec3 F0 = mix(vec3(0.04), albedo, metallic);

        float maxReflectance = max(max(max(albedo.x, albedo.y), albedo.z), max(max(F0.x, F0.y), F0.z));
        float continueProb = clamp(maxReflectance, 0.1, 0.95);
        if (bounce > 2) {
            if (nextFloat(state) > continueProb) break;
            throughput /= continueProb;
        } 

        vec3 V = -direction;
        float eta = (entering == 1) ? (1.0 / ior) : ior;
        float alpha = max(1e-5, roughness * roughness);
        float alpha2 = alpha * alpha;

        float r1 = nextFloat(state);
        float r2 = nextFloat(state);
        float phi = 2.0 * PI * r1;
        float cosThetaM = sqrt(max(0.0, (1.0 - r2) / (1.0 + (alpha2 - 1.0) * r2)));
        float sinThetaM = sqrt(max(0.0, 1.0 - cosThetaM * cosThetaM));

        vec3 up = abs(offsetNorm.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
        vec3 tangent = normalize(cross(up, offsetNorm));
        vec3 bitangent = cross(offsetNorm, tangent);
        vec3 H = normalize(tangent * sinThetaM * cos(phi) + bitangent * sinThetaM * sin(phi) + offsetNorm * cosThetaM);

        float VdotH = dot(V, H);
        if (VdotH < 0.0) {
            H = -H;
            VdotH = -VdotH;
        }

        vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH), 5.0);

        float probSpec = (F.x + F.y + F.z) * 0.333333; 
        float probT = (1.0 - metallic) * transmission;
        float probDiffuse = (1.0 - metallic) * (1.0 - transmission);
        float pspec = probSpec;
        float pdiff = probDiffuse * (1.0 - pspec);
        float pTrans = probT * (1.0 - pspec);
        float sump = pspec + pdiff + pTrans;
        if (sump <= 1e-5) {
            pspec = 1.0;
            pdiff = 0.0;
            pTrans = 0.0;
        } else {
            float insump = 1 / sump;
            pspec = pspec * insump;
            pdiff = pdiff * insump;
            pTrans = pTrans * insump;
        }

        float r_type = nextFloat(state);
        vec3 newDir;
        vec3 newOrigin;
        vec3 weight = vec3(0.0);
        float NdotV = max(1e-5, dot(offsetNorm, V));
        if (r_type < pspec) {
            newDir = normalize(2.0 * VdotH * H - V);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            float NDotL = dot(offsetNorm, newDir);
            float NDotH = max(1e-5, dot(offsetNorm, H));
            if (NDotL > 0.0) {
                float G = smith(NdotV, alpha2) * smith(NDotL, alpha2);
                weight = F * (G * VdotH / (NdotV * NDotH * pspec));
            }
        } else if (r_type < pspec + pdiff) {
            float r3 = nextFloat(state);
            float r4 = nextFloat(state);
            float Phid = 2.0 * PI * r3;
            float rD = sqrt(r4);
            vec3 L_local = vec3(rD * cos(Phid), rD * sin(Phid), sqrt(max(0.0, 1.0 - r4)));
            newDir = normalize(tangent * L_local.x + bitangent * L_local.y + offsetNorm * L_local.z);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            weight = albedo * (vec3(1.0) - F) / pdiff;
        } else {
            float sinThetaT2 = eta * eta * (1.0 - VdotH * VdotH);
            if (sinThetaT2 >= 1.0) {
                newDir = normalize(2.0 * VdotH * H - V);
                newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                float NDotL = dot(offsetNorm, newDir);
                if (NDotL > 0.0) {
                    float G = smith(NdotV, alpha2) * smith(NDotL, alpha2);
                    float NDotH = max(1e-5, dot(offsetNorm, H));
                    weight = vec3(1.0) * (G * abs(VdotH) / (NdotV * NDotH * pTrans));
                }
                if (entering == 0) {
                    weight *= exp(-hitData.absorption * t);
                }
            } else {
                float cosThetaT = sqrt(1.0 - sinThetaT2);
                newDir = normalize((eta * VdotH - cosThetaT) * H - eta * V);
                newOrigin = hitPoint - offsetNorm * DIST_EPSILON; 
                float NdotL = max(1e-5, dot(offsetNorm, -newDir));
                float G = smith(NdotV, alpha2) * smith(NdotL, alpha2);
                float NDotH = max(1e-5, dot(offsetNorm, H));
                weight = albedo * (vec3(1.0) - F) * (G * abs(VdotH) / (NdotV * NDotH * pTrans));
            }
        }
        
        weight = min(weight, vec3(4.0));
        if (bounce > 2) weight = weight / continueProb;
        throughput = throughput * weight;
        origin = newOrigin;
        direction = newDir;
        ++bounce;
        contiguousSteps = 0;
    }
    return finalColor;
}

void checkAndUpdateHit(Ray ray, int ptIdx, float ptT, vec3 ptN, vec3 ptHP, inout int hitFound,
     inout float currentMaxDist, inout float outT, inout vec3 outNormal, inout vec3 outHitPoint,
     inout int hitIndex) {
    bool isNewExit = dot(ray.dir, ptN) > 0.0;
    bool isCurrExit = (hitFound == 1) && (dot(ray.dir, outNormal) > 0.0);
    
    bool shouldUpdate = false;
    if (hitFound == 0) {
        if (ptT <= currentMaxDist) shouldUpdate = true;
    } else {
        if (ptT < currentMaxDist - 1e-5) {
            shouldUpdate = true;
        } else if (ptT <= currentMaxDist + 1e-5) {
            if (isNewExit && !isCurrExit) shouldUpdate = true;
        }
    }
    
    if (shouldUpdate) {
        currentMaxDist = ptT;
        outT = ptT;
        outNormal = ptN;
        outHitPoint = ptHP;
        hitIndex = ptIdx;
        hitFound = 1;
    }
}

int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal, out vec3 outHitPoint) {
    uint localId = gl_LocalInvocationID.y * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    float tMin, tMax;
    if (nodes.length() == 0 || !rayBoxIntersect(ray, nodes[0].boundsMin, nodes[0].boundsMax, tMin, tMax)) return 0;
    float currentMaxDist = cam.maxDist;
    tMax = min(tMax, currentMaxDist);

    int stackPtr = 0;
    sharedStackNodes[localId][stackPtr] = 0;
    sharedStackTMin[localId][stackPtr] = max(0.0, tMin);
    sharedStackTMax[localId][stackPtr] = tMax;
    stackPtr++;

    int hitFound = 0;
    while (stackPtr > 0) {
        stackPtr--;
        uint nodeIdx = sharedStackNodes[localId][stackPtr];
        float t0 = sharedStackTMin[localId][stackPtr];
        float t1 = sharedStackTMax[localId][stackPtr];
        if (t0 > currentMaxDist) continue;
        if (nodeIdx > nodes.length()) continue;
        GPURenderNode node = nodes[nodeIdx];
        if (node.isLoaded == 0) {
            //normally would load here. but gpu so dont.
            if (cam.useLod == 1 && node.lodPoint != -1) {
                float t;
                float texit = 0.0;
                vec3 n;
                vec3 hp;
                if (rayCubeIntersect(ray, points[node.lodPoint], t, n, hp, texit)) {
                    if (t >= 0.0) {
                        checkAndUpdateHit(ray, node.lodPoint, t, n, hp, 
                                          hitFound, currentMaxDist, outT, outNormal, outHitPoint, hitIndex);
                    }
                }
            } 
            continue;
        } 
        if (cam.useLod == 1 && node.isLeaf == 0) {
            float dist = distance(node.center, ray.origin);
            float ratio = dist / node.nodeSize;
            if (dist > cam.lodMinDist && ratio > cam.invLodf && node.lodPoint != -1) {
                float t;
                float texit = 0.0;
                vec3 n;
                vec3 hp;
                if (rayCubeIntersect(ray, points[node.lodPoint], t, n, hp, texit)) {
                    if (t >= 0.0) {
                        checkAndUpdateHit(ray, node.lodPoint, t, n, hp, 
                                          hitFound, currentMaxDist, outT, outNormal, outHitPoint, hitIndex);
                    }
                }
                continue;
            }
        }

        for (uint i = 0; i < node.pointCount; ++i) {
            float t;
            float texit = 0.0;
            vec3 n;
            vec3 hp;
            uint pointIdx = node.firstPoint + i;
            if (rayCubeIntersect(ray, points[pointIdx], t, n, hp, texit)) {
                if (t >= 0.0 && t <= t1 + 0.001) {
                    checkAndUpdateHit(ray, int(pointIdx), t, n, hp, 
                                      hitFound, currentMaxDist, outT, outNormal, outHitPoint, hitIndex);
                }
            }
        }
        if (node.isLeaf == 1) continue;

        if (node.isBigNode == 0) {
            vec3 ttt = (node.center - ray.origin) * ray.invDir;
            int currIdx = ((t0 >= ttt.x) ? 1 : 0) | ((t0 >= ttt.y) ? 2 : 0) | ((t0 >= ttt.z) ? 4 : 0);
            int raySignMask = ray.signMask.x | (ray.signMask.y << 1) | (ray.signMask.z << 2);
            uint childNodes[4];
            float childTMin[4];
            float childTMax[4];
            int childCount = 0;
            float next_tx, next_ty, next_tz;

            while(t0 < t1 && t0 <= currentMaxDist) {
                next_tx = (currIdx & 1) != 0 ? t1 : ttt.x;
                next_ty = (currIdx & 2) != 0 ? t1 : ttt.y;
                next_tz = (currIdx & 4) != 0 ? t1 : ttt.z;
                float tNext = min(min(next_tx, next_ty), next_tz);
                if (isnan(tNext) || isinf(tNext)) break;

                int physIdx = currIdx ^ raySignMask;
                if ((node.childMask[0] & (1u << physIdx)) != 0) {
                    uint mask = node.childMask[0] & ((1u << physIdx) - 1u);
                    uint childOffset = bitCount(mask);
                    if(childCount < 4) {
                        childNodes[childCount] = node.firstChild + childOffset;
                        childTMin[childCount] = t0;
                        childTMax[childCount] = tNext;
                        childCount++;
                    }
                }
                t0 = tNext;
                currIdx |= ((next_tx <= tNext) ? 1 : 0) | ((next_ty <= tNext) ? 2 : 0) | ((next_tz <= tNext) ? 4 : 0);
            }
            if (stackPtr + childCount > 256) continue;
            for (int i = childCount - 1; i >= 0; --i) {
                sharedStackNodes[localId][stackPtr] = childNodes[i];
                sharedStackTMin[localId][stackPtr] = childTMin[i];
                sharedStackTMax[localId][stackPtr] = childTMax[i];
                stackPtr++;
            }
        } else {
            float N = 8.0;
            vec3 cellSize = (node.boundsMax - node.boundsMin) / N;
            
            vec3 enterPoint = ray.origin + ray.dir * max(0.0, t0);
            enterPoint = clamp(enterPoint, node.boundsMin, node.boundsMax);
            
            ivec3 c = ivec3(clamp((enterPoint - node.boundsMin) / cellSize, vec3(0.0), vec3(N - 1.0)));
            vec3 tDelta = abs(cellSize * ray.invDir);
            ivec3 stepDir = ivec3(sign(ray.dir));
            stepDir += ivec3(stepDir.x == 0 ? 1 : 0, stepDir.y == 0 ? 1 : 0, stepDir.z == 0 ? 1 : 0);
            
            vec3 tNext;
            tNext.x = (node.boundsMin.x + float(stepDir.x > 0 ? c.x + 1 : c.x) * cellSize.x - ray.origin.x) * ray.invDir.x;
            tNext.y = (node.boundsMin.y + float(stepDir.y > 0 ? c.y + 1 : c.y) * cellSize.y - ray.origin.y) * ray.invDir.y;
            tNext.z = (node.boundsMin.z + float(stepDir.z > 0 ? c.z + 1 : c.z) * cellSize.z - ray.origin.z) * ray.invDir.z;

            uint childNodes[24];
            float childTMin[24];
            float childTMax[24];
            int childCount = 0;
            float currentT = t0;

            for (int stepIdx = 0; stepIdx < 24; ++stepIdx) {
                if (c.x < 0 || c.x >= 8 || c.y < 0 || c.y >= 8 || c.z < 0 || c.z >= 8) break;

                int childIdx = c.x + c.y * 8 + c.z * 64;
                int maskIdx = childIdx / 32;
                int bitIdx = childIdx % 32;

                if ((node.childMask[maskIdx] & (1u << bitIdx)) != 0) {
                    uint offset = 0;
                    for (int m = 0; m < maskIdx; ++m) offset += bitCount(node.childMask[m]);
                    offset += bitCount(node.childMask[maskIdx] & ((1u << bitIdx) - 1u));
                    
                    float nextT = min(min(tNext.x, tNext.y), tNext.z);
                    childNodes[childCount] = node.firstChild + offset;
                    childTMin[childCount] = currentT;
                    childTMax[childCount] = min(nextT, t1);
                    childCount++;
                }

                if (tNext.x < tNext.y) {
                    if (tNext.x < tNext.z) { currentT = tNext.x; c.x += stepDir.x; tNext.x += tDelta.x; } 
                    else { currentT = tNext.z; c.z += stepDir.z; tNext.z += tDelta.z; }
                } else {
                    if (tNext.y < tNext.z) { currentT = tNext.y; c.y += stepDir.y; tNext.y += tDelta.y; } 
                    else { currentT = tNext.z; c.z += stepDir.z; tNext.z += tDelta.z; }
                }
                if (currentT > t1 || currentT > currentMaxDist) break;
            }

            if (stackPtr + childCount > 256) continue;
            for (int i = childCount - 1; i >= 0; --i) {
                sharedStackNodes[localId][stackPtr] = childNodes[i];
                sharedStackTMin[localId][stackPtr] = childTMin[i];
                sharedStackTMax[localId][stackPtr] = childTMax[i];
                stackPtr++;
            }
        }
    }
    return hitFound;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= cam.width || coord.y >= cam.height) return;
    uint idx = (coord.y * cam.width + coord.x) * 4;
    if (idx + 3 >= pixels.length()) return;

    vec3 accumulatedColor = vec3(0.0);
    float accumulatedDepth = 0.0;
    
    for (int s = 0; s < cam.dispatchSamples; ++s) {
        int global_s = cam.currentSampleOffset + s;
        init_rng(coord, global_s);
        
        float px = (2.0 * (float(coord.x) + nextFloat(rng_state)) / float(cam.width) - 1.0) * cam.tanfovx;
        float py = (1.0 - 2.0 * (float(coord.y) + nextFloat(rng_state)) / float(cam.height)) * cam.tanfovy;
        
        vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
        Ray ray = makeRay(cam.origin, rayDir);
        
        float pDepth;
        accumulatedColor += traceRay(ray, rng_state, pDepth);
        accumulatedDepth += pDepth;
    }
    
    if (cam.currentSampleOffset == 0) {
        pixels[idx]     = accumulatedColor.r;
        pixels[idx + 1] = accumulatedColor.g;
        pixels[idx + 2] = accumulatedColor.b;
        pixels[idx + 3] = accumulatedDepth;
    } else {
        pixels[idx]     += accumulatedColor.r;
        pixels[idx + 1] += accumulatedColor.g;
        pixels[idx + 2] += accumulatedColor.b;
        pixels[idx + 3] += accumulatedDepth;
    }
}