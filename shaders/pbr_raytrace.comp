#version 450
layout(local_size_x = 8, local_size_y = 8) in;

#define PI 3.14159265359
const float EPS = 1e-8;
const float LARGE = 1e30;


struct GPURenderNode {
    vec3 boundsMin;
    float padding1;
    vec3 boundsMax;
    float padding2;
    vec3 center;
    float nodeSize;
    uint isLeaf;
    uint isLoaded;
    uint childMask;
    uint firstPoint;
    uint pointCount;
    int  lodPoint;
    uint firstChild;
    uint padding3;
};

struct GPUPBRRenderData {
    vec3 position;
    float size;
    vec3 color;
    float emittance;
    vec3 boundsMin;
    float roughness;
    vec3 boundsMax;
    float metallic;
    float transmission;
    float ior;
    float padding1;
    float padding2;
};

layout(std430, binding = 0) readonly buffer NodeBuffer { GPURenderNode nodes[]; };
layout(std430, binding = 1) readonly buffer PointBuffer { GPUPBRRenderData points[]; };
layout(std430, binding = 2) writeonly buffer OutputBuffer { float pixels[]; };

layout(binding = 3) uniform CameraData {
    vec3 origin;
    float lodMinDist;
    vec3 dir;
    float invLodf;
    vec3 up;
    float minVisibility;
    vec3 right;
    float maxDist;
    vec3 skylight;
    float tanfovx;
    vec3 bgColor;
    float tanfovy;
    int width;
    int height;
    int samples;
    int maxBounces;
    int useLod;
    float invFogRange;
    uint frameCount;
} cam;

vec3 safe_invDir(vec3 d) {
    return vec3(
        abs(d.x) < EPS ? (d.x < 0.0 ? -LARGE : LARGE) : 1.0 / d.x,
        abs(d.y) < EPS ? (d.y < 0.0 ? -LARGE : LARGE) : 1.0 / d.y,
        abs(d.z) < EPS ? (d.z < 0.0 ? -LARGE : LARGE) : 1.0 / d.z
    );
}

struct Ray {
    vec3 origin;
    vec3 dir;
    vec3 invDir;
    ivec3 signMask;
    //int signMask;
};

Ray makeRay(vec3 o, vec3 d) {
    Ray r;
    r.origin = o;
    r.dir = d;
    r.invDir = safe_invDir(d);
    r.signMask = ivec3(r.invDir.x < 0 ? 1 : 0, r.invDir.y < 0 ? 1 : 0, r.invDir.z < 0 ? 1 : 0);
    //int sx = r.invDir.x < 0 ? 1 : 0;
    //int sy = r.invDir.y < 0 ? 1 : 0;
    //int sz = r.invDir.z < 0 ? 1 : 0;
    //r.signMask = sx | (sy << 1) | (sz << 2);
    return r;
}

uint rng_state;

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void init_rng(ivec2 pixel_coord) {
    rng_state = pcg_hash(pixel_coord.x + pixel_coord.y * cam.width + pcg_hash(cam.frameCount));
}

float nextFloat(inout uint state) {
    if (state == 0) state = 123456789;
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return (state & 0xFFFFFF) / 16777216.0f;
}

float random_float() {
    rng_state = pcg_hash(rng_state);
    return float(rng_state) / float(0xFFFFFFFFu);
}

bool rayBoxIntersect(Ray ray, vec3 bMin, vec3 bMax, out float tMin, out float tMax) {
    float tx1 = (bMin.x - ray.origin.x) * ray.invDir.x;
    float tx2 = (bMax.x - ray.origin.x) * ray.invDir.x;
    tMin = min(tx1, tx2);
    tMax = max(tx1, tx2);
    
    float ty1 = (bMin.y - ray.origin.y) * ray.invDir.y;
    float ty2 = (bMax.y - ray.origin.y) * ray.invDir.y;
    tMin = max(tMin, min(ty1, ty2));
    tMax = min(tMax, max(ty1, ty2));
    
    float tz1 = (bMin.z - ray.origin.z) * ray.invDir.z;
    float tz2 = (bMax.z - ray.origin.z) * ray.invDir.z;

    tMin = max(tMin, min(tz1, tz2));
    tMax = min(tMax, max(tz1, tz2));

    return tMax >= max(0.0, tMin);
}


bool rayCubeIntersect(Ray ray, GPUPBRRenderData pt, out float t, out vec3 normal, inout float tExit) {
    float tMin, tMax;
    vec3 bMin = pt.boundsMin;
    vec3 bMax = pt.boundsMax;

    float tx1 = (bMin.x - ray.origin.x) * ray.invDir.x;
    float tx2 = (bMax.x - ray.origin.x) * ray.invDir.x;
    tMin = min(tx1, tx2);
    tMax = max(tx1, tx2);
    
    float ty1 = (bMin.y - ray.origin.y) * ray.invDir.y;
    float ty2 = (bMax.y - ray.origin.y) * ray.invDir.y;
    tMin = max(tMin, min(ty1, ty2));
    tMax = min(tMax, max(ty1, ty2));
    
    float tz1 = (bMin.z - ray.origin.z) * ray.invDir.z;
    float tz2 = (bMax.z - ray.origin.z) * ray.invDir.z;

    tMin = max(tMin, min(tz1, tz2));
    tMax = min(tMax, max(tz1, tz2));

    if (tExit < -1) tExit = tMax;
    if (tMax < max(0.0, tMin)) return false;
    

    t = tMin < 0.0 ? tMax : tMin;
    vec3 hitPoint = ray.origin + ray.dir * t;
    vec3 dMin = abs(hitPoint - pt.boundsMin);
    vec3 dMax = abs(hitPoint - pt.boundsMax);
    float minDist = 999999.0;
    int minAxis = 0;
    float sign = 1.0;
    for (int i = 0; i < 3; ++i) {
        if (dMin[i] < minDist) {
            minDist = dMin[i];
            minAxis = i;
            sign = -1.0f;
        }
        if (dMax[i] < minDist) {
            minDist = dMax[i];
            minAxis = i;
            sign = 1.0f;
        }
    }
    normal = vec3(0);
    normal[minAxis] = sign;
    return true;
}

int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal);

vec3 schlick(float cos_theta, vec3 F0) { return F0 + (1.0 - F0) * pow(1.0 - cos_theta, 5.0); }
void createOrthoNormalBasis(vec3 n, out vec3 t, out vec3 b) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    t = normalize(cross(up, n));
    b = cross(n, t);
}

vec3 hemisphereSample(vec3 n, inout uint state) {
    float r1 = nextFloat(state);
    float r2 = nextFloat(state);
    float phi = 2.0 * PI * r1;
    float r = sqrt(r2);
    float x = r * cos(phi);
    float y = r * sin(phi);
    float z = sqrt(max(0.0, 1.0 - x*x - y*y));
    vec3 t,b;
    createOrthoNormalBasis(n, t, b);
    return t * x + b * y + n * z;
}

vec3 traceRay(Ray initialRay, uint state) {
    vec3 finalColor = vec3(0.0);
    vec3 throughput = vec3(1.0);
    Ray currentRay = initialRay;
    float p = 1.0;

    for (int bounce = 0; bounce < cam.maxBounces; ++bounce) {
        int hitIndex = -1;
        float t = 0.0;
        vec3 normal = vec3(0.0);
        int hitResult = voxelTraverse(currentRay, hitIndex, t, normal);
        
        if (hitResult == 0) {
            finalColor += throughput * cam.skylight;
            break;
        }

        GPUPBRRenderData hitData = points[hitIndex];
        vec3 hitPoint = currentRay.origin + currentRay.dir * t;
        float rayOffset = 0.0001;

        finalColor += throughput * hitData.emittance * hitData.color;

        vec3 V = -currentRay.dir;
        bool is_inside = dot(normal, V) < 0;
        vec3 n_eff = is_inside ? -normal : normal;

        vec3 F0 = mix(vec3(0.04), hitData.color, hitData.metallic);
        vec3 F = schlick(max(0.0, dot(n_eff, V)), F0);

        float spec_prob = max(F.r, max(F.g, F.b));
        float diffuse_prob = (1.0 - spec_prob) * (1.0 - hitData.transmission);
        float transmission_prob = (1.0 - spec_prob) * hitData.transmission;
        
        vec3 albedo = hitData.color;

        // Russian Roulette
        p = max(albedo.r, max(albedo.g, albedo.b));
        if (bounce > 2) {
            if (nextFloat(state) > p) break;
            throughput /= p;
        }
        
        float r = nextFloat(state);
        if (r < spec_prob) { // Specular reflection
            vec3 H = hemisphereSample(n_eff, state);
            currentRay.dir = reflect(-V, H);
            currentRay.origin = hitPoint + n_eff * rayOffset;
            throughput *= F;
        } else if (r < spec_prob + diffuse_prob) { // Diffuse
            currentRay.dir = hemisphereSample(n_eff, state);
            currentRay.origin = hitPoint + n_eff * rayOffset;
            throughput *= (1.0 - F) * (1.0 - hitData.transmission) * albedo;
        } else { // Transmission / Refraction
            float eta = is_inside ? hitData.ior : 1.0 / hitData.ior;
            vec3 R = refract(-V, n_eff, eta);
            if (dot(R,R) == 0.0) { // Total internal reflection
                 currentRay.dir = reflect(-V, n_eff);
                 currentRay.origin = hitPoint + n_eff * rayOffset;
            } else {
                 currentRay.dir = R;
                 currentRay.origin = hitPoint - n_eff * rayOffset;
            }
            throughput *= (1.0 - F) * albedo;
        }
    }
    return finalColor;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= cam.width || coord.y >= cam.height) return;

    init_rng(coord);
    
    vec3 accumulatedColor = vec3(0.0);
    uint state = pcg_hash(1);
    for (int s = 0; s < cam.samples; ++s) {
        float px = (2.0 * (float(coord.x) + nextFloat(state)) / float(cam.width) - 1.0) * cam.tanfovx;
        float py = (1.0 - 2.0 * (float(coord.y) + nextFloat(state)) / float(cam.height)) * cam.tanfovy;
        uint thisstate = pcg_hash(state + s);
        vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
        Ray ray = makeRay(cam.origin, rayDir);
        accumulatedColor += traceRay(ray, thisstate);
    }

    vec3 finalColor = accumulatedColor / float(cam.samples);
    finalColor = pow(finalColor, vec3(1.0/2.2)); // Gamma correction
    
    finalColor = clamp(finalColor, 0.0, 1.0);
    uint idx = (coord.y * cam.width + coord.x) * 3;
    pixels[idx]     = finalColor.r;
    pixels[idx + 1] = finalColor.g;
    pixels[idx + 2] = finalColor.b;
}

int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal) {
    float tMin, tMax;
    if (nodes.length() == 0 || !rayBoxIntersect(ray, nodes[0].boundsMin, nodes[0].boundsMax, tMin, tMax)) return 0;
    float currentMaxDist = cam.maxDist;
    tMax = min(tMax, currentMaxDist);

    uint stackNodes[64];
    float stackTMin[64];
    float stackTMax[64];
    int stackPtr = 0;
    stackNodes[stackPtr] = 0;
    stackTMin[stackPtr] = max(0.0, tMin);
    stackTMax[stackPtr] = tMax;
    stackPtr++;

    int hitFound = 0;
    while (stackPtr > 0) {
        if (stackPtr >= 64) break;
        stackPtr--;
        uint nodeIdx = stackNodes[stackPtr];
        float t0 = stackTMin[stackPtr];
        float t1 = stackTMax[stackPtr];
        if (t0 > currentMaxDist) continue;
        if (nodeIdx >= nodes.length()) continue;
        GPURenderNode node = nodes[nodeIdx];
        bool useLOD = false;
        if (cam.useLod == 1 && node.lodPoint != -1) {
            if (node.isLoaded == 0) {
                useLOD = true;
            } else if (node.isLeaf == 0) {
                float dist = distance(node.center, ray.origin);
                if (dist > cam.lodMinDist && (dist / node.nodeSize) > cam.invLodf) {
                    useLOD = true;
                }
            }
        }
        if (useLOD) {
            float t;
            float texit = 0.0;
            vec3 n;
            if (rayCubeIntersect(ray, points[node.lodPoint], t, n, texit)) {
                if (t >= 0.0 && t <= currentMaxDist) {
                    currentMaxDist = t;
                    outT = t;
                    outNormal = n;
                    hitIndex = node.lodPoint;
                    hitFound = 1;
                }
            }
            continue;            
        }
        if (node.isLoaded == 0) {
            continue;
        }
        for (uint i = 0; i < node.pointCount; ++i) {
            float t;
            float texit = 0.0;
            vec3 n;
            uint pointIdx = node.firstPoint + i;
            if (pointIdx >= points.length()) continue;
            if (rayCubeIntersect(ray, points[pointIdx], t, n, texit)) {
                if (t >= 0.0 && t <= currentMaxDist && t <= t1 + 0.001) {
                    currentMaxDist = t;
                    outT = t;
                    outNormal = n;
                    hitIndex = int(pointIdx);
                    hitFound = 1;
                }
            }
        }
        if (node.isLeaf == 1) continue;
        vec3 ttt = (node.center - ray.origin) * ray.invDir;
        int currIdx = ((t0 >= ttt.x) ? 1 : 0) | ((t0 >= ttt.y) ? 2 : 0) | ((t0 >= ttt.z) ? 4 : 0);
        int raySignMask = ray.signMask.x | (ray.signMask.y << 1) | (ray.signMask.z << 2);
        uint childNodes[8];
        float childTMin[8];
        float childTMax[8];
        int childCount = 0;
        float next_tx;
        float next_ty;
        float next_tz;
        while(t0 < t1 && t0 <= currentMaxDist) {
            next_tx = (currIdx & 1) != 0 ? t1 : ttt.x;
            next_ty = (currIdx & 2) != 0 ? t1 : ttt.y;
            next_tz = (currIdx & 4) != 0 ? t1 : ttt.z;
            float tNext = min(min(next_tx, next_ty), next_tz);
            int physIdx = currIdx ^ raySignMask;
            if ((node.childMask & (1 << physIdx)) != 0) {
                uint mask = node.childMask & ((1 << physIdx) - 1);
                uint childOffset = bitCount(mask);
                if(childCount < 8) {
                    childNodes[childCount] = node.firstChild + childOffset;
                    childTMin[childCount] = t0;
                    childTMax[childCount] = tNext;
                    childCount++;
                }
            }
            t0 = tNext;
            currIdx |= ((next_tx <= tNext) ? 1 : 0) | ((next_ty <= tNext) ? 2 : 0) | ((next_tz <= tNext) ? 4 : 0);
        }
        if (stackPtr + childCount <= 64) {
            for (int i = childCount - 1; i >= 0; --i) {
                stackNodes[stackPtr] = childNodes[i];
                stackTMin[stackPtr] = childTMin[i];
                stackTMax[stackPtr] = childTMax[i];
                stackPtr++;
            }
        }
    }
    return hitFound;
}
