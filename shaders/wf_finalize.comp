#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "wf_common.glsl"

void main() {
    uint gid = gl_GlobalInvocationID.x;

    int tileW = min(512, cam.width  - cam.tileOffsetX);
    int tileH = min(512, cam.height - cam.tileOffsetY);
    if (tileW <= 0 || tileH <= 0) return;
    if (gid >= uint(tileW) * uint(tileH)) return;

    ivec2 local = ivec2(int(gid) % tileW, int(gid) / tileW);
    ivec2 coord = local + ivec2(cam.tileOffsetX, cam.tileOffsetY);
    if (coord.x >= cam.width || coord.y >= cam.height) return;

    uint pixelIndex = uint(coord.y * cam.width + coord.x);
    uint idx = pixelIndex * 5u;
    uint ad  = pixelIndex * 5u;
    if (idx + 4u >= uint(pixels.length())) return;

    int s = pc.sampleIndex;
    bool firstEver = (cam.currentSampleOffset == 0) && (s == 0);

    float storedReq = firstEver ? float(cam.targetSamples) : adaptiveData[ad + 2u];
    bool done = (!firstEver) && (storedReq < 0.0);
    float reqSamples = abs(storedReq);
    if (done) return;

    if (float(s) >= reqSamples) {
        float scale = float(cam.targetSamples) / max(1.0, reqSamples);
        pixels[idx]      *= scale;
        pixels[idx + 1u] *= scale;
        pixels[idx + 2u] *= scale;
        pixels[idx + 3u] *= scale;
        adaptiveData[ad + 2u] = -reqSamples;
        return;
    }

    PathHot p = pathsHot[gid];
    vec3 rad = p.rad.xyz;
    if (isInvalid(rad)) rad = vec3(0.0);
    float depth = p.rad.w;
    float complexity = p.thp.w;
    float objId = float(p.i1.z);
    float lum = dot(rad, vec3(0.2126, 0.7152, 0.0722));

    if (firstEver) {
        pixels[idx]      = rad.r;
        pixels[idx + 1u] = rad.g;
        pixels[idx + 2u] = rad.b;
        pixels[idx + 3u] = depth;
        pixels[idx + 4u] = objId;
        adaptiveData[ad]      = lum;
        adaptiveData[ad + 1u] = lum * lum;
        adaptiveData[ad + 2u] = max(1.0, float(cam.targetSamples) * complexity);
        adaptiveData[ad + 3u] = 0.0;
    } else {
        pixels[idx]      += rad.r;
        pixels[idx + 1u] += rad.g;
        pixels[idx + 2u] += rad.b;
        pixels[idx + 3u] += depth;
        float lumSum   = adaptiveData[ad]      + lum;
        float lumSqSum = adaptiveData[ad + 1u] + lum * lum;
        adaptiveData[ad]      = lumSum;
        adaptiveData[ad + 1u] = lumSqSum;

        int checkInterval = max(1, cam.targetSamples / 10);
        if (s > 0 && (s % checkInterval == 0)) {
            float n = float(s + 1);
            float mean = lumSum / n;
            float sampleVar = max(0.0, (lumSqSum / n) - mean * mean);
            float stdErr = sqrt(sampleVar / n);
            float relErr = stdErr / (mean + 1e-4);
            float relThresh = clamp(0.16 * inversesqrt(float(cam.targetSamples)), 0.0005, 0.02);
            if (relErr < relThresh) {
                float passes = adaptiveData[ad + 3u] + 1.0;
                adaptiveData[ad + 3u] = passes;
                if (passes >= 2.0) {
                    adaptiveData[ad + 2u] = n;
                }
            } else {
                adaptiveData[ad + 3u] = 0.0;
                if (reqSamples < float(cam.targetSamples)) {
                    adaptiveData[ad + 2u] = float(cam.targetSamples);
                }
            }
        }
    }
}
