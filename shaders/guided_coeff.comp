#version 450
// Guided-filter coefficient pass (He et al.) for guided UPSAMPLING of the
// low-res MIS path trace.
//
// For every low-res pixel we fit a local linear model per channel:
//     PT_low  ~=  a * guide_low + b
// over an object-masked window. The (a, b) fields are smooth by construction,
// so they can be upsampled cheaply and evaluated against the FULL-res guide:
//     out_full = a_up * guide_full + b_up
// This transfers the path trace's illumination onto the guide while keeping
// every full-res detail the guide has. It also degrades gracefully: where the
// guide is flat or black, var(g) -> 0, so a -> 0 and b -> mean(PT) — i.e. it
// automatically falls back to plain upsampled path tracing.
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push {
    int lowW;
    int lowH;
    int fullW;
    int fullH;
    int samples;   // 1 if the PT buffer was pre-smoothed/normalized
} pc;

layout(std430, binding = 0) readonly buffer GuideBuf { float guideData[]; }; // full res, 5-stride
layout(std430, binding = 1) readonly buffer PBRBuf   { float pbrData[]; };   // low res, 5-stride
layout(std430, binding = 2) writeonly buffer CoeffBuf { float coeff[]; };    // low res, 6-stride: aRGB, bRGB

vec3 guideAtLow(int lx, int ly) {
    // Full-res guide sampled at this low pixel's footprint center.
    int gx = clamp(int((float(lx) + 0.5) * float(pc.fullW) / float(pc.lowW)), 0, pc.fullW - 1);
    int gy = clamp(int((float(ly) + 0.5) * float(pc.fullH) / float(pc.lowH)), 0, pc.fullH - 1);
    int gi = (gy * pc.fullW + gx) * 5;
    return vec3(guideData[gi], guideData[gi + 1], guideData[gi + 2]);
}

void main() {
    int lx = int(gl_GlobalInvocationID.x);
    int ly = int(gl_GlobalInvocationID.y);
    if (lx >= pc.lowW || ly >= pc.lowH) return;

    int cIdx = (ly * pc.lowW + lx) * 5;
    float invSamples = 1.0 / max(1.0, float(pc.samples));
    int   cObj   = int(pbrData[cIdx + 4]);
    float cDepth = pbrData[cIdx + 3] * invSamples;

    const int radius = 2;
    const float spatialSigma = 1.5;
    const float relativeDepthSigma = 0.1;
    // Regularizer: larger -> smoother a (less guide detail transferred where
    // the correlation is weak / noisy).
    const float EPS = 2e-3;

    float sumW = 0.0;
    vec3 sumG = vec3(0.0), sumP = vec3(0.0);
    vec3 sumGG = vec3(0.0), sumGP = vec3(0.0);

    for (int dy = -radius; dy <= radius; ++dy)
    for (int dx = -radius; dx <= radius; ++dx) {
        int nx = clamp(lx + dx, 0, pc.lowW - 1);
        int ny = clamp(ly + dy, 0, pc.lowH - 1);
        int nIdx = (ny * pc.lowW + nx) * 5;

        if (int(pbrData[nIdx + 4]) != cObj) continue;

        float nDepth = pbrData[nIdx + 3] * invSamples;
        float dz = abs(nDepth - cDepth) / max(cDepth, 0.1);
        if (cDepth > 999000.0 && nDepth > 999000.0) dz = 0.0;
        float wZ = exp(-(dz * dz) / (2.0 * relativeDepthSigma * relativeDepthSigma));
        float wS = exp(-float(dx * dx + dy * dy) / (2.0 * spatialSigma * spatialSigma));
        float w = wS * wZ;
        if (w < 1e-5) continue;

        vec3 g = guideAtLow(nx, ny);
        vec3 p = vec3(pbrData[nIdx], pbrData[nIdx + 1], pbrData[nIdx + 2]) * invSamples;

        sumW  += w;
        sumG  += g * w;
        sumP  += p * w;
        sumGG += g * g * w;
        sumGP += g * p * w;
    }

    vec3 a, b;
    if (sumW < 1e-4) {
        a = vec3(0.0);
        b = vec3(pbrData[cIdx], pbrData[cIdx + 1], pbrData[cIdx + 2]) * invSamples;
    } else {
        vec3 meanG = sumG / sumW;
        vec3 meanP = sumP / sumW;
        vec3 varG  = max(vec3(0.0), sumGG / sumW - meanG * meanG);
        vec3 covGP = sumGP / sumW - meanG * meanP;
        a = clamp(covGP / (varG + EPS), vec3(-4.0), vec3(4.0));
        b = meanP - a * meanG;
    }

    int oIdx = (ly * pc.lowW + lx) * 6;
    coeff[oIdx]     = a.r; coeff[oIdx + 1] = a.g; coeff[oIdx + 2] = a.b;
    coeff[oIdx + 3] = b.r; coeff[oIdx + 4] = b.g; coeff[oIdx + 5] = b.b;
}
