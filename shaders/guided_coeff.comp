#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#define BMFR_ORDER 1

#if BMFR_ORDER == 2
  #define BMFR_K 10
  #define BMFR_RADIUS 4
#else
  #define BMFR_K 7
  #define BMFR_RADIUS 3
#endif

const int COEFF_STRIDE = 24;
const int GBUF_STRIDE  = 8;

layout(push_constant) uniform Push {
    int lowW;
    int lowH;
    int fullW;
    int fullH;
    int samples;
} pc;

layout(std430, binding = 0) readonly buffer GuideBuf { float guideData[]; };
layout(std430, binding = 1) readonly buffer PBRBuf { float pbrData[]; };
layout(std430, binding = 2) writeonly buffer CoeffBuf { float coeff[]; };
layout(std430, binding = 3) readonly buffer GBuf { float gbuf[]; };

int fullIndexAtLow(int lx, int ly) {
    int gx = clamp(int((float(lx) + 0.5) * float(pc.fullW) / float(pc.lowW)), 0, pc.fullW - 1);
    int gy = clamp(int((float(ly) + 0.5) * float(pc.fullH) / float(pc.lowH)), 0, pc.fullH - 1);
    return gy * pc.fullW + gx;
}

vec3 guideAtLow(int lx, int ly) {
    int fi = fullIndexAtLow(lx, ly) * 5;
    return vec3(guideData[fi], guideData[fi + 1], guideData[fi + 2]);
}

vec3 normalAtLow(int lx, int ly) {
    int gi = fullIndexAtLow(lx, ly) * GBUF_STRIDE;
    return vec3(gbuf[gi + 3], gbuf[gi + 4], gbuf[gi + 5]);
}

void buildFeatures(vec3 g, vec3 n, out float phi[BMFR_K]) {
    phi[0] = 1.0;
    phi[1] = g.r;
    phi[2] = g.g;
    phi[3] = g.b;
#if BMFR_ORDER == 2
    phi[4] = g.r * g.r;
    phi[5] = g.g * g.g;
    phi[6] = g.b * g.b;
    phi[7] = n.x;
    phi[8] = n.y;
    phi[9] = n.z;
#else
    phi[4] = n.x;
    phi[5] = n.y;
    phi[6] = n.z;
#endif
}

void main() {
    int lx = int(gl_GlobalInvocationID.x);
    int ly = int(gl_GlobalInvocationID.y);
    if (lx >= pc.lowW || ly >= pc.lowH) return;

    int cIdx = (ly * pc.lowW + lx) * 5;
    float invSamples = 1.0 / max(1.0, float(pc.samples));
    int   cObj   = int(pbrData[cIdx + 4]);
    float cDepth = pbrData[cIdx + 3] * invSamples;

    const float spatialSigma = float(BMFR_RADIUS) * 0.6;
    const float relativeDepthSigma = 0.1;

    float sumW = 0.0;
    float meanPhi[BMFR_K];
    for (int k = 0; k < BMFR_K; ++k) meanPhi[k] = 0.0;
    vec3 meanP = vec3(0.0);

    for (int dy = -BMFR_RADIUS; dy <= BMFR_RADIUS; ++dy)
    for (int dx = -BMFR_RADIUS; dx <= BMFR_RADIUS; ++dx) {
        int nx = clamp(lx + dx, 0, pc.lowW - 1);
        int ny = clamp(ly + dy, 0, pc.lowH - 1);
        int nIdx = (ny * pc.lowW + nx) * 5;

        if (int(pbrData[nIdx + 4]) != cObj) continue;

        float nDepth = pbrData[nIdx + 3] * invSamples;
        float dz = abs(nDepth - cDepth) / max(cDepth, 0.1);
        if (cDepth > 999000.0 && nDepth > 999000.0) dz = 0.0;
        float wZ = exp(-(dz * dz) / (2.0 * relativeDepthSigma * relativeDepthSigma));
        float wS = exp(-float(dx * dx + dy * dy) / (2.0 * spatialSigma * spatialSigma));
        float w = wS * wZ;
        if (w < 1e-5) continue;

        float phi[BMFR_K];
        buildFeatures(guideAtLow(nx, ny), normalAtLow(nx, ny), phi);
        for (int k = 0; k < BMFR_K; ++k) meanPhi[k] += phi[k] * w;
        meanP += vec3(pbrData[nIdx], pbrData[nIdx + 1], pbrData[nIdx + 2]) * invSamples * w;
        sumW += w;
    }

    float theta[BMFR_K][3];
    for (int k = 0; k < BMFR_K; ++k) {
        theta[k][0] = 0.0;
        theta[k][1] = 0.0;
        theta[k][2] = 0.0;
    }

    if (sumW < 1e-4) {
        vec3 p = vec3(pbrData[cIdx], pbrData[cIdx + 1], pbrData[cIdx + 2]) * invSamples;
        theta[0][0] = p.r;
        theta[0][1] = p.g;
        theta[0][2] = p.b;
    } else {
        float invW = 1.0 / sumW;
        for (int k = 0; k < BMFR_K; ++k) meanPhi[k] *= invW;
        meanP *= invW;

        float A[BMFR_K][BMFR_K];
        float bvec[BMFR_K][3];
        for (int i = 0; i < BMFR_K; ++i) {
            for (int j = 0; j < BMFR_K; ++j) A[i][j] = 0.0;
            bvec[i][0] = 0.0;
            bvec[i][1] = 0.0;
            bvec[i][2] = 0.0;
        }

        for (int dy = -BMFR_RADIUS; dy <= BMFR_RADIUS; ++dy)
        for (int dx = -BMFR_RADIUS; dx <= BMFR_RADIUS; ++dx) {
            int nx = clamp(lx + dx, 0, pc.lowW - 1);
            int ny = clamp(ly + dy, 0, pc.lowH - 1);
            int nIdx = (ny * pc.lowW + nx) * 5;
            if (int(pbrData[nIdx + 4]) != cObj) continue;

            float nDepth = pbrData[nIdx + 3] * invSamples;
            float dz = abs(nDepth - cDepth) / max(cDepth, 0.1);
            if (cDepth > 999000.0 && nDepth > 999000.0) dz = 0.0;
            float wZ = exp(-(dz * dz) / (2.0 * relativeDepthSigma * relativeDepthSigma));
            float wS = exp(-float(dx * dx + dy * dy) / (2.0 * spatialSigma * spatialSigma));
            float w = wS * wZ;
            if (w < 1e-5) continue;

            float phi[BMFR_K];
            buildFeatures(guideAtLow(nx, ny), normalAtLow(nx, ny), phi);
            for (int k = 1; k < BMFR_K; ++k) phi[k] -= meanPhi[k];
            phi[0] = 1.0;

            vec3 pres = vec3(pbrData[nIdx], pbrData[nIdx + 1], pbrData[nIdx + 2]) * invSamples - meanP;

            for (int i = 0; i < BMFR_K; ++i) {
                float wpi = w * phi[i];
                for (int j = 0; j <= i; ++j) A[i][j] += wpi * phi[j];
                bvec[i][0] += wpi * pres.r;
                bvec[i][1] += wpi * pres.g;
                bvec[i][2] += wpi * pres.b;
            }
        }
        for (int i = 0; i < BMFR_K; ++i)
            for (int j = i + 1; j < BMFR_K; ++j) A[i][j] = A[j][i];

        float trace = 0.0;
        for (int i = 0; i < BMFR_K; ++i) trace += A[i][i];
        float ridge = max(trace / float(BMFR_K), 1e-8) * 1e-3;
        for (int i = 0; i < BMFR_K; ++i) A[i][i] += ridge;

        float L[BMFR_K][BMFR_K];
        for (int i = 0; i < BMFR_K; ++i)
            for (int j = 0; j < BMFR_K; ++j) L[i][j] = 0.0;

        bool ok = true;
        for (int i = 0; i < BMFR_K && ok; ++i) {
            for (int j = 0; j <= i; ++j) {
                float sum = A[i][j];
                for (int k = 0; k < j; ++k) sum -= L[i][k] * L[j][k];
                if (i == j) {
                    if (sum <= 1e-12) {
                        ok = false;
                        break;
                    }
                    L[i][i] = sqrt(sum);
                } else {
                    L[i][j] = sum / L[j][j];
                }
            }
        }

        if (!ok) {
            theta[0][0] = meanP.r;
            theta[0][1] = meanP.g;
             theta[0][2] = meanP.b;
        } else {
            for (int c = 0; c < 3; ++c) {
                float yv[BMFR_K];
                for (int i = 0; i < BMFR_K; ++i) {
                    float sum = bvec[i][c];
                    for (int k = 0; k < i; ++k) sum -= L[i][k] * yv[k];
                    yv[i] = sum / L[i][i];
                }
                for (int i = BMFR_K - 1; i >= 0; --i) {
                    float sum = yv[i];
                    for (int k = i + 1; k < BMFR_K; ++k) sum -= L[k][i] * theta[k][c];
                    theta[i][c] = sum / L[i][i];
                }
            }
            for (int c = 0; c < 3; ++c) {
                float t0 = theta[0][c] + meanP[c];
                for (int k = 1; k < BMFR_K; ++k) t0 -= theta[k][c] * meanPhi[k];
                theta[0][c] = t0;
            }
        }
    }

    int o = (ly * pc.lowW + lx) * COEFF_STRIDE;
    for (int k = 0; k < BMFR_K; ++k) {
        coeff[o + k * 3 + 0] = theta[k][0];
        coeff[o + k * 3 + 1] = theta[k][1];
        coeff[o + k * 3 + 2] = theta[k][2];
    }
    for (int k = BMFR_K * 3; k < COEFF_STRIDE; ++k) coeff[o + k] = 0.0;
}
