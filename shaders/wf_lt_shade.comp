#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#define WF_LIGHT_TRACE
#include "wf_common.glsl"

// Forward light-tracing shade stage.
//
// Identical surface sampling to wf_shade.comp, but the next-event estimation
// is replaced by a *camera connection*: at every non-specular interaction we
// try to connect the hit point to the pinhole camera. If the projection lands
// in frame and the camera side is lit, we evaluate the BSDF for the
// view direction and queue a shadow ray; wf_lt_shadow then tests occlusion and
// splats the contribution onto the projected pixel.
//
// The camera connection contribution is carried in the ShadowRay.contrib field
// the same way, but we encode the target pixel in dir_slot.w as a packed int
// (pixelIndex) and set lightPtIdx = -1 so the shadow shader knows it is a
// camera connection, not a light connection.

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= ctr.shadeCount) return;

    uint slot = shadeQueue[gid];
    PathHot p = pathsHot[slot];
    if ((p.i1.w & FLAG_ALIVE) == 0) return;

    vec3 origin = p.o_tmax.xyz;
    vec3 dir    = p.dir_rough.xyz;
    float pathRoughness = p.dir_rough.w;
    float remainingMaxDist = p.o_tmax.w;
    vec3 throughput = p.thp.xyz;

    uint rng  = p.u0.y;
    uint grng = p.u0.z;
    int bounce = PC_GET_BOUNCE(p.u0.w);
    int transp = PC_GET_TRANS(p.u0.w);
    int volum  = PC_GET_VOLUM(p.u0.w);
    int mediumObjId    = p.i1.x;
    int mediumVoxelIdx = p.i1.y;
    bool lastBounceSpecular = (p.i1.w & FLAG_SPECULAR) != 0;

    vec4 hitRec = pathsHit[slot].hit;
    float t = hitRec.x;
    int hitIndex = floatBitsToInt(hitRec.y);

    // Defensive: never index points[] with a stale/invalid hit record.
    if (hitIndex < 0 || hitIndex >= points.length()) {
        p.i1.w &= ~FLAG_ALIVE;
        pathsHot[slot] = p;
        pathsHit[slot].hit.z = -1.0;
        return;
    }

    remainingMaxDist -= t;

    GPUPBRRenderData hitData = points[hitIndex];
    vec3 invD = safe_invDir(dir);
    float tExit;
    vec3 normal;
    vec3 hitPoint;
    float tHit;
    rayCubeIntersect(origin, dir, invD, hitData, tHit, normal, hitPoint, tExit);

    // The shading normal must face back toward where the light came from (the
    // lit hemisphere = against the incoming ray). rayCubeIntersect's raw normal
    // is not reliably outward-oriented for these voxels, so derive the real
    // entering/exiting state from the ray vs the forced-outward normal.
    bool frontFace = (dot(dir, normal) <= 0.0);
    vec3 outwardNormal = frontFace ? normal : -normal; // faces against the ray
    vec3 offsetNorm = outwardNormal;
    // entering == 1 when the ray is going INTO the surface from outside.
    int entering = frontFace ? 1 : 0;
    bool isMedGas = hitData.isGas != 0;
    bool isTransmissionInteraction = false;
    // DEBUG: count paths that reached shade, and those facing the lit side.
    dbgInc(1u);
    dbgInc(2u); // every front-face hit is camera-connectable; gate is on geometry below

    if (mediumObjId != -1) {
        vec3 segAbs = unpackRGB8(materials[hitData.materialIdx].absorption);
        throughput *= exp(-segAbs * t);
    }

    bool skipSurface = false;
    if (mediumObjId != -1 && hitData.objectId == mediumObjId) {
        if (entering == 1) {
            skipSurface = true;
            mediumVoxelIdx = hitIndex;
        } else {
            int nextVoxelIdx = getMediumVoxelAt(hitPoint, normal, mediumObjId, hitIndex);
            if (nextVoxelIdx != -1) {
                skipSurface = true;
                mediumVoxelIdx = nextVoxelIdx;
            }
        }
    }

    bool continuePath = true;

    if (skipSurface) {
        origin = hitPoint + dir * (DIST_EPSILON * 4.0);
    } else if (isMedGas) {
        if (entering == 1) {
            mediumObjId = hitData.objectId;
            mediumVoxelIdx = hitIndex;
        } else {
            mediumObjId = -1;
            mediumVoxelIdx = -1;
        }
        origin = hitPoint + dir * (DIST_EPSILON * 4.0);
        transp++;
    } else {
        GPUMaterial surfaceMat = materials[hitData.materialIdx];
        vec4 albedo = unpackRGBA8(hitData.color);
        float opacity = albedo.a;
        float transmission = 1.0 - opacity;
        float roughness, metallic;
        uint sellRow;
        unpackMaterial(surfaceMat.materialProps, roughness, metallic, sellRow);

        int hero = GET_HERO(p.i1.w);
        float lambda = heroLambda(hero == 0 ? 2 : hero);
        float ior = sampleIor(sellRow, lambda);

        roughness = max(roughness, pathRoughness);
        pathRoughness = max(pathRoughness, roughness);

        vec3 F0 = mix(vec3(0.04), albedo.rgb, metallic);

        // Russian roulette (same as backward path tracer).
        if (bounce > 3) {
            float thpLum = dot(throughput, vec3(0.2126, 0.7152, 0.0722));
            float continueProb = clamp(thpLum, 0.05, 0.95);
            if (nextFloat(grng) > continueProb) {
                p.thp.xyz = throughput;
                p.u0.y = rng;
                p.u0.z = grng;
                p.i1.w &= ~FLAG_ALIVE;
                pathsHot[slot] = p;
                pathsHit[slot].hit.z = -1.0;
                return;
            }
            throughput /= continueProb;
        }

        vec3 V = -dir; // direction back along the incoming light ray
        float eta = (entering == 1) ? (1.0 / ior) : ior;
        float alpha = max(1e-5, roughness * roughness);
        float alpha2 = alpha * alpha;
        float NdotV = max(1e-4, dot(offsetNorm, V));

        vec3 Fv = F0 + (vec3(1.0) - F0) * pow(1.0 - NdotV, 5.0);
        float pspec = clamp(dot(Fv, vec3(0.333333)), 0.04, 0.96);
        float pdiff = (1.0 - metallic) * opacity * (1.0 - pspec);
        float pTrans = (1.0 - metallic) * transmission * (1.0 - pspec);
        {
            float sump = pspec + pdiff + pTrans;
            if (sump <= 1e-5) { pspec = 1.0; pdiff = 0.0; pTrans = 0.0; }
            else { float ins = 1.0 / sump; pspec *= ins; pdiff *= ins; pTrans *= ins; }
        }

        // ---- CAMERA CONNECTION (replaces light NEE) ----
        // Connect whenever the surface has a non-delta lobe. The NdotLc check
        // below ensures the camera is actually on the lit side.
        bool connectable = (pdiff + pspec) > 0.001;
        if (connectable) {
            ivec2 pix;
            float camDist;
            vec3 Lc; // direction from hit point toward camera
            if (projectToCamera(hitPoint, pix, camDist, Lc)) {
                float NdotLc = dot(offsetNorm, Lc);
                if (NdotLc > 0.0) {
                    // Evaluate BSDF for (incoming light dir = -dir) -> (out toward camera = Lc).
                    vec3 Hc = normalize(V + Lc);
                    float NdotH = max(0.0, dot(offsetNorm, Hc));
                    float VdotH = max(0.0, dot(V, Hc));
                    vec3 Fc = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH), 5.0);
                    vec3 diffuseBRDF = albedo.rgb * (vec3(1.0) - Fc) / PI;
                    float Dn = ggxD(NdotH, alpha2);
                    float Gn = smith(NdotV, alpha2) * smith(NdotLc, alpha2);
                    vec3 specBRDF = Fc * (Dn * Gn / max(1e-5, 4.0 * NdotV * NdotLc));
                    vec3 evalBRDF = diffuseBRDF * opacity * (1.0 - metallic) + specBRDF;

                    // Pinhole importance: the camera response falls off with the
                    // angle to the view axis. W_e ~ 1 / (cos^4 theta) for a flat
                    // sensor; here we approximate with the geometry term to the
                    // pinhole. cosCam = angle between view axis and connection.
                    vec3 fwd = normalize(cam.dir);
                    float cosCam = dot(fwd, -Lc); // -Lc points camera->hit
                    float G = 0.0;
                    if (cosCam > 1e-4) {
                        // 1/dist^2 geometry, with cosCam^4 pinhole weighting.
                        float c2 = cosCam * cosCam;
                        G = (c2 * c2) / max(1e-6, camDist * camDist);
                    }

                    vec3 contrib = throughput * evalBRDF * NdotLc * G;

                    if (any(greaterThan(contrib, vec3(0.0)))) {
                        uint pixelIndex = uint(pix.y) * uint(cam.width) + uint(pix.x);
                        vec3 shadowOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                        float shadowMaxDist = camDist - DIST_EPSILON * 2.0;

                        ShadowRay sr;
                        sr.o_tmax   = vec4(shadowOrigin, shadowMaxDist);
                        sr.dir_slot = vec4(Lc, intBitsToFloat(int(pixelIndex)));
                        // lightPtIdx = -1 signals "camera connection" to wf_lt_shadow.
                        sr.contrib  = vec4(contrib, intBitsToFloat(-1));
                        sr.thp      = vec4(1.0, 0.0, 0.0, 0.0);
                        uint si = atomicAdd(ctr.shadowCount, 1u);
                        shadowQueue[si] = sr;
                        // DEBUG: count attempted connections.
                        dbgInc(3u);
                    }
                }
            }
        }

        // ---- BSDF sampling for the continuing light path (same as backward) ----
        float r1 = nextFloat(rng);
        float r2 = nextFloat(rng);
        float phi = 2.0 * PI * r1;
        float cosThetaM = sqrt(max(0.0, (1.0 - r2) / (1.0 + (alpha2 - 1.0) * r2)));
        float sinThetaM = sqrt(max(0.0, 1.0 - cosThetaM * cosThetaM));
        vec3 up = abs(offsetNorm.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
        vec3 tangent = normalize(cross(up, offsetNorm));
        vec3 bitangent = cross(offsetNorm, tangent);
        vec3 H = normalize(tangent * sinThetaM * cos(phi) + bitangent * sinThetaM * sin(phi) + offsetNorm * cosThetaM);
        float VdotH = dot(V, H);
        if (VdotH < 0.0) { H = -H; VdotH = -VdotH; }
        vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - min(1.0, VdotH), 5.0);

        float r_type = nextFloat(grng);
        vec3 newDir, newOrigin, weight = vec3(0.0);
        isTransmissionInteraction = false;

        if (r_type < pspec) {
            newDir = normalize(2.0 * VdotH * H - V);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            float NDotL = dot(offsetNorm, newDir);
            float NDotH = max(1e-5, dot(offsetNorm, H));
            if (NDotL > 0.0) {
                float G = smith(NdotV, alpha2) * smith(NDotL, alpha2);
                weight = F * (G * VdotH / (NdotV * NDotH * pspec));
            }
            lastBounceSpecular = true;
        } else if (r_type < pspec + pdiff) {
            float r3 = nextFloat(rng), r4 = nextFloat(rng);
            float Phid = 2.0 * PI * r3, rD = sqrt(r4);
            vec3 L_local = vec3(rD * cos(Phid), rD * sin(Phid), sqrt(max(0.0, 1.0 - r4)));
            newDir = normalize(tangent * L_local.x + bitangent * L_local.y + offsetNorm * L_local.z);
            newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
            weight = albedo.rgb * (vec3(1.0) - F) / pdiff;
            lastBounceSpecular = false;
        } else {
            isTransmissionInteraction = true;
            int curHero = hero;
            vec3 dispersionMask = vec3(1.0);
            if (curHero == 0) {
                curHero = clamp(int(nextFloat(grng) * 3.0) + 1, 1, 3);
                dispersionMask = heroMask(curHero) * 3.0;
                p.i1.w = SET_HERO(p.i1.w, curHero);
            }
            { float lh = heroLambda(curHero); float iorH = sampleIor(sellRow, lh);
              eta = (entering == 1) ? (1.0 / iorH) : iorH; }

            float NDotH = dot(offsetNorm, H);
            float sinThetaT2 = eta * eta * (1.0 - VdotH * VdotH);
            if (sinThetaT2 >= 1.0 || NDotH <= 1e-4) {
                newDir = normalize(2.0 * VdotH * H - V);
                newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                float NDotL = dot(offsetNorm, newDir);
                if (NDotL > 0.0) {
                    float G = smith(NdotV, alpha2) * smith(NDotL, alpha2);
                    weight = dispersionMask * (G * VdotH / (NdotV * NDotH * pTrans));
                }
            } else {
                vec3 L = refract(-V, H, eta);
                if (dot(L, L) < 1e-8) {
                    newDir = normalize(2.0 * VdotH * H - V);
                    newOrigin = hitPoint + offsetNorm * DIST_EPSILON;
                } else {
                    newDir = normalize(L);
                    newOrigin = hitPoint - offsetNorm * DIST_EPSILON;
                    float LdotH = dot(newDir, H);
                    float NdotL = abs(dot(offsetNorm, newDir));
                    if (NdotL > 1e-4) {
                        float G = smith(NdotV, alpha2) * smith(NdotL, alpha2);
                        float denom = eta * VdotH + LdotH;
                        float jac = (abs(VdotH) * abs(LdotH)) / max(1e-6, denom * denom);
                        weight = (vec3(1.0) - F) * dispersionMask * (G * jac / max(1e-5, NdotV * NDotH * pTrans));
                    }
                    if (entering == 1) { mediumObjId = hitData.objectId; mediumVoxelIdx = hitIndex; }
                    else { mediumObjId = -1; mediumVoxelIdx = -1; }
                }
            }
            lastBounceSpecular = true;
        }

        if (bounce > 0 || transp > 0) {
            float lumW = dot(weight, vec3(0.2126, 0.7152, 0.0722));
            if (lumW > 2.0) weight *= 2.0 / lumW;
        } else {
            weight = min(weight, vec3(4.0));
        }
        throughput *= weight;
        if (max(max(throughput.x, throughput.y), throughput.z) < 0.01) {
            p.thp.xyz = throughput;
            p.u0.y = rng;
            p.u0.z = grng;
            p.i1.w &= ~FLAG_ALIVE;
            pathsHot[slot] = p;
            pathsHit[slot].hit.z = -1.0;
            return;
        }
        origin = newOrigin;
        dir = newDir;
        if (isTransmissionInteraction) {
            transp++;
            if (transp % 4 == 0) bounce++;
        } else bounce++;
    }

    if (bounce > cam.maxBounces || transp >= MAX_TRANSPARENT_BOUNCES || volum >= MAX_VOLUMETRIC_BOUNCES)
        continuePath = false;

    p.o_tmax = vec4(origin, remainingMaxDist);
    p.dir_rough = vec4(dir, pathRoughness);
    p.thp.xyz = throughput;
    p.u0.y = rng;
    p.u0.z = grng;
    p.u0.w = PC_PACK(bounce, transp, volum);
    p.i1.x = mediumObjId;
    p.i1.y = mediumVoxelIdx;
    p.i1.w = (p.i1.w & ~FLAG_SPECULAR) | (lastBounceSpecular ? FLAG_SPECULAR : 0);
    p.i1.w &= ~FLAG_HITFOUND;

    if (!continuePath) p.i1.w &= ~FLAG_ALIVE;
    pathsHot[slot] = p;
    pathsHit[slot].hit.z = -1.0;

    if (continuePath) {
        if (!isTransmissionInteraction) pathRoughness = min(pathRoughness + 0.15, 1.0);
        uint q = atomicAdd(ctr.nextExtendCount, 1u);
        if (pc.parity == 0) extendB[q] = slot;
        else extendA[q] = slot;
    }
}
