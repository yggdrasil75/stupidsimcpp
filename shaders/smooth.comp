#version 450
layout(local_size_x = 16, local_size_y = 16) in;
#define SMOOTH_USE_NORMAL_WEIGHT 1
#define SMOOTH_NORMAL_POWER 24.0

layout(push_constant) uniform Push {
    int width;
    int height;
    int samples;
    int stepSize;
    int finalPass;
    int useAlbedo;
    int varMode;
    int feedbackHist;
} pc;

layout(std430, binding = 0) readonly buffer InBuf { float inData[]; };
layout(std430, binding = 1) writeonly buffer OutBuf { float outData[]; };
layout(std430, binding = 2) readonly buffer VarBuf { float varData[]; };
layout(std430, binding = 3) readonly buffer GBuf { float gbuf[]; };
layout(std430, binding = 4) readonly buffer VarIn { float varIn[]; };
layout(std430, binding = 5) writeonly buffer VarOut { float varOut[]; };
layout(std430, binding = 6) buffer HistBuf { float hist[]; };

const int GBUF_STRIDE = 8;
const int HIST_STRIDE = 12;

float lum(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

const float H[5] = float[5](0.0625, 0.25, 0.375, 0.25, 0.0625);

vec3 demodAlbedo(int px, int py) {
    if (pc.useAlbedo == 0) return vec3(1.0);
    int gi = (py * pc.width + px) * GBUF_STRIDE;
    if (gi + GBUF_STRIDE > gbuf.length()) return vec3(1.0);
    return max(vec3(gbuf[gi], gbuf[gi + 1], gbuf[gi + 2]), vec3(0.02));
}

vec3 gbufNormal(int px, int py) {
    int gi = (py * pc.width + px) * GBUF_STRIDE;
    if (pc.useAlbedo == 0 || gi + GBUF_STRIDE > gbuf.length()) return vec3(0.0);
    return vec3(gbuf[gi + 3], gbuf[gi + 4], gbuf[gi + 5]);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int centerIdx = (y * pc.width + x) * 5;
    bool firstIter = (pc.stepSize == 1);
    float invSamples = firstIter ? 1.0 / max(1.0, float(pc.samples)) : 1.0;

    vec3 cAlb = demodAlbedo(x, y);
    vec3 invAlbC = vec3(1.0) / cAlb;

    vec3 cColor = vec3(inData[centerIdx], inData[centerIdx + 1], inData[centerIdx + 2]) * invSamples * invAlbC;
    float cDepth = inData[centerIdx + 3] * invSamples;
    float cObj   = inData[centerIdx + 4];
#if SMOOTH_USE_NORMAL_WEIGHT
    vec3 cNrm = gbufNormal(x, y);
#endif

    int pIdx = y * pc.width + x;

    float blurredVar = -1.0;
    if (pc.varMode == 1) {
#if SMOOTH_USE_NORMAL_WEIGHT
        vec3 preNrm = gbufNormal(x, y);
#endif
        float vSum = 0.0;
        float vW   = 0.0;
        for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            int nx = clamp(x + dx, 0, pc.width - 1);
            int ny = clamp(y + dy, 0, pc.height - 1);
            int nPIdx = ny * pc.width + nx;
            if (inData[nPIdx * 5 + 4] != cObj) continue;
            float gk = H[dx + 2] * H[dy + 2]; // separable 1-2-1 -> 2D Gaussian
#if SMOOTH_USE_NORMAL_WEIGHT
            gk *= pow(max(0.0, dot(preNrm, gbufNormal(nx, ny))), SMOOTH_NORMAL_POWER);
#endif
            vSum += max(0.0, varIn[nPIdx]) * gk;
            vW   += gk;
        }
        blurredVar = (vW > 1e-6) ? vSum / vW : max(0.0, varIn[pIdx]);
    }

    float cVar;
    if (pc.varMode == 1) {
        cVar = max(0.0, varIn[pIdx]);
    } else {
        int vIdx = pIdx * 5;
        float req  = varData[vIdx + 2];
        float n    = (req < 0.0) ? -req : max(1.0, float(pc.samples));
        float mean = varData[vIdx] / n;
        float var  = max(0.0, varData[vIdx + 1] / n - mean * mean);
        float albL = max(lum(cAlb), 1e-3);
        cVar = (var / n) / (albL * albL) / float(pc.stepSize);
    }
    float sigmaVar = (blurredVar >= 0.0) ? blurredVar : cVar;
    float stdErr = sqrt(sigmaVar);

    if (firstIter && pc.varMode == 0) {
        vec3 localAvg = vec3(0.0);
        float localW = 0.0;
        for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            int nx = clamp(x + dx, 0, pc.width - 1);
            int ny = clamp(y + dy, 0, pc.height - 1);
            int nIdx = (ny * pc.width + nx) * 5;
            if (inData[nIdx + 4] == cObj && !(dx == 0 && dy == 0)) {
                localAvg += vec3(inData[nIdx], inData[nIdx + 1], inData[nIdx + 2])
                          * invSamples / demodAlbedo(nx, ny);
                localW += 1.0;
            }
        }
        if (localW > 0.0) {
            localAvg /= localW;
            float maxLum = lum(localAvg) * 3.0 + 0.1;
            float cl = lum(cColor);
            if (cl > maxLum) cColor *= maxLum / max(cl, 1e-4);
        }
    }

    float cLum = lum(cColor);
    float lumSigma = 4.0 * stdErr + 1e-3;

    vec3 sumC = vec3(0.0);
    float sumV = 0.0;
    float sumW = 0.0;

    for (int j = -2; j <= 2; ++j)
    for (int i = -2; i <= 2; ++i) {
        int nx = clamp(x + i * pc.stepSize, 0, pc.width - 1);
        int ny = clamp(y + j * pc.stepSize, 0, pc.height - 1);
        int nIdx = (ny * pc.width + nx) * 5;

        vec3 invAlbN = vec3(1.0) / demodAlbedo(nx, ny);
        vec3 nColor = vec3(inData[nIdx], inData[nIdx + 1], inData[nIdx + 2]) * invSamples * invAlbN;
        float nDepth = inData[nIdx + 3] * invSamples;
        float nObj   = inData[nIdx + 4];

        float wKernel = H[i + 2] * H[j + 2];
        float wObj = (nObj == cObj) ? 1.0 : 0.0;

        float dz = abs(nDepth - cDepth) / max(cDepth, 0.1);
        if (cDepth > 999000.0 && nDepth > 999000.0) dz = 0.0;
        float wZ = exp(-(dz * dz) / (2.0 * 0.05 * 0.05));

        float dl = abs(lum(nColor) - cLum);
        float wL = exp(-dl / lumSigma);

        float w = wKernel * wObj * wZ * wL;
#if SMOOTH_USE_NORMAL_WEIGHT
        w *= pow(max(0.0, dot(cNrm, gbufNormal(nx, ny))), SMOOTH_NORMAL_POWER);
#endif
        if (i == 0 && j == 0) {
            nColor = cColor;
            w = wKernel;
        }

        sumC += nColor * w;
        sumV += ((pc.varMode == 1) ? max(0.0, varIn[ny * pc.width + nx]) : cVar) * w * w;
        sumW += w;
    }

    float invW = 1.0 / max(sumW, 1e-6);
    vec3 filtered = sumC * invW;
    vec3 result = filtered * cAlb;

    float propVar = sumV * invW * invW;
    if (pc.varMode == 1 && blurredVar >= 0.0) {
        propVar = max(propVar, 0.25 * blurredVar);
    }
    varOut[pIdx] = propVar;

    if (pc.feedbackHist == 1) {
        int hIdx = pIdx * HIST_STRIDE;
        hist[hIdx]     = filtered.r;
        hist[hIdx + 1] = filtered.g;
        hist[hIdx + 2] = filtered.b;
    }

    if (pc.finalPass == 1) {
        int outIdx = (y * pc.width + x) * 3;
        outData[outIdx]     = clamp(result.r, 0.0, 1.0);
        outData[outIdx + 1] = clamp(result.g, 0.0, 1.0);
        outData[outIdx + 2] = clamp(result.b, 0.0, 1.0);
    } else {
        int outIdx = (y * pc.width + x) * 5;
        outData[outIdx]     = result.r;
        outData[outIdx + 1] = result.g;
        outData[outIdx + 2] = result.b;
        outData[outIdx + 3] = cDepth;
        outData[outIdx + 4] = cObj;
    }
}
