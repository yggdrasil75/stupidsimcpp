#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push {
    int width;
    int height;
    int samples;
} pc;

layout(std430, binding = 0) readonly buffer InBuf { float inData[]; };
layout(std430, binding = 1) writeonly buffer OutBuf { float outData[]; };

float getLuminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int centerIdx = (y * pc.width + x) * 5;
    float invSamples = 1.0 / max(1.0, float(pc.samples));
    
    vec3 centerColor = vec3(inData[centerIdx], inData[centerIdx + 1], inData[centerIdx + 2]) * invSamples;
    float centerDepth = inData[centerIdx + 3] * invSamples;
    int centerObj = int(inData[centerIdx + 4]);

    vec3 localAvg = vec3(0.0);
    float localW = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            int nx = clamp(x + dx, 0, pc.width - 1);
            int ny = clamp(y + dy, 0, pc.height - 1);
            int nIdx = (ny * pc.width + nx) * 5;
            
            // Only aggregate same-object pixels for accurate background color
            if (int(inData[nIdx + 4]) == centerObj) {
                localAvg += vec3(inData[nIdx], inData[nIdx + 1], inData[nIdx + 2]) * invSamples;
                localW += 1.0;
            }
        }
    }
    localAvg /= max(1.0, localW);
    
    float lLum = getLuminance(localAvg);
    float cLum = getLuminance(centerColor);
    
    float maxAllowedLum = lLum * 3.0 + 0.1;
    if (cLum > maxAllowedLum) {
        centerColor = localAvg; // Override the center firefly entirely
    }
    float sumWeights = 0.0;
    vec3 sumColor = vec3(0.0);

    int radius = 2;
    float spatialSigma = 2.0;
    float depthSigma = 1.0;

    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            int nx = clamp(x + dx, 0, pc.width - 1);
            int ny = clamp(y + dy, 0, pc.height - 1);
            int nIdx = (ny * pc.width + nx) * 5;
            
            vec3 nColor = vec3(inData[nIdx], inData[nIdx + 1], inData[nIdx + 2]) * invSamples;
            float nDepth = inData[nIdx + 3] * invSamples;
            int nObj = int(inData[nIdx + 4]);
            
            float spatialDistSq = float(dx*dx + dy*dy);
            float spatialWeight = exp(-spatialDistSq / (2.0 * spatialSigma * spatialSigma));
            
            float depthDiff = nDepth - centerDepth;
            float depthWeight = exp(-(depthDiff * depthDiff) / (2.0 * depthSigma * depthSigma));
            
            float objWeight = (centerObj == nObj) ? 1.0 : 0.05;
            float nLum = getLuminance(nColor);
            if (dx == 0 && dy == 0) {
                nColor = centerColor; // Use clamped center
            } else if (nLum > maxAllowedLum && nObj == centerObj) {
                // If the neighbor is a firefly, forcibly dim it down to local tolerance bounds
                nColor *= maxAllowedLum / max(nLum, 0.001);
            }

            float weight = spatialWeight * depthWeight * objWeight;
            sumWeights += weight;
            sumColor += nColor * weight;
        }
    }
    
    int outIdx = (y * pc.width + x) * 3;
    outData[outIdx]     = clamp(sumColor.r / sumWeights, 0.0, 1.0);
    outData[outIdx + 1] = clamp(sumColor.g / sumWeights, 0.0, 1.0);
    outData[outIdx + 2] = clamp(sumColor.b / sumWeights, 0.0, 1.0);
}