#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 256) in;

struct Particle {
    vec4 pos_mass;
    vec4 vel_density;
    vec4 force_press;
    ivec4 type_pad;
};

struct AABB {
    float minX, minY, minZ;
    float maxX, maxY, maxZ;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(binding = 1) uniform accelerationStructureEXT tlas;

layout(std430, binding = 2) buffer AABBBuffer {
    AABB aabbs[];
};

layout(push_constant) uniform PushConstants {
    float dt;
    float velocityDamping;
    uint numParticles;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) return;

    uint type = particles[i].type_pad.x;
    if (type == 0 || type == 1) return; // Skip Static and Kinematic

    vec3 pos = particles[i].pos_mass.xyz;
    vec3 vel = particles[i].vel_density.xyz;
    vec3 force = particles[i].force_press.xyz;
    float mass = particles[i].pos_mass.w;
    float size = intBitsToFloat(particles[i].type_pad.y);

    vec3 accel = force / mass;
    if (dot(accel, accel) > 2500000000.0) accel = normalize(accel) * 50000.0;
    
    vel += accel * pc.dt;
    vel *= max(0.0, 1.0 - pc.velocityDamping * pc.dt);
    
    float velLen = length(vel);
    if (velLen > 50.0) {
        vel = (vel / velLen) * 50.0;
        velLen = 50.0;
    }

    float stepDist = velLen * pc.dt;
    vec3 dir = (velLen > 0.0001) ? (vel / velLen) : vec3(0.0, -1.0, 0.0);
    float pullback = size * 1.5;
    vec3 rayOrigin = pos - dir * pullback;
    float castDist = stepDist + (size * 0.51) + pullback;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, rayOrigin, 0.0, dir, castDist);
    
    while(rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            float candidate_t = rayQueryGetIntersectionTEXT(rq, false);
            rayQueryGenerateIntersectionEXT(rq, candidate_t);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        float t = rayQueryGetIntersectionTEXT(rq, true);
        int primitiveId = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);

        vec3 hitPoint = rayOrigin + dir * t;
        
        // Calculate normal based on the AABB we hit
        AABB box = aabbs[primitiveId];
        vec3 center = vec3(box.minX + box.maxX, box.minY + box.maxY, box.minZ + box.maxZ) * 0.5;
        vec3 halfSize = vec3(box.maxX - box.minX, box.maxY - box.minY, box.maxZ - box.minZ) * 0.5;
        
        vec3 normal = vec3(0.0);
        vec3 dAbs = abs((hitPoint - center) / halfSize);
        if (dAbs.x > dAbs.y && dAbs.x > dAbs.z) {
            normal.x = sign(hitPoint.x - center.x);
        } else if (dAbs.y > dAbs.z) {
            normal.y = sign(hitPoint.y - center.y);
        } else {
            normal.z = sign(hitPoint.z - center.z);
        }

        pos = hitPoint + normal * (size * 0.51); 
        
        float restitution = 0.3;
        vec3 vNorm = dot(vel, normal) * normal;
        vec3 vTan = vel - vNorm;
        vel = (vTan * 0.8) - (vNorm * restitution);
    } else {
        pos += vel * pc.dt;
    }

    float boundLimit = 9.8;
    if (pos.x < -boundLimit || pos.x > boundLimit) {
        pos.x = clamp(pos.x, -boundLimit, boundLimit);
        vel.x *= -0.3;
    }
    if (pos.y < -boundLimit || pos.y > boundLimit) {
        pos.y = clamp(pos.y, -boundLimit, boundLimit);
        vel.y *= -0.3;
    }
    if (pos.z < -boundLimit || pos.z > boundLimit) {
        pos.z = clamp(pos.z, -boundLimit, boundLimit);
        vel.z *= -0.3;
    }


    particles[i].pos_mass.xyz = pos;
    particles[i].vel_density.xyz = vel;
}