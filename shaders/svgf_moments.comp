
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;

#include "svgf_common.glsl"

layout(push_constant) uniform Push {
    int width;
    int height;
    float phiNormal;
    float phiDepth;
    float histThreshold;
} pc;

layout(std430, binding = 0) readonly buffer ColIn { float colIn[]; };
layout(std430, binding = 1) writeonly buffer ColOut { float colOut[]; };
layout(std430, binding = 2) readonly buffer HistBuf { float hist[]; };
layout(std430, binding = 3) readonly buffer GBuf { float gbuf[]; };
layout(std430, binding = 4) readonly buffer VarIn { float varIn[]; };
layout(std430, binding = 5) writeonly buffer VarOut { float varOut[]; };

vec3 gbufNormal(int idx) {
    int gi = idx * GBUF_STRIDE;
    return vec3(gbuf[gi + 3], gbuf[gi + 4], gbuf[gi + 5]);
}

vec3 gbufAlbedo(int idx) {
    int gi = idx * GBUF_STRIDE;
    return svgfAlbedoFloor(vec3(gbuf[gi], gbuf[gi + 1], gbuf[gi + 2]));
}

float gbufRoughness(int idx) {
    int gi = idx * GBUF_STRIDE;
    return svgfRoughness(gbuf[gi + 6]);
}

vec3 irradianceAt(int idx) {
    int pi = idx * PIX_STRIDE;
    return max(vec3(colIn[pi], colIn[pi + 1], colIn[pi + 2]), vec3(0.0)) / gbufAlbedo(idx);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int idx = y * pc.width + x;
    int pi  = idx * PIX_STRIDE;

    float cDepth = colIn[pi + 3];
    float cObj   = colIn[pi + 4];

    if (hist[idx * HIST_STRIDE + 5] >= pc.histThreshold) {
        colOut[pi]     = colIn[pi];
        colOut[pi + 1] = colIn[pi + 1];
        colOut[pi + 2] = colIn[pi + 2];
        colOut[pi + 3] = cDepth;
        colOut[pi + 4] = cObj;
        varOut[idx]    = varIn[idx];
        return;
    }

    float histLen = hist[idx * HIST_STRIDE + 5];
    vec3  cNrm = gbufNormal(idx);
    float cRough = gbufRoughness(idx);
    float phiNormalEff = svgfIsGlossy(cRough) ? pc.phiNormal * mix(4.0, 1.0, clamp(cRough / 0.30, 0.0, 1.0)) : pc.phiNormal;

    vec3  sumC = vec3(0.0);
    float sumM1 = 0.0, sumM2 = 0.0, sumW = 0.0;

    for (int dy = -3; dy <= 3; ++dy)
    for (int dx = -3; dx <= 3; ++dx) {
        int nx = x + dx;
        int ny = y + dy;
        if (nx < 0 || ny < 0 || nx >= pc.width || ny >= pc.height) continue;
        int nIdx = ny * pc.width + nx;
        if (colIn[nIdx * PIX_STRIDE + 4] != cObj) continue;

        float nDepth = colIn[nIdx * PIX_STRIDE + 3];
        float dz = 0.0;
        if (!(svgfIsSky(cDepth) && svgfIsSky(nDepth))) {
            float span = pc.phiDepth * float(max(abs(dx), abs(dy))) * max(cDepth, 0.1);
            dz = abs(nDepth - cDepth) / max(span, 1e-3);
        }
        float w = exp(-dz) * pow(max(0.0, dot(cNrm, gbufNormal(nIdx))), phiNormalEff);
        if (w <= 0.0) continue;

        vec3 nColor = irradianceAt(nIdx);
        float l = svgfLum(nColor);
        sumC += nColor * w;
        sumM1 += l * w;
        sumM2 += l * l * w;
        sumW += w;
    }

    if (sumW <= 1e-6) {
        colOut[pi] = colIn[pi];
        colOut[pi + 1] = colIn[pi + 1];
        colOut[pi + 2] = colIn[pi + 2];
        colOut[pi + 3] = cDepth;
        colOut[pi + 4] = cObj;
        varOut[idx] = max(varIn[idx], 1.0);
        return;
    }

    float inv = 1.0 / sumW;
    vec3  color = sumC * inv;
    float m1 = sumM1 * inv;
    float m2 = sumM2 * inv;
    float variance = max(0.0, m2 - m1 * m1) * (pc.histThreshold / max(histLen, 1.0));

    vec3 modulated = color * gbufAlbedo(idx);
    colOut[pi] = modulated.r;
    colOut[pi + 1] = modulated.g;
    colOut[pi + 2] = modulated.b;
    colOut[pi + 3] = cDepth;
    colOut[pi + 4] = cObj;
    varOut[idx] = max(variance, varIn[idx]);
}
