#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

#define PI 3.14159265359
const float EPS = 1e-8;
const float LARGE = 1e30;

struct GPUFastRenderData {
    vec3 position;
    float size;
    uint color;
    uint materialIdx;
    int objectId;
    uint isGas;
};

struct GPUMaterial {
    float emittance;
    uint materialProps;
    uint absorption;
    uint padding;
};

layout(std430, binding = 1) readonly buffer PointBuffer { GPUFastRenderData points[]; };
layout(std430, binding = 2) writeonly buffer OutputBuffer { float pixels[]; };

layout(binding = 3) uniform CameraData {
    vec3 origin;
    float lodMinDist;
    vec3 dir;
    float invLodf;
    vec3 up;
    float minVisibility;
    vec3 right;
    float maxDist;
    vec3 skylight;
    float tanfovx;
    vec3 bgColor;
    float tanfovy;
    int width;
    int height;
    int maxBounces;
    int useLod;
    float invFogRange;
    uint frameCount;
    int skyWidth;
    int skyHeight;
    int currentSampleOffset;
    int dispatchSamples;
    int globalIllumination;
    uint nodeCount;
    uint pointCount;
    int tileOffsetX;
    int tileOffsetY;
    int emissiveCount;
    int targetSamples;
} cam;

layout(std430, binding = 4) readonly buffer SkyboxBuffer { vec4 skyPixels[]; };
layout(binding = 6) uniform accelerationStructureEXT tlas;
layout(std430, binding = 8) readonly buffer MaterialBuffer { GPUMaterial materials[]; };

vec3 unpackRGB8(uint c) {
    return vec3(float(c & 0xFF) / 255.0, float((c >> 8) & 0xFF) / 255.0, float((c >> 16) & 0xFF) / 255.0);
}

vec3 safe_invDir(vec3 d) {
    return vec3(
        abs(d.x) < EPS ? (d.x < 0.0 ? -LARGE : LARGE) : 1.0 / d.x,
        abs(d.y) < EPS ? (d.y < 0.0 ? -LARGE : LARGE) : 1.0 / d.y,
        abs(d.z) < EPS ? (d.z < 0.0 ? -LARGE : LARGE) : 1.0 / d.z
    );
}

struct Ray {
    vec3 origin;
    vec3 dir;
    vec3 invDir;
};

Ray makeRay(vec3 o, vec3 d) {
    Ray r;
    r.origin = o;
    r.dir = d;
    r.invDir = safe_invDir(d);
    return r;
}

bool rayBoxIntersect(Ray ray, vec3 bMin, vec3 bMax, out float tMin, out float tMax) {
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    vec3 tsmall = min(t0, t1);
    vec3 tbig = max(t0, t1);
    tMin = max(max(tsmall.x, tsmall.y), tsmall.z);
    tMax = min(min(tbig.x, tbig.y), tbig.z);
    return tMax >= max(0.0, tMin);
}

void main() {
    ivec2 localCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 coord = localCoord + ivec2(cam.tileOffsetX, cam.tileOffsetY);
    if (coord.x >= cam.width || coord.y >= cam.height) return;

    float px = (2.0 * (float(coord.x) + 0.5) / float(cam.width) - 1.0) * cam.tanfovx;
    float py = (1.0 - 2.0 * (float(coord.y) + 0.5) / float(cam.height)) * cam.tanfovy;
    vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
    Ray ray = makeRay(cam.origin, rayDir);

    rayQueryEXT rq;
    uint flags = gl_RayFlagsNoOpaqueEXT;
    
    rayQueryInitializeEXT(rq, tlas, flags, 0xFF, ray.origin, 0.0, rayDir, cam.maxDist);

    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            
            vec3 ppos = points[ptIdx].position;
            float psize = points[ptIdx].size;
            vec3 halfSize = vec3(psize * 0.5);

            float tMin, tMax;
            if (rayBoxIntersect(ray, ppos - halfSize, ppos + halfSize, tMin, tMax)) {
                float t = (tMin < 0.0) ? tMax : tMin;
                if (t >= 0.0 && t <= rayQueryGetIntersectionTEXT(rq, true)) {
                    rayQueryGenerateIntersectionEXT(rq, t);
                }
            }
        }
    }

    float minDist = cam.maxDist;
    int bestIdx = -1;

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionGeneratedEXT) {
        minDist = rayQueryGetIntersectionTEXT(rq, true);
        bestIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    }

    vec3 finalColor = cam.bgColor;
    float depthOut = 1e30;
    float objIdOut = -1.0;

    if (bestIdx != -1) {
        GPUFastRenderData hitData = points[bestIdx];
        
        vec3 hitPoint = ray.origin + ray.dir * minDist;
        vec3 bMin = hitData.position - vec3(hitData.size * 0.5);
        vec3 bMax = hitData.position + vec3(hitData.size * 0.5);
        vec3 dMin = abs(hitPoint - bMin);
        vec3 dMax = abs(hitPoint - bMax);
        
        vec3 minAll = min(dMin, dMax);
        float minVal = min(min(minAll.x, minAll.y), minAll.z);
        
        vec3 bestNormal;
        if (minVal == dMin.x) bestNormal = vec3(-1, 0, 0);
        else if (minVal == dMax.x) bestNormal = vec3(1, 0, 0);
        else if (minVal == dMin.y) bestNormal = vec3(0, -1, 0);
        else if (minVal == dMax.y) bestNormal = vec3(0, 1, 0);
        else if (minVal == dMin.z) bestNormal = vec3(0, 0, -1);
        else bestNormal = vec3(0, 0, 1);

        GPUMaterial mat = materials[hitData.materialIdx];
        vec3 albedo = unpackRGB8(hitData.color);
        vec3 surfaceColor;
        
        if (mat.emittance > 0.0) {
            surfaceColor = albedo * mat.emittance;
        } else {
            vec3 lightDir = normalize(-cam.dir);
            float diffuse = max(0.0, dot(bestNormal, lightDir));
            surfaceColor = albedo * min(1.0, 0.35 + diffuse * 0.65);
        }
        
        float fogT = clamp((minDist - cam.lodMinDist) * cam.invFogRange, 0.0, 1.0);
        finalColor = mix(cam.bgColor, surfaceColor, mix(1.0, cam.minVisibility, fogT));
        depthOut = minDist;
        objIdOut = float(hitData.objectId);
    }
    
    finalColor = clamp(finalColor, 0.0, 1.0);
    uint idx = (coord.y * cam.width + coord.x) * 5;
    pixels[idx] = finalColor.r;
    pixels[idx + 1] = finalColor.g;
    pixels[idx + 2] = finalColor.b;
    pixels[idx + 3] = depthOut;
    pixels[idx + 4] = objIdOut;
}