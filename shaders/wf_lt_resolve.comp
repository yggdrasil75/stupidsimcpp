#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#define WF_LIGHT_TRACE
#include "wf_common.glsl"

// Resolve stage for light tracing. Runs once per pixel.
//
// pc.stage == 0 : CLEAR  -> zero this pixel's splat slots (start of a sample);
//                           also zero the debug counters in the buffer tail.
// pc.stage == 1 : RESOLVE-> decode fixed-point uint splat into pixels[],
//                           accumulating across samples, and surface debug
//                           counters into the last pixels' spare channels.

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = uint(cam.width) * uint(cam.height);
    if (gid >= total) return;

    uint sbase = gid * 4u;
    uint pbase = gid * 5u;
    if (pbase + 4u >= uint(pixels.length())) return;

    if (pc.stage == 0) {
        splatU[sbase + 0u] = 0u;
        splatU[sbase + 1u] = 0u;
        splatU[sbase + 2u] = 0u;
        splatU[sbase + 3u] = 0u;
        // Zero the 5 debug counters (only one thread needs to).
        if (gid == 0u) {
            for (uint k = 0u; k < 5u; ++k) splatU[dbgBase() + k] = 0u;
        }
        if (pc.sampleIndex == 0) {
            pixels[pbase + 0u] = 0.0;
            pixels[pbase + 1u] = 0.0;
            pixels[pbase + 2u] = 0.0;
            pixels[pbase + 3u] = 0.0;
            pixels[pbase + 4u] = -1.0;
        }
        return;
    }

    // RESOLVE
    float inv = 1.0 / max(1e-6, cam.ltSplatScale);
    vec3 c = vec3(float(splatU[sbase + 0u]),
                  float(splatU[sbase + 1u]),
                  float(splatU[sbase + 2u])) * inv;

    pixels[pbase + 0u] += c.r;
    pixels[pbase + 1u] += c.g;
    pixels[pbase + 2u] += c.b;

    // DEBUG: surface the diagnostic counters (buffer tail) into the last
    // pixels' spare channels so the host can read them from mapped pixels[].
    //   dbg+0 seeded, +1 shade entries, +2 entering-gate, +3 connections, +4 survivors
    uint db = dbgBase();
    if (gid == total - 1u) {
        pixels[pbase + 3u] = float(splatU[db + 0u]); // seeded
        pixels[pbase + 4u] = float(splatU[db + 1u]); // shade entries
    }
    if (gid == total - 2u) {
        pixels[pbase + 3u] = float(splatU[db + 2u]); // entering gate
        pixels[pbase + 4u] = float(splatU[db + 3u]); // connections
    }
    if (gid == total - 3u) {
        pixels[pbase + 3u] = float(splatU[db + 4u]); // survivors
    }
}
