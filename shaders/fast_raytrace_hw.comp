#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

#define PI 3.14159265359

struct GPURenderNode {
    vec3 boundsMin;
    float p1;
    vec3 boundsMax;
    float p2;
    vec3 center;
    float nodeSize;
    uint isLeaf;
    uint isLoaded;
    uint childMask;
    uint firstPoint;
    uint pointCount;
    int lodPoint;
    uint firstChild;
    uint p3;
};

struct GPUFastRenderData {
    vec3 position;
    float size;
    vec3 color;
    float emittance;
    vec3 boundsMin;
    int objectId;
    vec3 boundsMax;
    float padding2;
};

layout(std430, binding = 0) readonly buffer NodeBuffer { GPURenderNode nodes[]; };
layout(std430, binding = 1) readonly buffer PointBuffer { GPUFastRenderData points[]; };
layout(std430, binding = 2) writeonly buffer OutputBuffer { float pixels[]; };

layout(binding = 3) uniform CameraData {
    vec3 origin;
    float lodMinDist;
    vec3 dir;
    float invLodf;
    vec3 up;
    float minVisibility;
    vec3 right;
    float maxDist;
    vec3 skylight;
    float tanfovx;
    vec3 bgColor;
    float tanfovy;
    int width;
    int height;
    int maxBounces;
    int useLod;
    float invFogRange;
    uint frameCount;
    int skyWidth;
    int skyHeight;
    int currentSampleOffset;
    int dispatchSamples;
    int globalIllumination;
    uint nodeCount;
    uint pointCount;
    int tileOffsetX;
    int tileOffsetY;
    int padding;
} cam;

layout(std430, binding = 4) readonly buffer SkyboxBuffer { vec4 skyPixels[]; };
layout(binding = 6) uniform accelerationStructureEXT tlas;

struct Ray {
    vec3 origin;
    vec3 dir;
    vec3 invDir;
    ivec3 signMask;
};
Ray makeRay(vec3 o, vec3 d) {
    Ray r;
    r.origin = o;
    r.dir = d;
    r.invDir = 1.0 / d;
    r.signMask = ivec3(r.invDir.x < 0 ? 1 : 0, r.invDir.y < 0 ? 1 : 0, r.invDir.z < 0 ? 1 : 0);
    return r;
}

bool rayBoxIntersect(Ray ray, vec3 bMin, vec3 bMax, out float tMin, out float tMax) {
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    vec3 tsmall = min(t0, t1);
    vec3 tbig = max(t0, t1);
    tMin = max(max(tsmall.x, tsmall.y), tsmall.z);
    tMax = min(min(tbig.x, tbig.y), tbig.z);
    return tMax >= max(0.0, tMin);
}

bool rayCubeIntersect(Ray ray, GPUFastRenderData pt, out float t, out vec3 normal) {
    float tMin, tMax;
    if (!rayBoxIntersect(ray, pt.boundsMin, pt.boundsMax, tMin, tMax) || tMax < 0.0) return false;
    t = tMin < 0.0 ? tMax : tMin;
    vec3 hitPoint = ray.origin + ray.dir * t;
    vec3 dMin = abs(hitPoint - pt.boundsMin);
    vec3 dMax = abs(hitPoint - pt.boundsMax);
    
    float minDist = 999999.0;
    int minAxis = 0;
    float sgn = 1.0;
    if(dMin.x < minDist) {
        minDist = dMin.x;
        minAxis = 0;
        sgn = -1.0;
    }
    if(dMin.y < minDist) {
        minDist = dMin.y;
        minAxis = 1;
        sgn = -1.0;
    }
    if(dMin.z < minDist) {
        minDist = dMin.z;
        minAxis = 2;
        sgn = -1.0;
    }
    if(dMax.x < minDist) {
        minDist = dMax.x;
        minAxis = 0;
        sgn = 1.0;
    }
    if(dMax.y < minDist) {
        minDist = dMax.y;
        minAxis = 1;
        sgn = 1.0;
    }
    if(dMax.z < minDist) {
        minDist = dMax.z;
        minAxis = 2;
        sgn = 1.0;
    }
    
    normal = vec3(0);
    normal[minAxis] = sgn;
    return true;
}

vec3 sampleSkybox(vec3 d) {
    float u = 0.5 + (atan(d.z, d.x) / (2.0 * PI));
    float v = 0.5 - (asin(clamp(d.y, -1.0, 1.0)) / PI);
    u = clamp(u, 0.0, 0.9999);
    v = clamp(v, 0.0, 0.9999);
    
    int x = int(u * float(cam.skyWidth));
    int y = int(v * float(cam.skyHeight));
    int idx = y * cam.skyWidth + x;
    
    if (idx < 0 || idx >= cam.skyWidth * cam.skyHeight) return cam.bgColor;
    return skyPixels[idx].rgb;
}

int voxelTraverse(Ray ray, out int hitIndex, out float outT, out vec3 outNormal) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, ray.origin, 0.0, ray.dir, cam.maxDist);

    while(rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            float t;
            vec3 n;
            if (rayCubeIntersect(ray, points[ptIdx], t, n) && t >= 0.0 && t <= cam.maxDist) {
                rayQueryGenerateIntersectionEXT(rq, t);
            }
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionGeneratedEXT) {
        hitIndex = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        outT = rayQueryGetIntersectionTEXT(rq, true);
        float dummyT;
        rayCubeIntersect(ray, points[hitIndex], dummyT, outNormal);
        return 1;
    }
    return 0;
}

void main() {
    ivec2 localCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 coord = localCoord + ivec2(cam.tileOffsetX, cam.tileOffsetY);
    if (coord.x >= cam.width || coord.y >= cam.height) return;

    float px = (2.0 * (float(coord.x) + 0.5) / float(cam.width) - 1.0) * cam.tanfovx;
    float py = (1.0 - 2.0 * (float(coord.y) + 0.5) / float(cam.height)) * cam.tanfovy;
    vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
    Ray ray = makeRay(cam.origin, rayDir);

    vec3 finalColor = cam.bgColor;
    int hitIndex;
    float t;
    vec3 normal;
    int hitResult = voxelTraverse(ray, hitIndex, t, normal);

    float depthOut = 1e30;
    float objIdOut = -1.0;

    if (hitResult == 1) {
        GPUFastRenderData hitData = points[hitIndex];
        vec3 surfaceColor;
        if (hitData.emittance > 0.0) {
            surfaceColor = hitData.color * hitData.emittance;
        } else {
            vec3 lightDir = normalize(-cam.dir);
            float diffuse = max(0.0, dot(normal, lightDir));
            surfaceColor = hitData.color * min(1.0, 0.35 + diffuse * 0.65);
        }
        float fogT = clamp((t - cam.lodMinDist) * cam.invFogRange, 0.0, 1.0);
        finalColor = mix(cam.bgColor, surfaceColor, mix(1.0, cam.minVisibility, fogT));
        depthOut = t;
        objIdOut = hitData.objectId;
    }
    
    finalColor = clamp(finalColor, 0.0, 1.0);
    uint idx = (coord.y * cam.width + coord.x) * 5;
    pixels[idx] = finalColor.r;
    pixels[idx + 1] = finalColor.g;
    pixels[idx + 2] = finalColor.b;
    pixels[idx + 3] = depthOut;
    pixels[idx + 4] = objIdOut;
}