#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

vec3 unpackRGB9E5(uint c) {
    if (c == 0u) return vec3(0.0);
    int e = int(c >> 27) - 15;
    float scale = exp2(float(e - 9));
    float r = float(c & 0x1FFu) * scale;
    float g = float((c >> 9) & 0x1FFu) * scale;
    float b = float((c >> 18) & 0x1FFu) * scale;
    return vec3(r, g, b);
}

#define PI 3.14159265359
const float EPS = 1e-8;
const float LARGE = 1e30;
#define MAX_HITS 16 

struct GPUMaterial {
    uint chromaticity;   // RGB9E5
    uint materialProps;  // roughness (8) | metallic (8) | ior (8) | 8 spare
    uint absorption;     // RGB9E5
    uint albedo;         // RGB9E5
};

struct GPURenderData {
    vec3 position;
    float size;
    uint color;
    uint materialIdx;
    int objectId;
    uint extent;
};

vec3 unpackExtent(uint e) {
    return vec3(float((e & 0x3FFu) + 1u), float(((e >> 10) & 0x3FFu) + 1u), float(((e >> 20) & 0x3FFu) + 1u));
}
vec3 ptBoundsMin(GPURenderData p) { return p.position - p.size * 0.5; }
vec3 ptBoundsMax(GPURenderData p) { return p.position + p.size * 0.5 + p.size * (unpackExtent(p.extent) - vec3(1.0)); }


layout(std430, binding = 1) readonly buffer PointBuffer { GPURenderData points[]; };
layout(std430, binding = 2) writeonly buffer OutputBuffer { float pixels[]; };

layout(binding = 3) uniform CameraData {
    vec3 origin;
    float lodMinDist;
    vec3 dir;
    float invLodf;
    vec3 up;
    float minVisibility;
    vec3 right;
    float maxDist;
    vec3 skylight;
    float tanfovx;
    vec3 bgColor;
    float tanfovy;
    int width;
    int height;
    int maxBounces;
    int useLod;
    float invFogRange;
    uint frameCount;
    int skyWidth;
    int skyHeight;
    int currentSampleOffset;
    int dispatchSamples;
    int globalIllumination;
    uint nodeCount;
    uint pointCount;
    int tileOffsetX;
    int tileOffsetY;
    int emissiveCount;
} cam;

layout(std430, binding = 5) readonly buffer LightBuffer { uint emissiveIndices[]; };

layout(std430, binding = 4) readonly buffer SkyboxBuffer { vec4 skyPixels[]; };
layout(binding = 6) uniform accelerationStructureEXT tlas;
layout(std430, binding = 8) readonly buffer MaterialBuffer { GPUMaterial materials[]; };
layout(binding = 9)  uniform sampler3D voxelTex;
layout(binding = 10) uniform VoxelParams {
    vec3 volMin;     float voxelSize;
    vec3 volExtent;  float invVoxelSize;
    ivec3 gridRes;   int   maxMip;
    vec3 lightDir;   float vctEnabled;
} vp;

vec3 worldToVoxelUV(vec3 p) { return (p - vp.volMin) / vp.volExtent; }

vec4 sampleVoxelCone(vec3 worldPos, float diameter) {
    vec3 uv = worldToVoxelUV(worldPos);
    if (any(lessThan(uv, vec3(0.0))) || any(greaterThan(uv, vec3(1.0)))) return vec4(0.0);
    float lod = clamp(log2(max(diameter * vp.invVoxelSize, 1.0)), 0.0, float(vp.maxMip));
    return textureLod(voxelTex, uv, lod);
}

vec4 traceCone(vec3 origin, vec3 dir, float aperture, float maxConeDist) {
    vec4 acc = vec4(0.0);
    float dist = vp.voxelSize;
    while (dist < maxConeDist && acc.a < 0.99) {
        float diameter = max(vp.voxelSize, aperture * dist);
        vec4 s = sampleVoxelCone(origin + dir * dist, diameter);
        float w = (1.0 - acc.a);
        acc.rgb += w * s.rgb;
        acc.a   += w * s.a;
        dist += diameter * 0.5;
    }
    return acc;
}

vec3 coneTraceDiffuse(vec3 worldPos, vec3 normal, float maxConeDist, out float ao) {
    vec3 up = abs(normal.y) > 0.95 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 tg = normalize(cross(up, normal));
    vec3 bt = cross(normal, tg);
    const float aperture = 0.577;
    vec3 diffuse = vec3(0.0);
    float occlusion = 0.0;
    const float wCenter = 0.25;
    const float wSide   = 0.15;
    vec3 o = worldPos + normal * vp.voxelSize * 1.5;

    vec4 c = traceCone(o, normal, aperture, maxConeDist);
    diffuse += wCenter * c.rgb; occlusion += wCenter * c.a;

    const float SIN60 = 0.866025;
    const float COS60 = 0.5;
    for (int i = 0; i < 5; ++i) {
        float ang = float(i) * (6.2831853 / 5.0);
        vec3 dirT = cos(ang) * tg + sin(ang) * bt;
        vec3 d = normalize(COS60 * normal + SIN60 * dirT);
        vec4 sc = traceCone(o, d, aperture, maxConeDist);
        diffuse += wSide * sc.rgb; occlusion += wSide * sc.a;
    }
    ao = 1.0 - clamp(occlusion, 0.0, 1.0);
    return diffuse;
}

vec3 safe_invDir(vec3 d) {
    return vec3(
        abs(d.x) < EPS ? (d.x < 0.0 ? -LARGE : LARGE) : 1.0 / d.x,
        abs(d.y) < EPS ? (d.y < 0.0 ? -LARGE : LARGE) : 1.0 / d.y,
        abs(d.z) < EPS ? (d.z < 0.0 ? -LARGE : LARGE) : 1.0 / d.z
    );
}

struct Ray {
    vec3 origin;
    vec3 dir;
    vec3 invDir;
    ivec3 signMask;
};
Ray makeRay(vec3 o, vec3 d) {
    Ray r;
    r.origin = o;
    r.dir = d;
    r.invDir = safe_invDir(d);
    r.signMask = ivec3(r.invDir.x < 0.0 ? 1 : 0, r.invDir.y < 0.0 ? 1 : 0, r.invDir.z < 0.0 ? 1 : 0);
    return r;
}

vec4 unpackRGBA8(uint c) {
    return vec4(float(c & 0xFF) / 255.0, 
                float((c >> 8) & 0xFF) / 255.0, 
                float((c >> 16) & 0xFF) / 255.0, 
                float((c >> 24) & 0xFF) / 255.0);
}

bool rayBoxIntersect(Ray ray, vec3 bMin, vec3 bMax, out float tMin, out float tMax) {
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    vec3 tsmall = min(t0, t1);
    vec3 tbig = max(t0, t1);
    tMin = max(max(tsmall.x, tsmall.y), tsmall.z);
    tMax = min(min(tbig.x, tbig.y), tbig.z);
    return tMax >= max(0.0, tMin);
}

bool rayCubeIntersect(Ray ray, GPURenderData pt, out float t, out float tExitOut, out vec3 normal) {
    vec3 bMin = ptBoundsMin(pt);
    vec3 bMax = ptBoundsMax(pt);

    float tMin, tMax;
    if (!rayBoxIntersect(ray, bMin, bMax, tMin, tMax) || tMax < 0.0) return false;
    t = tMin < 0.0 ? tMax : tMin;
    tExitOut = tMax;
    vec3 hitPoint = ray.origin + ray.dir * t;
    vec3 dMin = abs(hitPoint - bMin);
    vec3 dMax = abs(hitPoint - bMax);
    
    float minDist = 999999.0;
    int minAxis = 0;
    float sgn = 1.0;
    if(dMin.x < minDist) {
        minDist = dMin.x;
        minAxis = 0;
        sgn = -1.0;
    }
    if(dMin.y < minDist) {
        minDist = dMin.y;
        minAxis = 1;
        sgn = -1.0;
    }
    if(dMin.z < minDist) {
        minDist = dMin.z;
        minAxis = 2;
        sgn = -1.0;
    }
    if(dMax.x < minDist) {
        minDist = dMax.x;
        minAxis = 0;
        sgn = 1.0;
    }
    if(dMax.y < minDist) {
        minDist = dMax.y;
        minAxis = 1;
        sgn = 1.0;
    }
    if(dMax.z < minDist) {
        minDist = dMax.z;
        minAxis = 2;
        sgn = 1.0;
    }
    
    normal = vec3(0);
    normal[minAxis] = sgn;
    return true;
}

vec3 sampleSkybox(vec3 d) {
    float u = 0.5 + (atan(d.z, d.x) / (2.0 * PI));
    float v = 0.5 - (asin(clamp(d.y, -1.0, 1.0)) / PI);
    u = clamp(u, 0.0, 0.9999);
    v = clamp(v, 0.0, 0.9999);
    
    int x = int(u * float(cam.skyWidth));
    int y = int(v * float(cam.skyHeight));
    int idx = y * cam.skyWidth + x;
    
    if (idx < 0 || idx >= cam.skyWidth * cam.skyHeight) return cam.bgColor;
    return skyPixels[idx].rgb;
}

struct HitData {
    int id;
    float t;
    float tExit;
    vec3 normal;
};

int voxelTraverse(Ray ray, out HitData hits[MAX_HITS]) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, ray.origin, 0.0, ray.dir, cam.maxDist);

    int hitCount = 0;
    while(rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            float t, tExit;
            vec3 n;
            if (rayCubeIntersect(ray, points[ptIdx], t, tExit, n) && t >= 0.0 && t <= cam.maxDist) {
                if (hitCount == MAX_HITS && t >= hits[MAX_HITS - 1].t) continue;
                int slot = min(hitCount, MAX_HITS - 1);
                while (slot > 0 && hits[slot - 1].t > t) {
                    hits[slot] = hits[slot - 1];
                    slot--;
                }
                hits[slot].id = ptIdx;
                hits[slot].t = t;
                hits[slot].tExit = tExit;
                hits[slot].normal = n;
                if (hitCount < MAX_HITS) hitCount++;
            }
        }
    }
    
    return hitCount;
}

void unpackFastMaterial(uint m, out float roughness, out float metallic) {
    roughness = float(m & 0xFF) / 255.0;
    metallic  = float((m >> 8) & 0xFF) / 255.0;
}

bool pickLight(vec3 pos, int selfObjId, out vec3 ldir, out float ldist,
               out vec3 emit, out int lightObjId, out float lightSize) {
    float bestScore = 0.0;
    bool found = false;
    int n = min(3, cam.emissiveCount);
    for (int i = 0; i < n; ++i) {
        GPURenderData lp = points[emissiveIndices[i]];
        if (lp.objectId == selfObjId) continue;
        vec3 toL = lp.position - pos;
        float distSq = max(dot(toL, toL), EPS);
        vec3 emitCol = unpackRGB9E5(materials[lp.materialIdx].chromaticity);
        vec3 e = max(emitCol, unpackRGBA8(lp.color).rgb * emitCol);
        float lum = dot(e, vec3(0.2126, 0.7152, 0.0722));
        vec3 lpe = unpackExtent(lp.extent);
        float score = lum * lp.size * lp.size * max(lpe.x * lpe.y, max(lpe.y * lpe.z, lpe.x * lpe.z)) / distSq;
        if (score > bestScore) {
            bestScore = score;
            found = true;
            float d = sqrt(distSq);
            ldir = toL / d;
            ldist = d;
            emit = e;
            lightObjId = lp.objectId;
            lightSize = lp.size * max(lpe.x, max(lpe.y, lpe.z));
        }
    }
    return found;
}

float lightVisibility(vec3 origin, vec3 dir, float maxT, int lightObjId) {
    Ray sray = makeRay(origin, dir);
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, origin, 0.0, dir, maxT);
    float vis = 1.0;
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            GPURenderData pt = points[ptIdx];
            if (pt.objectId == lightObjId) continue;               // the light itself
            if (materials[pt.materialIdx].chromaticity != 0u) continue; // other emitters don't occlude
            float t, tExit; vec3 n;
            if (rayCubeIntersect(sray, pt, t, tExit, n) && t > 0.0 && t < maxT) {
                vis *= 1.0 - unpackRGBA8(pt.color).a;              // alpha transmittance
                if (vis < 0.02) return 0.0;
            }
        }
    }
    return vis;
}

// One NEE connection at a path vertex: cosine-weighted, inverse-square
// attenuated, shadowed radiance from the best light. One shadow ray.
vec3 lightSample(vec3 pos, vec3 normal, int selfObjId) {
    vec3 ldir, emit; float ldist, lsize; int lobj;
    if (!pickLight(pos, selfObjId, ldir, ldist, emit, lobj, lsize)) return vec3(0.0);
    float ndotl = dot(normal, ldir);
    if (ndotl <= 0.0) return vec3(0.0);
    float area = lsize * lsize;
    float atten = area / max(ldist * ldist, area);
    vec3 o = pos + normal * max(lsize * 0.01, 1e-3);
    float vis = lightVisibility(o, ldir, max(ldist - lsize, EPS), lobj);
    return emit * (ndotl * atten * vis);
}

const float OPAQUE_CUTOFF = 0.5;
const float FOG_CUTOFF    = 0.02;

bool nearestHit(vec3 origin, vec3 dir, float maxT, int skipObjId,
                out float tOut, out vec3 nOut, out int idxOut, out vec3 tintOut) {
    Ray ray = makeRay(origin, dir);
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, origin, 0.0, dir, maxT);

    int   hitIdx[MAX_HITS];
    float hitT[MAX_HITS];
    vec3  hitN[MAX_HITS];
    int   count = 0;

    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            int ptIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            GPURenderData pt = points[ptIdx];
            if (pt.objectId == skipObjId) continue;
            float t, tExit; vec3 n;
            if (rayCubeIntersect(ray, pt, t, tExit, n) && t > 1e-4 && t < maxT) {
                if (count == MAX_HITS && t >= hitT[MAX_HITS - 1]) continue;
                int slot = min(count, MAX_HITS - 1);
                while (slot > 0 && hitT[slot - 1] > t) {
                    hitT[slot] = hitT[slot - 1];
                    hitIdx[slot] = hitIdx[slot - 1];
                    hitN[slot] = hitN[slot - 1];
                    slot--;
                }
                hitIdx[slot] = ptIdx; hitT[slot] = t; hitN[slot] = n;
                if (count < MAX_HITS) count++;
            }
        }
    }

    tintOut = vec3(1.0);
    if (count == 0) { tOut = maxT; return false; }

    for (int i = 0; i < count; i++) {
        vec4 alb = unpackRGBA8(points[hitIdx[i]].color);
        if (alb.a < FOG_CUTOFF) continue;
        if (alb.a >= OPAQUE_CUTOFF) {
            tOut = hitT[i]; nOut = hitN[i]; idxOut = hitIdx[i];
            return true;
        }
        tintOut *= mix(vec3(1.0), alb.rgb, alb.a);
        if (max(tintOut.r, max(tintOut.g, tintOut.b)) < 0.02) {
            tOut = hitT[i]; nOut = hitN[i]; idxOut = hitIdx[i];
            return true;
        }
    }

    tOut = maxT;
    return false;
}

vec3 secondaryRadiance(vec3 origin, vec3 dir, int skipObjId) {
    float t; vec3 n; int idx; vec3 tint;
    if (!nearestHit(origin, dir, cam.maxDist, skipObjId, t, n, idx, tint)) {
        return tint * sampleSkybox(dir);
    }
    GPURenderData pt = points[idx];
    vec4 alb = unpackRGBA8(pt.color);
    GPUMaterial m = materials[pt.materialIdx];
    if (m.chromaticity != 0u) {
        vec3 emitCol = unpackRGB9E5(m.chromaticity);
        return tint * max(emitCol, alb.rgb * emitCol);
    }
    vec3 hp = origin + dir * t;
    return tint * alb.rgb * lightSample(hp, n, pt.objectId);
}

const float GUIDE_IOR = 1.45;
vec3 guideShade(vec3 hitPos, vec3 normal, vec3 viewDir, vec4 albedo, uint matProps, int selfObjId) {
    float roughness, metallic;
    unpackFastMaterial(matProps, roughness, metallic);
    float transmission = 1.0 - albedo.a;

    float cosTheta = clamp(dot(-viewDir, normal), 0.0, 1.0);
    float F0 = mix(0.04, 1.0, metallic);
    float fresnel = F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
    
    float surfaceResponse = mix(albedo.a, 1.0, fresnel);
    surfaceResponse = max(surfaceResponse, 0.15 * (1.0 - metallic));
    vec3 col = albedo.rgb * (1.0 - metallic) * surfaceResponse
             * lightSample(hitPos, normal, selfObjId);

    if (transmission > 0.05) {
        float eta = 1.0 / GUIDE_IOR;
        vec3 refr = refract(viewDir, normal, eta);
        if (dot(refr, refr) < 1e-6) refr = reflect(viewDir, normal); // TIR fallback
        vec3 o = hitPos - normal * 1e-3;
        col += transmission * (1.0 - fresnel) * albedo.rgb
             * secondaryRadiance(o, normalize(refr), selfObjId);
    }

    float smoothness = 1.0 - roughness;
    float wRefl = fresnel * smoothness * smoothness;
    if (wRefl > 0.02) {
        vec3 refl = reflect(viewDir, normal);
        vec3 o = hitPos + normal * 1e-3;
        vec3 tint = mix(vec3(1.0), albedo.rgb, metallic);
        col += wRefl * tint * secondaryRadiance(o, normalize(refl), -1);
    }

    return col;
}

void main() {
    ivec2 localCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 coord = localCoord + ivec2(cam.tileOffsetX, cam.tileOffsetY);
    if (coord.x >= cam.width || coord.y >= cam.height) return;

    float px = (2.0 * (float(coord.x) + 0.5) / float(cam.width) - 1.0) * cam.tanfovx;
    float py = (1.0 - 2.0 * (float(coord.y) + 0.5) / float(cam.height)) * cam.tanfovy;
    vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
    Ray ray = makeRay(cam.origin, rayDir);

    HitData hits[MAX_HITS];
    int hitCount = voxelTraverse(ray, hits);

    float depthOut = 1e30;
    float objIdOut = -1.0;
    
    vec3 accum = vec3(0.0);
    float accumAlpha = 0.0;
    int prevOid = 0;
    bool hasPrev = false;

    for (int i = 0; i < hitCount; i++) {
        if (accumAlpha >= 0.99) break;
        
        GPURenderData hitData = points[hits[i].id];
        
        vec4 albedo = unpackRGBA8(hitData.color);
        float alpha = albedo.a;
        GPUMaterial mat = materials[hitData.materialIdx];

        bool isInternalVoxel = (hasPrev && hitData.objectId == prevOid);

        vec3 surfaceColor;
        bool isEmitter = (mat.chromaticity != 0u);
        if (isEmitter) {
            vec3 emitCol = unpackRGB9E5(mat.chromaticity);
            surfaceColor = max(emitCol, albedo.rgb * emitCol);
        } else {
            vec3 lightDir = normalize(-cam.dir);
            float diffuse = 0.0;
            bool guideMode = (cam.globalIllumination == 2);
            vec3 pathLight = vec3(0.0);
            if (!isInternalVoxel) {
                diffuse = max(0.0, dot(hits[i].normal, lightDir));
                if (guideMode) {
                    vec3 hitPos = ray.origin + ray.dir * hits[i].t;
                    if (i == 0) {
                        pathLight = guideShade(hitPos, hits[i].normal, ray.dir,
                                               albedo, mat.materialProps, hitData.objectId);
                    } else {
                        pathLight = albedo.rgb * albedo.a
                                  * lightSample(hitPos, hits[i].normal, hitData.objectId);
                    }
                    pathLight += albedo.rgb * (0.1 * diffuse);
                }
            }

            if (vp.vctEnabled > 0.5 && !isInternalVoxel) {
                // Cone-traced indirect diffuse + AO from the radiance volume.
                vec3 hitPos = ray.origin + ray.dir * hits[i].t;
                float ao;
                float coneMax = length(vp.volExtent) * 0.5;
                vec3 indirect = coneTraceDiffuse(hitPos, hits[i].normal, coneMax, ao);
                vec3 directTerm  = guideMode ? pathLight * ao
                                             : albedo.rgb * diffuse * ao;
                vec3 ambientTerm = albedo.rgb * 0.15 * ao;
                surfaceColor = directTerm + ambientTerm + albedo.rgb * indirect;
            } else {
                surfaceColor = guideMode ? pathLight + albedo.rgb * 0.15
                                         : albedo.rgb * min(1.0, 0.35 + diffuse * 0.65);
            }
        }
        
        float fogFactor = clamp((cam.maxDist - hits[i].t) * cam.invFogRange, cam.minVisibility, 1.0);
        vec3 skyColor = sampleSkybox(rayDir);
        
        if (!isEmitter) {
            surfaceColor = surfaceColor * fogFactor + skyColor * (1.0 - fogFactor);
        }

        float coverage;
        if (isEmitter) {
            coverage = 1.0;
        } else if (isInternalVoxel) {
            float thickness = max(0.0, hits[i].tExit - hits[i].t);
            float trPerUnit = clamp(1.0 - alpha, 0.0, 1.0);
            coverage = 1.0 - pow(trPerUnit, thickness);
        } else {
            vec3 vdir = ray.dir;
            float cosT = clamp(dot(-vdir, hits[i].normal), 0.0, 1.0);
            float fres = 0.04 + 0.96 * pow(1.0 - cosT, 5.0);
            coverage = clamp(mix(alpha, 1.0, fres) + 0.10 * (1.0 - alpha), 0.0, 1.0);
        }
        
        accum += surfaceColor * coverage * (1.0 - accumAlpha);
        accumAlpha += coverage * (1.0 - accumAlpha);
        prevOid = hitData.objectId;
        hasPrev = true;

        if (i == 0) {
            depthOut = hits[i].t;
            objIdOut = float(hitData.objectId);
        }
    }
    
    vec3 finalRGB = accum;
    if (accumAlpha < 1.0) {
        vec3 skyColor = sampleSkybox(rayDir);
        finalRGB += skyColor * (1.0 - accumAlpha);
    }
    
    finalRGB = clamp(finalRGB, 0.0, 1.0);

    uint idx = (coord.y * cam.width + coord.x) * 5;
    pixels[idx] = finalRGB.r;
    pixels[idx + 1] = finalRGB.g;
    pixels[idx + 2] = finalRGB.b;
    pixels[idx + 3] = depthOut;
    pixels[idx + 4] = objIdOut;
}