#version 460
#extension GL_GOOGLE_include_directive : require
#include "phys_common.glsl"

// Apply accumulated displacement, then resolve against static solids.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) return;
    vec3 xs = pred[i].xyz + disp[i].xyz;
    disp[i] = vec4(0.0);
    collideSolid(i, xs);
    pred[i].xyz = xs;
}
