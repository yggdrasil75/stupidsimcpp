#version 450
layout(local_size_x = 8, local_size_y = 8) in;

struct GPUCameraData {
    vec3 origin; float lodMinDist;
    vec3 dir; float invLodf;
    vec3 up; float minVisibility;
    vec3 right; float maxDist;
    vec3 skylight; float tanfovx;
    vec3 bgColor; float tanfovy;
    int width; int height;
    int maxBounces; int useLod;
    float invFogRange; uint frameCount;
    int skyWidth; int skyHeight;
    int currentSampleOffset; int dispatchSamples;
    int globalIllumination; uint nodeCount;
    uint pointCount; int tileOffsetX;
    int tileOffsetY; int emissiveCount;
    int targetSamples;
};

struct GPURenderNode {
    vec3 boundsMin; float padding1;
    vec3 boundsMax; float padding2;
    vec3 center; float nodeSize;
    uint isLeaf; uint isLoaded;
    uint childMask; uint firstPoint;
    uint pointCount; int lodPoint;
    uint firstChild; uint padding3;
};

struct GPUFastRenderData {
    vec3 position; float size;
    uint color; uint materialIdx;
    int objectId; float gasDensity;
};

layout(std430, binding = 0) readonly buffer NodeBuf { GPURenderNode nodes[]; };
layout(std430, binding = 1) readonly buffer PointBuf { GPUFastRenderData points[]; };
layout(std430, binding = 2) writeonly buffer OutBuf { float outData[]; };
layout(std140, binding = 3) uniform UBO { GPUCameraData cam; };

bool rayBoxIntersect(vec3 ro, vec3 invDir, vec3 boundsMin, vec3 boundsMax, out float tMin, out float tMax) {
    vec3 t0 = (boundsMin - ro) * invDir;
    vec3 t1 = (boundsMax - ro) * invDir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    tMin = max(max(tmin.x, tmin.y), tmin.z);
    tMax = min(min(tmax.x, tmax.y), tmax.z);
    return tMax >= max(0.0, tMin);
}

bool rayCubeIntersect(vec3 ro, vec3 rd, vec3 invDir, GPUFastRenderData pt, out float tOut, out vec3 normal) {
    float halfSize = pt.size * 0.5;
    vec3 boundsMin = pt.position - vec3(halfSize);
    vec3 boundsMax = pt.position + vec3(halfSize);
    float tMin, tMax;
    if (rayBoxIntersect(ro, invDir, boundsMin, boundsMax, tMin, tMax)) {
        if (tMin >= 0.0) {
            tOut = tMin;
            vec3 hitPoint = ro + rd * tMin;
            vec3 localPoint = (hitPoint - pt.position) / halfSize;
            vec3 absP = abs(localPoint);
            if (absP.x > absP.y && absP.x > absP.z) normal = vec3(sign(localPoint.x), 0, 0);
            else if (absP.y > absP.z) normal = vec3(0, sign(localPoint.y), 0);
            else normal = vec3(0, 0, sign(localPoint.z));
            return true;
        }
    }
    return false;
}

vec3 unpackRGB(uint c) {
    return vec3(float(c & 255), float((c >> 8) & 255), float((c >> 16) & 255)) / 255.0;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= cam.width || y >= cam.height) return;

    float px = (2.0 * (float(x) + 0.5) / float(cam.width) - 1.0) * cam.tanfovx;
    float py = (1.0 - 2.0 * (float(y) + 0.5) / float(cam.height)) * cam.tanfovy;
    
    vec3 rayDir = normalize(cam.dir + cam.right * px + cam.up * py);
    vec3 invDir = 1.0 / rayDir;
    int signMask = ((invDir.x < 0.0) ? 1 : 0) | ((invDir.y < 0.0) ? 2 : 0) | ((invDir.z < 0.0) ? 4 : 0);

    float currentMaxDist = cam.maxDist;
    vec3 hitColor = cam.bgColor;
    bool hit = false;

    if (cam.nodeCount > 0) {
        float tMinRoot, tMaxRoot;
        if (rayBoxIntersect(cam.origin, invDir, nodes[0].boundsMin, nodes[0].boundsMax, tMinRoot, tMaxRoot)) {
            uint stack[64];
            float tMinStack[64];
            float tMaxStack[64];
            int stackPtr = 0;
            
            stack[stackPtr] = 0;
            tMinStack[stackPtr] = max(0.0, tMinRoot);
            tMaxStack[stackPtr] = min(tMaxRoot, currentMaxDist);
            stackPtr++;

            while (stackPtr > 0) {
                stackPtr--;
                uint nodeIdx = stack[stackPtr];
                float t0 = tMinStack[stackPtr];
                float t1 = tMaxStack[stackPtr];

                if (t0 > currentMaxDist) continue;

                GPURenderNode node = nodes[nodeIdx];

                if (node.isLeaf == 0 && node.lodPoint != -1) {
                    float dist = length(node.center - cam.origin);
                    if (dist > cam.lodMinDist && (dist / node.nodeSize) > cam.invLodf) {
                        float tOut; vec3 normal;
                        if (rayCubeIntersect(cam.origin, rayDir, invDir, points[node.lodPoint], tOut, normal)) {
                            if (tOut <= currentMaxDist) {
                                currentMaxDist = tOut;
                                hitColor = unpackRGB(points[node.lodPoint].color);
                                hit = true;
                            }
                        }
                        continue;
                    }
                }

                for (uint i = 0; i < node.pointCount; ++i) {
                    float tOut; vec3 normal;
                    if (rayCubeIntersect(cam.origin, rayDir, invDir, points[node.firstPoint + i], tOut, normal)) {
                        if (tOut <= currentMaxDist) {
                            currentMaxDist = tOut;
                            hitColor = unpackRGB(points[node.firstPoint + i].color);
                            hit = true;
                        }
                    }
                }

                if (node.isLeaf != 0 || node.isLoaded == 0) continue;

                vec3 ttt = (node.center - cam.origin) * invDir;
                int currIdx = ((t0 >= ttt.x) ? 1 : 0) | ((t0 >= ttt.y) ? 2 : 0) | ((t0 >= ttt.z) ? 4 : 0);
                
                float tNext;
                int childCount = 0;
                uint cNodes[4]; float cTmin[4]; float cTmax[4];

                while (t0 < t1 && t0 <= currentMaxDist) {
                    float nx = (currIdx & 1) != 0 ? t1 : ttt.x;
                    float ny = (currIdx & 2) != 0 ? t1 : ttt.y;
                    float nz = (currIdx & 4) != 0 ? t1 : ttt.z;
                    tNext = min(min(nx, ny), nz);
                    
                    int physIdx = currIdx ^ signMask;
                    if ((node.childMask & (1 << physIdx)) != 0) {
                        int childOffset = bitCount(node.childMask & ((1 << physIdx) - 1));
                        cNodes[childCount] = node.firstChild + childOffset;
                        cTmin[childCount] = t0;
                        cTmax[childCount] = tNext;
                        childCount++;
                    }
                    
                    t0 = tNext;
                    currIdx |= ((nx <= tNext) ? 1 : 0) | ((ny <= tNext) ? 2 : 0) | ((nz <= tNext) ? 4 : 0);
                }

                for (int i = childCount - 1; i >= 0; --i) {
                    if (stackPtr < 64) {
                        stack[stackPtr] = cNodes[i];
                        tMinStack[stackPtr] = cTmin[i];
                        tMaxStack[stackPtr] = cTmax[i];
                        stackPtr++;
                    }
                }
            }
        }
    }

    if (hit) {
        float fogFactor = clamp((cam.maxDist - currentMaxDist) * cam.invFogRange, cam.minVisibility, 1.0);
        hitColor = mix(cam.bgColor, hitColor, fogFactor);
    }

    int idx = (y * cam.width + x) * 3;
    outData[idx]     = hitColor.r;
    outData[idx + 1] = hitColor.g;
    outData[idx + 2] = hitColor.b;
}