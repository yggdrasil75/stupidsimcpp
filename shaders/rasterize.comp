#version 450
layout(local_size_x = 256) in;

struct GPUMeshTriangle {
    vec3 v0; float pad0;
    vec3 v1; float pad1;
    vec3 v2; float pad2;
    vec3 n;  
    uint color;
    uint materialIdx;
    float pad3[2];
};

layout(std430, binding = 2) buffer OutBuffer { float colors[]; };

layout(binding = 3) uniform UBO {
    vec3 origin; float lodMinDist;
    vec3 dir; float invLodf;
    vec3 up; float minVisibility;
    vec3 right; float maxDist;
    vec3 skylight; float tanfovx;
    vec3 bgColor; float tanfovy;
    int width; int height; int maxBounces; int useLod;
    float invFogRange; uint frameCount; int skyWidth; int skyHeight;
    int currentSampleOffset; int dispatchSamples; int globalIllumination; uint nodeCount;
    uint pointCount; int tileOffsetX; int tileOffsetY; int emissiveCount;
    int targetSamples; uint triangleCount; uint pad0;
} cam;

layout(std430, binding = 4) buffer SkyboxBuffer { vec4 skybox[]; };
layout(std430, binding = 9) buffer MeshBuffer { GPUMeshTriangle triangles[]; };
layout(std430, binding = 10) buffer DepthBuffer { uint depths[]; };

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= cam.triangleCount) return;

    GPUMeshTriangle tri = triangles[tid];

    // 1. Transform vertices relative to camera
    vec3 p0 = tri.v0 - cam.origin;
    vec3 p1 = tri.v1 - cam.origin;
    vec3 p2 = tri.v2 - cam.origin;
    
    // 2. 3D Backface Culling (crucial to save fill rate)
    vec3 viewDir = normalize(p0);
    if (dot(tri.n, viewDir) >= 0.0) return;

    // 3. Simple near plane clipping
    float z0 = dot(p0, cam.dir);
    float z1 = dot(p1, cam.dir);
    float z2 = dot(p2, cam.dir);
    if (z0 <= 0.01 || z1 <= 0.01 || z2 <= 0.01) return;

    // 4. Project coordinates to the screen
    vec2 sc0 = vec2(dot(p0, cam.right) / z0, dot(p0, cam.up) / z0);
    vec2 sc1 = vec2(dot(p1, cam.right) / z1, dot(p1, cam.up) / z1);
    vec2 sc2 = vec2(dot(p2, cam.right) / z2, dot(p2, cam.up) / z2);

    sc0.x = (sc0.x / cam.tanfovx + 1.0) * 0.5 * float(cam.width);
    sc0.y = (1.0 - sc0.y / cam.tanfovy) * 0.5 * float(cam.height);
    
    sc1.x = (sc1.x / cam.tanfovx + 1.0) * 0.5 * float(cam.width);
    sc1.y = (1.0 - sc1.y / cam.tanfovy) * 0.5 * float(cam.height);
    
    sc2.x = (sc2.x / cam.tanfovx + 1.0) * 0.5 * float(cam.width);
    sc2.y = (1.0 - sc2.y / cam.tanfovy) * 0.5 * float(cam.height);

    // 5. Bounding Box to constrain pixel iteration
    int minX = max(0, int(floor(min(sc0.x, min(sc1.x, sc2.x)))));
    int maxX = min(cam.width - 1, int(ceil(max(sc0.x, max(sc1.x, sc2.x)))));
    int minY = max(0, int(floor(min(sc0.y, min(sc1.y, sc2.y)))));
    int maxY = min(cam.height - 1, int(ceil(max(sc0.y, max(sc1.y, sc2.y)))));

    // Discard off-screen geometry early
    if (minX > maxX || minY > maxY) return;

    // 6. Setup edge functions
    vec2 e0 = sc1 - sc0;
    vec2 e1 = sc2 - sc1;
    vec2 e2 = sc0 - sc2;
    
    float det = e0.x * e1.y - e0.y * e1.x;
    if (abs(det) < 0.0001) return; // Degenerate geometry cull
    float signDet = sign(det);

    // 7. Base Lighting Calculations
    vec3 lightDir = normalize(-cam.dir * 0.2);
    float diffuse = max(0.0, dot(tri.n, lightDir));
    float intensity = min(1.0, 0.35 + diffuse * 0.65);
    vec3 baseColor = vec3(float(tri.color & 255)/255.0, float((tri.color>>8) & 255)/255.0, float((tri.color>>16) & 255)/255.0);
    vec3 finalColor = baseColor * intensity;

    // 8. Rasterization Sub-loop
    for (int y = minY; y <= maxY; ++y) {
        for (int x = minX; x <= maxX; ++x) {
            vec2 p = vec2(float(x) + 0.5, float(y) + 0.5);

            // Compute Barycentric offsets
            float w0 = ((p.x - sc1.x) * e1.y - (p.y - sc1.y) * e1.x) * signDet;
            float w1 = ((p.x - sc2.x) * e2.y - (p.y - sc2.y) * e2.x) * signDet;
            float w2 = ((p.x - sc0.x) * e0.y - (p.y - sc0.y) * e0.x) * signDet;

            // Inside Triangle Check
            if (w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0) {
                float sum = w0 + w1 + w2;
                float invSum = 1.0 / sum;
                w0 *= invSum;
                w1 *= invSum;
                w2 *= invSum;

                // Evaluate perspective-correct Z
                float z = 1.0 / (w0 / z0 + w1 / z1 + w2 / z2);
                
                // Pack float to uint to allow exact atomic swap comparisons
                uint zInt = floatBitsToUint(z);
                int pidx = y * cam.width + x;

                // Robust Depth Test using Atomic Comp Swap (Spinlock replacement)
                bool writeSuccess = false;
                uint currentDepthInt = depths[pidx];
                
                while (zInt < currentDepthInt) {
                    uint oldDepthInt = atomicCompSwap(depths[pidx], currentDepthInt, zInt);
                    if (oldDepthInt == currentDepthInt) {
                        writeSuccess = true;
                        break;
                    }
                    currentDepthInt = oldDepthInt;
                }

                // If this is the nearest front-facing triangle:
                if (writeSuccess) {
                    float fogFactor = clamp((cam.maxDist - z) * cam.invFogRange, cam.minVisibility, 1.0);
                    
                    vec3 skyColor = cam.bgColor;
                    if (cam.skyWidth > 0) {
                        float px_ndc = (2.0 * p.x / float(cam.width) - 1.0) * cam.tanfovx;
                        float py_ndc = (1.0 - 2.0 * p.y / float(cam.height)) * cam.tanfovy;
                        vec3 rd = normalize(cam.dir + cam.right * px_ndc + cam.up * py_ndc);
                        
                        float u = 0.5 + atan(rd.z, rd.x) / (2.0 * 3.14159265);
                        float v = 0.5 - asin(rd.y) / 3.14159265;
                        int sx = clamp(int(u * cam.skyWidth), 0, cam.skyWidth - 1);
                        int sy = clamp(int(v * cam.skyHeight), 0, cam.skyHeight - 1);
                        
                        skyColor = skybox[sy * cam.skyWidth + sx].rgb;
                    }

                    vec3 blended = mix(skyColor, finalColor, fogFactor);

                    // Write to generic float buffer
                    colors[pidx * 3 + 0] = blended.r;
                    colors[pidx * 3 + 1] = blended.g;
                    colors[pidx * 3 + 2] = blended.b;
                }
            }
        }
    }
}