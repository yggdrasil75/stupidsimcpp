#version 460
#extension GL_GOOGLE_include_directive : require
#include "phys_common.glsl"

// One thread per static voxel: set every occupancy cell its cube overlaps.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    vec4 s = statics[i];
    float hs = s.w * 0.5;
    ivec3 lo = occCoord(s.xyz - hs + 1e-5);
    ivec3 hi = occCoord(s.xyz + hs - 1e-5);
    lo = max(lo, ivec3(0));
    hi = min(hi, ivec3(pc.gridDim) - 1);
    for (int z = lo.z; z <= hi.z; ++z)
    for (int y = lo.y; y <= hi.y; ++y)
    for (int x = lo.x; x <= hi.x; ++x) {
        uint idx = uint(x) + uint(y) * pc.gridDim.x + uint(z) * pc.gridDim.x * pc.gridDim.y;
        atomicOr(occ[idx >> 5u], 1u << (idx & 31u));
    }
}
