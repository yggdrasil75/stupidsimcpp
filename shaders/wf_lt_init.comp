#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#define WF_LIGHT_TRACE
#include "wf_common.glsl"

// Forward / light tracing init.
//
// One light path per launched thread. Paths originate ON the scene's own
// emissive voxels (the LightBuffer / emissiveIndices that the backward tracer
// samples for NEE) and emit a cosine-weighted ray off the emitting surface.
// No artificial sun: this traces the actual light source in the scene.

void main() {
    uint gid = gl_GlobalInvocationID.x;

    int tileW = min(512, cam.width  - cam.tileOffsetX);
    int tileH = min(512, cam.height - cam.tileOffsetY);
    if (tileW <= 0 || tileH <= 0) return;
    uint pathCount = uint(tileW) * uint(tileH);
    if (gid >= pathCount) return;

    int globalS = pc.sampleIndex;

    uint rng  = pcg_hash(gid * 2654435761u + pcg_hash(uint(globalS)) + 12345u);
    uint grng = pcg_hash(gid * 40503u + pcg_hash(uint(globalS)) * 19349663u + 7u);

    // No emissive geometry -> nothing to trace.
    if (cam.emissiveCount <= 0) {
        pathsHot[gid].i1 = ivec4(-1, -1, -1, 0); // not ALIVE
        return;
    }

    // Pick a random emissive voxel.
    int lightIdx = clamp(int(nextFloat(rng) * float(cam.emissiveCount)), 0, cam.emissiveCount - 1);
    uint ptIdx = emissiveIndices[lightIdx];
    GPUPBRRenderData lp = points[ptIdx];
    GPUMaterial lm = materials[lp.materialIdx];

    // Directional emission for the test scene: the ceiling panel only usefully
    // emits DOWNWARD into the room. Force the emission face to -Z so we don't
    // waste 5/6 of paths firing sideways/up into adjacent ceiling voxels.
    // (This is the "make them point down" simplification requested for the test.)
    vec3 N = vec3(0.0, 0.0, -1.0);

    // Sample a point on the -Z face of the voxel (slightly inset on x/y).
    vec2 faceUV = vec2(nextFloat(rng), nextFloat(rng)) - 0.5; // [-0.5,0.5]
    vec3 origin = lp.position
                + vec3(faceUV * (lp.size * 0.9), -(lp.size * 0.5 + DIST_EPSILON * 4.0));

    // Cosine-weighted emission into the downward hemisphere about N.
    float pdfW;
    vec3 dir = sampleCosHemisphere(N, nextFloat(rng), nextFloat(rng), pdfW);

    // Emitted radiance of this voxel (albedo-tinted, like the backward tracer).
    vec4 lAlbedo = unpackRGBA8(lp.color);
    vec3 Le = lAlbedo.rgb * unpackRGB9E5(lm.emittance);

    // Throughput for a light path emitted with cosine pdf: Le * cos / pdfW,
    // with cos/pdfW = PI for cosine sampling. Light-count and area
    // normalization is folded into ltSplatScale on resolve.
    vec3 emitted = Le * PI;

    PathHot p;
    p.o_tmax    = vec4(origin, cam.maxDist);
    p.dir_rough = vec4(dir, 0.0);
    p.thp       = vec4(emitted, 0.0);
    p.rad       = vec4(0.0, 0.0, 0.0, LARGE);
    p.u0        = uvec4(gid, rng, grng, PC_PACK(0, 0, 0));
    p.i1        = ivec4(-1, -1, -1, FLAG_SPECULAR | FLAG_ALIVE);
    pathsHot[gid] = p;

    pathsHit[gid].hit = vec4(0.0, intBitsToFloat(-1), -1.0, 0.0);

    uint slot = atomicAdd(ctr.extendCount, 1u);
    if (pc.parity == 0) extendA[slot] = gid;
    else                extendB[slot] = gid;
    // DEBUG: count paths seeded.
    dbgInc(0u);
}
