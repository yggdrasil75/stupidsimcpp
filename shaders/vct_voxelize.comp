#version 450
layout(local_size_x = 64) in;

struct GPUFastRenderData {
    vec3 position;
    float size;
    uint color;
    uint materialIdx;
    int  objectId;
    uint isGas;
};

layout(std430, binding = 0) readonly buffer PointBuffer { GPUFastRenderData points[]; };

struct GPUMaterial {
    uint emittance;
    uint materialProps;
    uint absorption;
    uint albedoPacked;
};
layout(std430, binding = 1) readonly buffer MaterialBuffer { GPUMaterial materials[]; };

layout(binding = 2, rgba16f) uniform image3D voxelVolume;

layout(binding = 3) uniform VoxelParams {
    vec3 volMin;
    float voxelSize;
    vec3 volExtent;
    float invVoxelSize;
    ivec3 gridRes;
    int pointCount;
    vec3 lightDir;
    float pad0;
} vp;

vec4 unpackRGBA8(uint c) {
    return vec4(float(c & 0xFFu) / 255.0,
                float((c >> 8) & 0xFFu) / 255.0,
                float((c >> 16) & 0xFFu) / 255.0,
                float((c >> 24) & 0xFFu) / 255.0);
}

vec3 unpackRGB9E5(uint c) {
    if (c == 0u) return vec3(0.0);
    int e = int(c >> 27) - 15;
    float scale = exp2(float(e - 9));
    return vec3(float(c & 0x1FFu), float((c >> 9) & 0x1FFu), float((c >> 18) & 0x1FFu)) * scale;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= vp.pointCount) return;

    GPUFastRenderData pt = points[i];
    if (pt.isGas != 0u) return;

    vec4 albedo = unpackRGBA8(pt.color);
    if (albedo.a <= 0.001) return;

    GPUMaterial mat = materials[pt.materialIdx];

    vec3 radiance;
    vec3 emit = unpackRGB9E5(mat.emittance);
    if (dot(emit, emit) > 0.0) {
        radiance = albedo.rgb * emit;
    } else {
        float halfLambert = 0.5;
        radiance = albedo.rgb * (0.35 + 0.65 * halfLambert);
    }

    float halfpoint = pt.size * 0.5;
    vec3 bmin = pt.position - vec3(halfpoint);
    vec3 bmax = pt.position + vec3(halfpoint);

    ivec3 cmin = ivec3(floor((bmin - vp.volMin) * vp.invVoxelSize));
    ivec3 cmax = ivec3(floor((bmax - vp.volMin) * vp.invVoxelSize));
    cmin = clamp(cmin, ivec3(0), vp.gridRes - 1);
    cmax = clamp(cmax, ivec3(0), vp.gridRes - 1);

    vec4 store = vec4(radiance * albedo.a, albedo.a);

    for (int z = cmin.z; z <= cmax.z; ++z) {
        for (int y = cmin.y; y <= cmax.y; ++y) {
            for (int x = cmin.x; x <= cmax.x; ++x) {
                ivec3 c = ivec3(x, y, z);
                vec4 prev = imageLoad(voxelVolume, c);
                if (store.a >= prev.a) {
                    imageStore(voxelVolume, c, store);
                }
            }
        }
    }
}
