#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push {
    int width;
    int height;
    int lowW;
    int lowH;
    float pbrScale;
    int samples;
} pc;

layout(std430, binding = 0) readonly buffer FastBuf { float fastData[]; };  // full res, 5-stride
layout(std430, binding = 1) readonly buffer PBRBuf  { float pbrData[]; };   // low res, 5-stride
layout(std430, binding = 2) writeonly buffer OutBuf { float outData[]; };   // full res, 3-stride
layout(std430, binding = 3) readonly buffer CoeffBuf { float coeff[]; };    // low res, 6-stride

void fetchCoeff(int lx, int ly, out vec3 a, out vec3 b) {
    int i = (ly * pc.lowW + lx) * 6;
    a = vec3(coeff[i], coeff[i + 1], coeff[i + 2]);
    b = vec3(coeff[i + 3], coeff[i + 4], coeff[i + 5]);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int fastIdx = (y * pc.width + x) * 5;
    vec3  guideC    = vec3(fastData[fastIdx], fastData[fastIdx + 1], fastData[fastIdx + 2]);
    float fastDepth = fastData[fastIdx + 3];
    int   fastObj   = int(fastData[fastIdx + 4]);

    float invSamples = 1.0 / max(1.0, float(pc.samples));

    // Continuous low-res coordinate of this full-res pixel.
    float flx = (float(x) + 0.5) * pc.pbrScale - 0.5;
    float fly = (float(y) + 0.5) * pc.pbrScale - 0.5;
    int lx0 = int(floor(flx));
    int ly0 = int(floor(fly));
    float fx = flx - float(lx0);
    float fy = fly - float(ly0);

    float sumW = 0.0;
    vec3 sumA = vec3(0.0), sumB = vec3(0.0);

    // 2x2 edge-aware bilinear taps.
    for (int j = 0; j <= 1; ++j)
    for (int i = 0; i <= 1; ++i) {
        int nx = clamp(lx0 + i, 0, pc.lowW - 1);
        int ny = clamp(ly0 + j, 0, pc.lowH - 1);
        int pIdx = (ny * pc.lowW + nx) * 5;
        if (int(pbrData[pIdx + 4]) != fastObj) continue;

        float pDepth = pbrData[pIdx + 3] * invSamples;
        float dz = abs(fastDepth - pDepth) / max(fastDepth, 0.1);
        if (fastDepth > 999000.0 && pDepth > 999000.0) dz = 0.0;
        float wZ = exp(-(dz * dz) / (2.0 * 0.05 * 0.05));
        float wB = (i == 0 ? 1.0 - fx : fx) * (j == 0 ? 1.0 - fy : fy);
        float w = max(wB, 1e-4) * wZ;

        vec3 a, b;
        fetchCoeff(nx, ny, a, b);
        sumW += w; sumA += a * w; sumB += b * w;
    }

    // Fallback 1: widen the search with a Gaussian window, same-object only.
    if (sumW == 0.0 && fastObj != -1) {
        int clx = int(round(float(x) * pc.pbrScale));
        int cly = int(round(float(y) * pc.pbrScale));
        for (int dy = -3; dy <= 3; ++dy)
        for (int dx = -3; dx <= 3; ++dx) {
            int nx = clamp(clx + dx, 0, pc.lowW - 1);
            int ny = clamp(cly + dy, 0, pc.lowH - 1);
            int pIdx = (ny * pc.lowW + nx) * 5;
            if (int(pbrData[pIdx + 4]) != fastObj) continue;
            float w = exp(-float(dx * dx + dy * dy) / (2.0 * 1.5 * 1.5));
            vec3 a, b;
            fetchCoeff(nx, ny, a, b);
            sumW += w; sumA += a * w; sumB += b * w;
        }
    }
    
    int outIdx = (y * pc.width + x) * 3;
    vec3 result;
    if (sumW > 0.0) {
        vec3 a = sumA / sumW;
        vec3 b = sumB / sumW;
        result = a * guideC + b;
    } else {
        // Nothing of this object in the path trace at all: keep the guide.
        result = guideC;
    }
    outData[outIdx]     = clamp(result.r, 0.0, 1.0);
    outData[outIdx + 1] = clamp(result.g, 0.0, 1.0);
    outData[outIdx + 2] = clamp(result.b, 0.0, 1.0);
}