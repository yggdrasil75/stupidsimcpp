#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#define BMFR_ORDER 1

#if BMFR_ORDER == 2
  #define BMFR_K 7
#else
  #define BMFR_K 4
#endif

const int COEFF_STRIDE = 24;

layout(push_constant) uniform Push {
    int width;
    int height;
    int lowW;
    int lowH;
    float pbrScale;
    int samples;
} pc;

layout(std430, binding = 0) readonly buffer FastBuf { float fastData[]; };
layout(std430, binding = 1) readonly buffer PBRBuf  { float pbrData[]; };
layout(std430, binding = 2) writeonly buffer OutBuf { float outData[]; };
layout(std430, binding = 3) readonly buffer CoeffBuf { float coeff[]; };

void buildFeatures(vec3 g, out float phi[BMFR_K]) {
    phi[0] = 1.0;
    phi[1] = g.r;
    phi[2] = g.g;
    phi[3] = g.b;
#if BMFR_ORDER == 2
    phi[4] = g.r * g.r;
    phi[5] = g.g * g.g;
    phi[6] = g.b * g.b;
#endif
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int fastIdx = (y * pc.width + x) * 5;
    vec3  guideC    = vec3(fastData[fastIdx], fastData[fastIdx + 1], fastData[fastIdx + 2]);
    float fastDepth = fastData[fastIdx + 3];
    int   fastObj   = int(fastData[fastIdx + 4]);

    float invSamples = 1.0 / max(1.0, float(pc.samples));

    float flx = (float(x) + 0.5) * pc.pbrScale - 0.5;
    float fly = (float(y) + 0.5) * pc.pbrScale - 0.5;
    int lx0 = int(floor(flx));
    int ly0 = int(floor(fly));
    float fx = flx - float(lx0);
    float fy = fly - float(ly0);

    float sumW = 0.0;
    float sumT[BMFR_K][3];
    for (int k = 0; k < BMFR_K; ++k) {
        sumT[k][0] = 0.0;
        sumT[k][1] = 0.0;
        sumT[k][2] = 0.0;
    }

    for (int j = 0; j <= 1; ++j)
    for (int i = 0; i <= 1; ++i) {
        int nx = clamp(lx0 + i, 0, pc.lowW - 1);
        int ny = clamp(ly0 + j, 0, pc.lowH - 1);
        int pIdx = (ny * pc.lowW + nx) * 5;
        if (int(pbrData[pIdx + 4]) != fastObj) continue;

        float pDepth = pbrData[pIdx + 3] * invSamples;
        float dz = abs(fastDepth - pDepth) / max(fastDepth, 0.1);
        if (fastDepth > 999000.0 && pDepth > 999000.0) dz = 0.0;
        float wZ = exp(-(dz * dz) / (2.0 * 0.05 * 0.05));
        float wB = (i == 0 ? 1.0 - fx : fx) * (j == 0 ? 1.0 - fy : fy);
        float w = max(wB, 1e-4) * wZ;

        int ci = (ny * pc.lowW + nx) * COEFF_STRIDE;
        for (int k = 0; k < BMFR_K; ++k) {
            sumT[k][0] += coeff[ci + k * 3 + 0] * w;
            sumT[k][1] += coeff[ci + k * 3 + 1] * w;
            sumT[k][2] += coeff[ci + k * 3 + 2] * w;
        }
        sumW += w;
    }

    if (sumW == 0.0 && fastObj != -1) {
        int clx = int(round(float(x) * pc.pbrScale));
        int cly = int(round(float(y) * pc.pbrScale));
        for (int dy = -3; dy <= 3; ++dy)
        for (int dx = -3; dx <= 3; ++dx) {
            int nx = clamp(clx + dx, 0, pc.lowW - 1);
            int ny = clamp(cly + dy, 0, pc.lowH - 1);
            int pIdx = (ny * pc.lowW + nx) * 5;
            if (int(pbrData[pIdx + 4]) != fastObj) continue;
            float w = exp(-float(dx * dx + dy * dy) / (2.0 * 1.5 * 1.5));
            int ci = (ny * pc.lowW + nx) * COEFF_STRIDE;
            for (int k = 0; k < BMFR_K; ++k) {
                sumT[k][0] += coeff[ci + k * 3 + 0] * w;
                sumT[k][1] += coeff[ci + k * 3 + 1] * w;
                sumT[k][2] += coeff[ci + k * 3 + 2] * w;
            }
            sumW += w;
        }
    }
    
    int outIdx = (y * pc.width + x) * 3;
    vec3 result;
    if (sumW > 0.0) {
        float invW = 1.0 / sumW;
        float phi[BMFR_K];
        buildFeatures(guideC, phi);
        result = vec3(0.0);
        for (int k = 0; k < BMFR_K; ++k) {
            result.r += sumT[k][0] * invW * phi[k];
            result.g += sumT[k][1] * invW * phi[k];
            result.b += sumT[k][2] * invW * phi[k];
        }
        result = max(result, vec3(0.0));
    } else {
        result = guideC;
    }
    outData[outIdx]     = clamp(result.r, 0.0, 1.0);
    outData[outIdx + 1] = clamp(result.g, 0.0, 1.0);
    outData[outIdx + 2] = clamp(result.b, 0.0, 1.0);
}