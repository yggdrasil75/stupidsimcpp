#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push {
    int width;
    int height;
    int lowW;
    int lowH;
    float pbrScale;
    int samples;
} pc;

layout(std430, binding = 0) readonly buffer FastBuf { float fastData[]; };
layout(std430, binding = 1) readonly buffer PBRBuf { float pbrData[]; };
layout(std430, binding = 2) writeonly buffer OutBuf { float outData[]; };

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height) return;

    int fastIdx = (y * pc.width + x) * 5;
    // Fast render is exactly 1 sample, no accumulation division needed
    float fastR = fastData[fastIdx];
    float fastG = fastData[fastIdx + 1];
    float fastB = fastData[fastIdx + 2];
    float fastDepth = fastData[fastIdx + 3];
    int fastObj = int(fastData[fastIdx + 4]);

    int center_lx = int(round(float(x) * pc.pbrScale));
    int center_ly = int(round(float(y) * pc.pbrScale));

    float sumWeights = 0.0;
    float sumR = 0.0, sumG = 0.0, sumB = 0.0;

    int radius = 3;
    float spatialSigma = 1.5;
    float relativeDepthSigma = 0.05;
    float invSamples = 1.0 / max(1.0, float(pc.samples));

    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            int nx = clamp(center_lx + dx, 0, pc.lowW - 1);
            int ny = clamp(center_ly + dy, 0, pc.lowH - 1);
            int pbrIdx = (ny * pc.lowW + nx) * 5;

            int pbrObj = int(pbrData[pbrIdx + 4]);
            if (fastObj != pbrObj) continue;

            float pbrDepth = pbrData[pbrIdx + 3] * invSamples;

            float sDistSq = float(dx*dx + dy*dy);
            float spatialWeight = exp(-sDistSq / (2.0 * spatialSigma * spatialSigma));

            float depthDiff = abs(fastDepth - pbrDepth) / max(fastDepth, 0.1);
            if (fastDepth > 999000.0 && pbrDepth > 999000.0) depthDiff = 0.0;
            
            float depthWeight = exp(-(depthDiff * depthDiff) / (2.0 * relativeDepthSigma * relativeDepthSigma));

            float weight = spatialWeight * depthWeight;
            sumWeights += weight;
            sumR += pbrData[pbrIdx] * invSamples * weight;
            sumG += pbrData[pbrIdx + 1] * invSamples * weight;
            sumB += pbrData[pbrIdx + 2] * invSamples * weight;
        }
    }
    
    if (sumWeights == 0.0 && fastObj != -1) {
        int searchRadius = radius * 3;
        float nearestDist = 99999.0;
        
        for (int dy = -searchRadius; dy <= searchRadius; ++dy) {
            for (int dx = -searchRadius; dx <= searchRadius; ++dx) {
                int nx = clamp(center_lx + dx, 0, pc.lowW - 1);
                int ny = clamp(center_ly + dy, 0, pc.lowH - 1);
                int pbrIdx = (ny * pc.lowW + nx) * 5;

                if (int(pbrData[pbrIdx + 4]) == fastObj) {
                    float dist = float(dx*dx + dy*dy);
                    if (dist < nearestDist) {
                        nearestDist = dist;
                        sumR = pbrData[pbrIdx] * invSamples;
                        sumG = pbrData[pbrIdx + 1] * invSamples;
                        sumB = pbrData[pbrIdx + 2] * invSamples;
                        sumWeights = 1.0;
                    }
                }
            }
        }
    }
    
    int outIdx = (y * pc.width + x) * 3;
    if (sumWeights > 0.0) { 
        outData[outIdx]     = clamp(sumR / sumWeights, 0.0, 1.0);
        outData[outIdx + 1] = clamp(sumG / sumWeights, 0.0, 1.0);
        outData[outIdx + 2] = clamp(sumB / sumWeights, 0.0, 1.0);
    } else { 
        outData[outIdx]     = clamp(fastR, 0.0, 1.0);
        outData[outIdx + 1] = clamp(fastG, 0.0, 1.0);
        outData[outIdx + 2] = clamp(fastB, 0.0, 1.0);
    }
}